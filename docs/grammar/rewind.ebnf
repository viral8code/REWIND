/*
 REWIND の形式文法（EBNF）。
 字句の節（段階 B）、型・パターン・式の節（段階 C）、文・ブロック・宣言・全体の節（段階 D）を持つ。
 全体の入口は Program で、Parser の program()（構文解析だけ。型検査は含まない）と受理が一致する。

 書き方
   - 名前が UPPER_CASE（小文字を含まない）の規則が字句規則で、1 文字ずつの列に対して働く。
   - [ nf: X ] は「直後の 1 文字が X でない」ことを表す（X は 1 文字の終端）。
     入力の終わりでは成り立つ。[ ns: X ] も同じ意味で使える。
   - 字句の規則は、最長一致で入力を切る。位置ごとに、TOKEN または SKIP のどちらかで
     受理できる最も長い接頭辞を取る。TOKEN は記号や名前などのトークン、SKIP は空白と
     コメントで、SKIP は捨てる。TOKEN と SKIP が同じ位置で受理できることはない。
   - 実装の lex()（src/v2.rs）が正で、この文法は lex() に合わせる。lex() が拒否する入力は、
     どの TOKEN にも当たらないか、[ nf: ... ] に当たって、この文法も拒否する。

 字句の癖（lex() の振る舞い。実装が正なので、そのまま写している）
   1. 数の直後に e か E が来ると、必ず指数部と読む。`1e`、`1else` は字句の誤りになる。
   2. `1abc` は INT `1` と IDENT `abc` に切れる（誤りではない）。一方 `0x1g`、`0b12`、`0bar` は、
      接頭辞つきの数の直後に英数字と _ が続くので誤りになる。
   3. `a.0.1` は `a`、`.`、FLOAT `0.1` に切れる（`.0` は整数ではなく、小数の一部になる）。
   4. `1..2` は `1`、`..`、`2`。`1.` は INT `1` と `.`。`1.0.2` は FLOAT `1.0`、`.`、INT `2`。
   5. 名前の 2 文字目以降は is_alphanumeric で、Unicode の数字（例: ²）も入る。
      先頭は is_alphabetic か _ だけで、ASCII 以外の数字は先頭にならない。
   6. 空白は Unicode の White_Space。ASCII の記号以外の文字（`$`、`@`、`'`、`#` など）は
      「想定外の文字」で拒否される。ただし lex() の検査は文字の長さを UTF-8 のバイト数で測るので、
      ASCII 以外の文字は、空白でも英字でもなければ（絵文字、²、①、BOM、ゼロ幅の空白など）
      拒否されず、その 1 文字が 1 つのトークンになる（実装の不具合に見える。OTHER_CHAR で写している）。
   7. `//` と `/*` で始まる位置は、必ずコメントになる（`/` 単独の記号にはならない）。
      行コメントは改行まで（\r も含めて）を捨てる。
   8. 文字列のエスケープは字句では検査しない。`\` の次の 1 文字は何でも読み飛ばす。
      実際に使えるのは \n \r \t \" \ \0 と \u{1〜6 桁の 16 進数} で、これ以外は構文解析時に
      InvalidEscape などの誤りになる（この文法の範囲外）。
   9. 引用符 6 個の `""""""` は空の raw 文字列ではなく、6 個で開く閉じていない raw 文字列で、誤りになる。
  10. raw 文字列の開きと閉じの引用符の個数が同じであることは、文脈自由では書けない。
      この文法は 3〜6 個の場合を規則に展開して書く。7 個以上は lex() が受理しても、この文法は
      受理しない（既知の差）。
  11. 次の 2 つは文脈依存の検査で、この文法では表せない（lex() だけが拒否する。既知の差）。
      - raw 文字列の複数行の形で、本文の各行が、閉じの引用符の行と同じ字下げで始まること。
      - 0x / 0b / 0o の整数が、値として u64 に収まること（integer literal overflow）。
*/

/* ================================================================ 入口 */

TOKEN ::= IDENT | INT | FLOAT | STRING | RAW_STRING | SYMBOL | OTHER_CHAR

SKIP ::= WHITESPACE | LINE_COMMENT | BLOCK_COMMENT

/* ================================================================ 空白とコメント */

/* is_whitespace() が真の文字（付録 A の表）。 */
WHITESPACE ::= WS_CHAR+

LINE_COMMENT ::= '//' [^\n]*

/* 入れ子にできる。`/` の直後が `*` なら入れ子の開始、`*` の直後が `/` なら閉じ。 */
BLOCK_COMMENT ::= '/*' BLOCK_ITEM* '*/'

BLOCK_ITEM ::= BLOCK_COMMENT
             | [^/*]
             | '/' [ nf: '*' ]
             | '*' [ nf: '/' ]

/* ================================================================ 名前 */

/* 先頭は is_alphabetic か _、2 文字目以降は is_alphanumeric か _。 */
IDENT ::= IDENT_START IDENT_CHAR*

IDENT_START ::= UNICODE_ALPHABETIC | '_'

IDENT_CHAR ::= UNICODE_ALPHANUMERIC | '_'

/* ================================================================ 数 */

INT ::= DEC_INT | HEX_INT | BIN_INT | OCT_INT

FLOAT ::= DEC_RUN '.' FRAC_RUN ( EXPONENT | [ nf: [_eE] ] )
        | DEC_RUN EXPONENT

/* 10 進の整数。直後に _ か e か E が来ない（来ると字句の誤り）。 */
DEC_INT ::= DEC_RUN [ nf: [_eE] ]

/* 最初の桁が 0 のとき、直後が x X b B o O なら接頭辞つきの数になるので 10 進ではない。
   _ は桁と桁のあいだにだけ置ける（連続した _ は置けない）。 */
DEC_RUN ::= ( '0' [ nf: [xXbBoO] ] | [1-9] ) ( '_'? DIGIT )*

FRAC_RUN ::= DIGIT ( '_'? DIGIT )*

EXPONENT ::= [eE] [+\-]? FRAC_RUN [ nf: '_' ]

DIGIT ::= [0-9]

/* 接頭辞つきの整数。直後に ASCII の英数字か _ が続くと字句の誤り（0x1g、0b12、0x1_ など）。 */
HEX_INT ::= '0' [xX] HEX_DIGIT ( '_'? HEX_DIGIT )* [ nf: [A-Za-z0-9_] ]

BIN_INT ::= '0' [bB] [01] ( '_'? [01] )* [ nf: [A-Za-z0-9_] ]

OCT_INT ::= '0' [oO] [0-7] ( '_'? [0-7] )* [ nf: [A-Za-z0-9_] ]

HEX_DIGIT ::= [0-9a-fA-F]

/* ================================================================ 文字列 */

/* 空の文字列 `""` の直後に引用符が来ると、3 個の引用符で始まる raw 文字列になる。
   本文は改行を含められる。`\` の次の 1 文字は何でも読み飛ばす（癖 8）。 */
STRING ::= '"' '"' [ nf: '"' ]
         | '"' STRING_ITEM+ '"'

STRING_ITEM ::= [^"\\] | '\' ANY_CHAR

ANY_CHAR ::= [#x0-#x10FFFF]

/* ---------------------------------------------------------------- raw 文字列
   N 個（3 以上）の引用符で開き、ちょうど N 個の引用符で閉じる。本文には N 個より短い引用符の
   連なりを置ける。この一致は文脈自由では書けないので、N = 3〜6 を規則に展開して書く（癖 10）。
   形は 2 つある。
   - 1 行の形: 開きの引用符の直後に空白と改行だけが続くのでなければ、閉じまで改行を含めない。
   - 複数行の形: 開きの引用符のあと、空白かタブだけで行が終わる。閉じの引用符は、行の先頭
     （空白かタブだけが前にある位置）に、ちょうど N 個で置く。
   引用符の連なりが N 個以上になる位置は、閉じとして使う場合を除き字句の誤りで、
   [ nf: '"' ] と「連なりの直後は引用符でない文字」の形で表している。 */
RAW_STRING ::= RAW3 | RAW4 | RAW5 | RAW6

RAW_BLANK ::= [ \t]

RAW_NEWLINE ::= [\r\n]

RAW_PLAIN ::= [^"\r\n]

RAW3 ::= RAW3_FENCE RAW3_ITEM* RAW3_FENCE
       | RAW3_FENCE RAW_BLANK* RAW_NEWLINE RAW3_LINE* RAW_BLANK* RAW3_FENCE
RAW3_FENCE ::= '"""' [ nf: '"' ]
RAW3_RUN ::= '"' | '""'
RAW3_ITEM ::= RAW_PLAIN | RAW3_RUN RAW_PLAIN
RAW3_LINE ::= RAW3_ITEM* RAW3_RUN? RAW_NEWLINE

RAW4 ::= RAW4_FENCE RAW4_ITEM* RAW4_FENCE
       | RAW4_FENCE RAW_BLANK* RAW_NEWLINE RAW4_LINE* RAW_BLANK* RAW4_FENCE
RAW4_FENCE ::= '""""' [ nf: '"' ]
RAW4_RUN ::= RAW3_RUN | '"""'
RAW4_ITEM ::= RAW_PLAIN | RAW4_RUN RAW_PLAIN
RAW4_LINE ::= RAW4_ITEM* RAW4_RUN? RAW_NEWLINE

RAW5 ::= RAW5_FENCE RAW5_ITEM* RAW5_FENCE
       | RAW5_FENCE RAW_BLANK* RAW_NEWLINE RAW5_LINE* RAW_BLANK* RAW5_FENCE
RAW5_FENCE ::= '"""""' [ nf: '"' ]
RAW5_RUN ::= RAW4_RUN | '""""'
RAW5_ITEM ::= RAW_PLAIN | RAW5_RUN RAW_PLAIN
RAW5_LINE ::= RAW5_ITEM* RAW5_RUN? RAW_NEWLINE

RAW6 ::= RAW6_FENCE RAW6_ITEM* RAW6_FENCE
       | RAW6_FENCE RAW_BLANK* RAW_NEWLINE RAW6_LINE* RAW_BLANK* RAW6_FENCE
RAW6_FENCE ::= '""""""' [ nf: '"' ]
RAW6_RUN ::= RAW5_RUN | '"""""'
RAW6_ITEM ::= RAW_PLAIN | RAW6_RUN RAW_PLAIN
RAW6_LINE ::= RAW6_ITEM* RAW6_RUN? RAW_NEWLINE

/* ================================================================ 記号 */

/* 2 文字の記号は次の 15 個だけ。`>>` や `<<` はなく、`>` を 2 つ並べると `>` が 2 つのトークンになる。 */
SYMBOL ::= SYMBOL2 | SYMBOL1

SYMBOL2 ::= '==' | '!=' | '<=' | '>=' | '&&' | '||'
          | '+=' | '-=' | '*=' | '/=' | '%='
          | '->' | '=>' | '::' | '..'

/* 1 文字の記号。`/` は直後が `/` か `*` のときコメントになるので、記号にはならない。 */
SYMBOL1 ::= [=+\-*%(),;{}.!<>?:\[\]|&]
          | '/' [ nf: [/*] ]

/* ================================================================ ASCII 以外の 1 文字（癖 6） */

/* 空白でも is_alphabetic でもない ASCII 以外の 1 文字。1 文字で 1 つのトークンになる。 */
OTHER_CHAR ::= NON_ASCII_NON_SPACE - UNICODE_ALPHABETIC

NON_ASCII_NON_SPACE ::= NON_ASCII - WS_CHAR

NON_ASCII ::= [#x80-#x10FFFF]

/* ================================================================ 構文（段階 C: 型・パターン・式。段階 D: 文・宣言・全体）
   構文規則は CamelCase で書き、終端には字句規則の名前（種別）と、記号・語のリテラルを使う。
   種別は IDENT、INT、FLOAT、STRING、RAW_STRING、SYMBOL。lex() のトークン列に対して働く。
   予約語は字句では区別されず、名前として扱われる（Parser の name() は `begin` だけを拒否する）。
   そのため、語を名前から除く箇所は [ ns: 'if' ] のように先読みで書く。

   先読みの注釈（CFG では書けない選択）
     [ ns: X ]   次のトークンが X でない。長さ 0。
   Parser の判断は、次の 1 つを除いて 1 トークンの先読みで書ける。
     - `{` がマップかブロックか: `{` の次のトークンが `}` でなく、その次が `:` ならマップ。
       これは MapLit の最初の鍵を 1 トークンの形（MapKey1）に限ることで書く。ブロックは `X :` で
       始まれないので、2 つは重ならない。

   トークンの前処理（テスト側）
     `>=` は、型引数を閉じる `>` と、その後ろの `=` に分かれることがある（Parser の eat(">") が `>=` の
     テキストを `=` に書き換える）。このため、文法の検査では `>=` のトークンを常に 2 つに分け、
     種別を GE_FIRST（text は `>`）と GE_SECOND（text は `=`）にして渡す。比較演算子の `>=` は
     GE_FIRST GE_SECOND と書き、型引数を閉じる `>` は text が `>` のトークン（GE_FIRST を含む）に当たる。
     `> =`（間に空白がある）は種別が SYMBOL なので、比較演算子にならない。

   曖昧さの解消（Parser が選ぶ規則。CFG では曖昧になるものを、文章で書く）
     - 名前の直後の `<` は、まず型引数として読む。`>` で閉じ、直後が `(` か `::` のときだけ型引数になる。
       そうでなければ位置を戻し、`<` は比較演算子になる。`a.f<T>(x)` も同じ（`.名前 <` を試し、`(` が続くときだけ）。
     - `X::Y` のように `::` を含む名前の直後の `{` が名前つき構築になるのは、`{` の次が `名前 :`（欄）のとき、
       または `}`（空の構築）のときだけ。それ以外は構築でない（`{` は本体のブロック）。ただし if・while・match の
       条件部と for の繰り返しの対象（以下、条件部）では、括弧・角括弧・波括弧に囲まれていない位置の空の `{ }` は
       構築でなく本体のブロックと読む。`if x == E::A { ... }`、`match E::A { ... }`、`if x == E::A {}` は
       本体を持つ。条件部の外と、条件部の中の括弧などの内側では、`E::A {}` は空の構築。
       この文法では、条件部を CExpr（Expr と同じ形で、括弧などに囲まれない位置の空の構築だけを除いたもの）で書く。
       `名前 :` の先読みは、曖昧な文法で書く（`E::A { x: 1 }` は構築、`{ x: 1 }` はブロックにならない）。
     - 前置の `|` と `||` は、式の先頭ではクロージャの始まりで、`||` は中置では論理和になる。
     - クロージャの短い形 `|a| 式` の本体は、できるだけ長い式をとる（右に伸びる）。
     - `&` の直後の `mut` は、必ず `&mut` の一部になる。
     - 二項演算子は左結合。優先順位は低い順に `||`、`&&`、`== !=`、`< <= > >=`、`+ -`、`* / %`。
       前置演算子（`- ! & &mut await spawn move capture`）の被演算子は、後置を含む項だけ。
     - 後置（`::`、`[ ]`、`.数`、`.名前`、`.名前<T>(`、`( )`、`?`）は、優先順位に関係なく必ず結合する。

   Parser の癖（実装が正なので、そのまま写している。不具合に見えるものを含む）
     1. （修正済み。番号は変えない）
     2. 文字列のパターンは expr(0) で読み、値になったときだけ受理する。後置や二項演算が続くと拒否する。
     3. パターンの `-` と範囲の端は、トークンが整数かどうかを integer_literal で見る。整数でないと
        「integer literal overflow」と報告する（文言が実際の原因と合わない）。
     4. match の腕は、結果の式がブロック `{ }` のとき、`,` を省ける。リスト `[ ]` とマップ `{ k: v }` も
        ブロックとして数えられるので、`,` を省ける。`if` と `match` の式は省けない。
     5. `x.0.1` は `x`、`.`、FLOAT `0.1` で、タプルの添字 2 つとして読む。添字のトークンは、数字だけ（と `.`）
        でなければ誤りになる（`x.1e5`、`x.0x1`、`x.1_0`）。この検査は値の検査なので、文法では INT か FLOAT として受理する。
     6. `[]`（空のリスト）は拒否する（診断で型の書き方を案内する）。
     7. クロージャのゼロ個の引数は、`||` のほかに `| |`（2 トークン）でも書ける。
     8. 入れ子の深さは、型・パターン・式・ブロック・文で共通の 64 まで。超えると拒否する（深さの検査は文法の外）。
     9. `capture value|move|borrow` の被演算子は、クロージャそのものでなければならない。
        ブロックの形のクロージャのあとに後置が続くと、クロージャでなくなるので拒否する。
    10. 型では、`A<B>.C` のように型引数のあとに続けられない。`&&T` は `&&` が 1 トークンなので拒否する。
    11. `fn` は型の先頭では必ず関数型の始まりで、名前にはならない。
    12. パターンの `-` のあとと範囲の終わりは、integer_literal が読む。integer_magnitude は `_` を取り除いて数字を
        数えるので、`_`、`__`、`_1` のような名前も整数として受理する（`-_` は 0、`0.._1` は範囲）。
        式の `-` に続く `_9223372036854775808` も同じ理由で、i64 の最小値の値として読まれる（文法では区別しない）。
    13. ブロックの中で、文の先頭の語（let var using while for break continue return defer commit revert resume drop
        publish branch runtime external）は、式の名前としては読まれない。`if` の直後の `let` も、`if let` の始まり。
    14. `( 式 )` は中の式をそのまま返すので、中が名前だけなら、括弧のあとにも `::` を続けられる（`(a)::B`、`(a.b)::C`）。
    15. else のない `if` の直後の `else` は、必ず else 節として読まれる。`else` が名前として次の文の先頭になることはない。
    16. （段階 D）`test` は直後が `fn` のときだけ接頭辞になる。`test async fn` は誤りで、`async test fn` も誤り。
        `async` は、トップレベルでは必ず関数宣言の始まりとして読まれる。
    17. `pub` のあとは宣言だけ。`pub import`、`pub impl`、`pub let` などは誤り。`pub fn` は `->` が必要。
        宣言の先頭の語（effects import type enum trait impl struct record fn async const pub）は、トップレベルでは
        式の名前にならない。
    18. 構造体の欄は、修飾（`private`、`pub`）がないと、名前を `private` と `pub` にできない（修飾として読まれる）。
        実装の不具合に見える。
    19. `runtime` の値は、トークンの文字列を usize として読む。`1_000` や `0x10` は、整数のリテラルとしては
        書けるが、ここでは誤りになる（実装の不具合に見える）。桁あふれと単位の掛け算の桁あふれは値の検査。
    20. let-else は、名前が大文字（char::is_uppercase）で始まり、直後が `(` か `::` のときだけ。
        `Option<Int>::Some(x)` のような形は、通常の `let` として読まれて拒否される。UPPER_IDENT の本体は
        ASCII の [A-Z] で書いたが、実際の種別はテストが char::is_uppercase でつけるので、ASCII 以外の大文字でも成り立つ。
        else のブロックが抜け出す文で終わること（return、break、continue、panic）は値の検査。
    21. 式のブロックの中で、`if`・`match`・`{` で始まる文は、まず式として読む。式として読めたあとの失敗では、
        文として読み直さない。文法は「式が続く記号の先読み」（NoContinue）で近似する。式として読めない場合に
        限って文の読み直しが効く部分（読み直した文のあとに `(` や `-` が続く形）は、実装より狭く拒否する。
        既定のテストと変異（約 360 万件）では、この近似による食い違いは見つかっていない。
    22. match の文は、腕のあいだの `,` を必ず要る（`{ }` の腕のあとにも）。式の match は、結果が `{ }`・リスト・マップなら省ける。
    23. `external` が文の先頭で、直後が `{`・`fresh`・`live` でないときは、名前の式の文として読まれる（`external;`）。
*/

/* ---------------------------------------------------------------- 名前 */

/* name() が受理する名前。`begin` だけを拒否する。 */
Name ::= [ ns: 'begin' ] IDENT

/* 式の先頭の名前。特別に扱われる語は、別の規則で読む。 */
ExprHead ::= [ ns: 'if' ] [ ns: 'match' ] [ ns: 'await' ] [ ns: 'spawn' ] [ ns: 'move' ]
             [ ns: 'true' ] [ ns: 'false' ] [ ns: 'None' ] [ ns: 'null' ] IDENT

/* ---------------------------------------------------------------- 型 */

Type ::= '(' ')'
       | '(' Type ')'
       | '(' Type ',' ( Type ( ',' Type )* ','? )? ')'
       | '&' 'mut' Type
       | '&' [ ns: 'mut' ] Type
       | 'fn' '(' ( Type ( ',' Type )* ','? )? ')' '->' Type EffectSet? CapturesSet?
       | TypeHead ( ( '.' | '::' ) Name )* TypeArgs?

TypeHead ::= [ ns: 'fn' ] Name

TypeArgs ::= '<' Type ( ',' Type )* ','? '>'

EffectSet ::= 'effects' ( '{' ( Name ( ',' Name )* ','? )? '}' | Name )

CapturesSet ::= 'captures' '{' ( CaptureFlag ( ',' CaptureFlag )* ','? )? '}'

CaptureFlag ::= 'Send' | 'Share'

/* 型パラメータ（宣言の `<T, U: Bound>`）。`<` がなければ空。 */
TypeParams ::= ( '<' TypeParam ( ',' TypeParam )* ','? '>' )?

TypeParam ::= Name ( ':' BoundsList )?

BoundsList ::= Name ( '+' Name )*

/* where 節。直後は `{`、`=`、`;` のどれか。 */
WhereClause ::= 'where' WhereItem ( ',' WhereItem )* ','?

WhereItem ::= Name ':' BoundsList

/* ---------------------------------------------------------------- パターン */

Pattern ::= '_'
          | TuplePattern
          | '[' ( Pattern ( ',' Pattern )* ','? )? ']'
          | 'true'
          | 'false'
          | STRING
          | RAW_STRING
          | '-' IntLike ( '..' '-'? IntLike )?
          | INT ( '..' '-'? IntLike )?
          | PatternPath ( '(' ( Pattern ( ',' Pattern )* ','? )? ')'
                        | '{' ( FieldPattern ( ',' FieldPattern )* ','? )? '}' )?

/* integer_literal が受理するトークン。INT のほか、`_` と数字だけの名前（`_`、`_1`、`__`）も受理する（癖 12）。 */
IntLike ::= INT | UNDERSCORE_NUM

TuplePattern ::= '(' ( Pattern ( ',' Pattern )* ','? )? ')'

FieldPattern ::= Name ':' Pattern

PatternPath ::= PatternHead ( '.' Name )* TypeArgs? ( '::' Name )*

PatternHead ::= [ ns: '_' ] [ ns: 'true' ] [ ns: 'false' ] Name

/* ---------------------------------------------------------------- 式 */

Expr ::= OrExpr

OrExpr ::= OrExpr '||' AndExpr | AndExpr

AndExpr ::= AndExpr '&&' EqExpr | EqExpr

EqExpr ::= EqExpr ( '==' | '!=' ) CmpExpr | CmpExpr

CmpExpr ::= CmpExpr CmpOp AddExpr | AddExpr

CmpOp ::= '<' | '<=' | '>' | GE_FIRST GE_SECOND

AddExpr ::= AddExpr ( '+' | '-' ) MulExpr | MulExpr

MulExpr ::= MulExpr ( '*' | '/' | '%' ) UnaryExpr | UnaryExpr

/* 前置。被演算子は、前置か、後置を含む項。 */
UnaryExpr ::= '-' UnaryExpr
            | '!' UnaryExpr
            | 'await' UnaryExpr
            | 'spawn' UnaryExpr
            | 'move' UnaryExpr
            | '&' 'mut' UnaryExpr
            | '&' [ ns: 'mut' ] UnaryExpr
            | CaptureExpr
            | PostN
            | PostM
            | PostO

/* `capture value|move|borrow` の被演算子は、後置のつかないクロージャ。ブロックの形のクロージャのあとに後置が
   続くと、Parser は（外側がどう読めるかに関わらず）その場で誤りにする。そのため、後置の始まりを [ ns: ] で除く。
   短い形の本体は後置を含めて読み切るので、除く必要がない。 */
CaptureExpr ::= 'capture' ( 'value' | 'move' | 'borrow' ) CaptureClosure

CaptureClosure ::= ClosureHead Expr
                 | ClosureHead '->' Type FnBlock [ ns: '(' ] [ ns: '[' ] [ ns: '.' ] [ ns: '::' ] [ ns: '?' ]

/* 後置の連鎖は、項の形で 3 つの状態に分ける（Parser が項の種類を見て `::` と `.名前<` を許すため）。
     PostN: 名前だけの項（`a`、`E::A`）。`.名前<T>(` を試せる。
     PostM: 名前のメンバー（`a.b`、`a.0`）。`::` を続けられる（`a.b::C`）。
     PostO: それ以外。`::` も `.名前<` も続けられない。
   括弧は、中が名前だけの項（PostN、PostM）なら、その状態のまま（Parser の `( 式 )` は中の式をそのまま返す。
   `(a)::B`、`(a.b)::C`）。それ以外の括弧は PostO。 */
PostN ::= NameAtom
        | '(' PostN ')'
        | PostM '::' Name
        | PostN '::' Name

PostM ::= PostN '.' Name
        | PostN '.' INT
        | '(' PostM ')'

PostO ::= OtherAtom
        | CtorAtom
        | GenericCall
        | PostN '.' FLOAT
        | PostN '.' Name TypeArgs CallArgs
        | PostN CallArgs
        | PostN '[' Expr ']'
        | PostN '?'
        | PostM '.' Name
        | PostM '.' INT
        | PostM '.' FLOAT
        | PostM CallArgs
        | PostM '[' Expr ']'
        | PostM '?'
        | PostM '::' Name CtorFields
        | PostN '::' Name CtorFields
        | PostO '.' Name
        | PostO '.' INT
        | PostO '.' FLOAT
        | PostO CallArgs
        | PostO '[' Expr ']'
        | PostO '?'

/* 名前。`{` が続いても名前のまま読める（`{` が構築になる場合は、CtorAtom でも読める。曖昧な文法）。 */
NameAtom ::= ExprHead
           | ExprHead ( '::' Name )+
           | ExprHead TypeArgs ( '::' Name )+

/* `::` を含む名前のあとの `{ 名前 :` と `{ }` は構築（曖昧さの解消の説明を参照）。 */
CtorAtom ::= ExprHead ( '::' Name )+ CtorFields
           | ExprHead TypeArgs ( '::' Name )+ CtorFields

CtorFields ::= '{' ( CtorField ( ',' CtorField )* ','? )? '}'

CtorField ::= Name ':' Expr

/* 名前 `<型引数>` のあとが `(` のとき、型引数つきの呼び出しになる。 */
GenericCall ::= ExprHead TypeArgs CallArgs

CallArgs ::= '(' ( CallArg ( ',' CallArg )* ','? )? ')'

CallArg ::= IDENT ':' Expr
          | Expr

OtherAtom ::= OtherAtomBase
            | ClosureExpr

OtherAtomBase ::= INT
            | FLOAT
            | STRING
            | RAW_STRING
            | 'true'
            | 'false'
            | 'None'
            | 'null'
            | '(' ')'
            | '(' Expr ')'
            | '(' Expr ',' ( Expr ( ',' Expr )* ','? )? ')'
            | ListLit
            | MapLit
            | BlockExpr
            | IfExpr
            | MatchExpr

/* 条件部（if・while・match の条件、if let と while let の値、for の繰り返しの対象と範囲の端）の式。
   Expr と同じ形で、括弧・角括弧・波括弧に囲まれない位置の空の構築 `E::A {}` だけを除く（そこでは `{ }` は本体）。
   括弧などの内側は、Expr に戻る。 */
CExpr ::= COrExpr

COrExpr ::= COrExpr '||' CAndExpr | CAndExpr

CAndExpr ::= CAndExpr '&&' CEqExpr | CEqExpr

CEqExpr ::= CEqExpr ( '==' | '!=' ) CCmpExpr | CCmpExpr

CCmpExpr ::= CCmpExpr CmpOp CAddExpr | CAddExpr

CAddExpr ::= CAddExpr ( '+' | '-' ) CMulExpr | CMulExpr

CMulExpr ::= CMulExpr ( '*' | '/' | '%' ) CUnaryExpr | CUnaryExpr

CUnaryExpr ::= '-' CUnaryExpr
             | '!' CUnaryExpr
             | 'await' CUnaryExpr
             | 'spawn' CUnaryExpr
             | 'move' CUnaryExpr
             | '&' 'mut' CUnaryExpr
             | '&' [ ns: 'mut' ] CUnaryExpr
             | CCaptureExpr
             | CPostN
             | CPostM
             | CPostO

CCaptureExpr ::= 'capture' ( 'value' | 'move' | 'borrow' ) CCaptureClosure

CCaptureClosure ::= ClosureHead CExpr
                  | ClosureHead '->' Type FnBlock [ ns: '(' ] [ ns: '[' ] [ ns: '.' ] [ ns: '::' ] [ ns: '?' ]

CPostN ::= NameAtom
         | '(' PostN ')'
         | CPostM '::' Name
         | CPostN '::' Name

CPostM ::= CPostN '.' Name
         | CPostN '.' INT
         | '(' PostM ')'

CPostO ::= OtherAtomBase
         | CClosureExpr
         | CCtorAtom
         | GenericCall
         | CPostN '.' FLOAT
         | CPostN '.' Name TypeArgs CallArgs
         | CPostN CallArgs
         | CPostN '[' Expr ']'
         | CPostN '?'
         | CPostM '.' Name
         | CPostM '.' INT
         | CPostM '.' FLOAT
         | CPostM CallArgs
         | CPostM '[' Expr ']'
         | CPostM '?'
         | CPostM '::' Name CtorFieldsNE
         | CPostN '::' Name CtorFieldsNE
         | CPostO '.' Name
         | CPostO '.' INT
         | CPostO '.' FLOAT
         | CPostO CallArgs
         | CPostO '[' Expr ']'
         | CPostO '?'

CCtorAtom ::= ExprHead ( '::' Name )+ CtorFieldsNE
            | ExprHead TypeArgs ( '::' Name )+ CtorFieldsNE

CtorFieldsNE ::= '{' CtorField ( ',' CtorField )* ','? '}'

CClosureExpr ::= ClosureHead CExpr
               | ClosureHead '->' Type FnBlock

ListLit ::= '[' Expr ( ',' Expr )* ','? ']'

/* `{` の次が `}` でなく、その次が `:` のとき、マップ。最初の鍵は 1 トークンの式に限る。 */
MapLit ::= '{' MapKey1 ':' Expr ( ',' MapEntry )* ','? '}'

MapEntry ::= Expr ':' Expr

MapKey1 ::= [ ns: 'if' ] [ ns: 'match' ] [ ns: 'await' ] [ ns: 'spawn' ] [ ns: 'move' ] IDENT
          | INT
          | FLOAT
          | STRING
          | RAW_STRING

ClosureExpr ::= ClosureHead Expr
              | ClosureHead '->' Type FnBlock

ClosureHead ::= '||'
              | '|' '|'
              | '|' ClosureParam ( ',' ClosureParam )* ','? '|'

ClosureParam ::= Name ( ':' Type )?

/* `else` が続けば、必ず else 節になる（else のない `if` の直後は `else` でない）。 */
IfExpr ::= 'if' ( 'let' Pattern '=' | [ ns: 'let' ] ) CExpr BlockExpr
           ( 'else' ( IfExpr | BlockExpr ) | [ ns: 'else' ] )

MatchExpr ::= 'match' CExpr '{' MatchArms '}'

/* 腕のあいだは `,`。結果がブロックかリストかマップのとき（ただし直後に二項演算子や後置が続かないとき）は、
   `,` を省ける。省いた場合、次の腕のパターンが `(`、`[`、`-` で始まると、前の結果の後置・演算子として
   読まれるので、その形は結果が続く式になる（[ ns: ] で書く）。最後の腕は `,` なしでよい。 */
MatchArms ::= ( MatchArm ',' | BlockArm )* MatchArmLast?

MatchArm ::= Pattern ( 'if' Expr )? '=>' Expr

BlockArm ::= Pattern ( 'if' Expr )? '=>' ArmBlockLike ( ',' | [ ns: '(' ] [ ns: '[' ] [ ns: '-' ] )

MatchArmLast ::= Pattern ( 'if' Expr )? '=>' Expr

ArmBlockLike ::= BlockExpr | ListLit | MapLit

/* ---------------------------------------------------------------- 文とブロック（段階 D）
   ブロックは 2 種類ある。
   - FnBlock（Parser の block()）: 関数本体、`if`・`while`・`for` などの文の本体、`branch`、`external`、
     match の文の腕の `{ }`、`->` つきクロージャの本体。文だけを並べる（末尾の式は置けない）。
     let-else（`let 大文字の名前( … ) = 式 else { … }`）は、この形のブロックにだけ書ける。
     let-else は、そのブロックの残りの全部（閉じの `}` まで）を、続きの文として取る。
   - BlockExpr（Parser の block_expression()）: 式としての `{ }` と、式の `if` の本体。末尾の `;` のない式が
     ブロックの値になる。let-else は書けない。
   文の先頭の語（let var using while for break continue return defer commit revert resume drop publish branch
   runtime external）で始まる文は、BlockExpr の中でも FnBlock の中でも、必ず文として読まれる。
   BlockExpr の中の `if`・`match`・`{` で始まる文は、まず式として読み、式として読めなければ文として読み直す。
   この順序つきの選択は、曖昧な文法（どちらでも受理する）と、式が続く記号の先読み（NoContinue）で書く。 */

FnBlock ::= '{' FnBody

/* 閉じの `}` まで。let-else があれば、その続きが残りの本体になる。 */
FnBody ::= Stmt* ( '}' | LetElse FnBody )

/* 名前が大文字で始まり、直後が `(` か `::` のときだけ let-else になる（`let_else_ahead`）。
   大文字は char::is_uppercase の結果で、テスト側が種別 UPPER_IDENT をつける。 */
LetElse ::= 'let' LetElsePattern '=' Expr 'else' FnBlock ';'?

LetElsePattern ::= UPPER_IDENT PatArgs
                 | UPPER_IDENT ( '::' Name )+ ( PatArgs | PatFields )?

PatArgs ::= '(' ( Pattern ( ',' Pattern )* ','? )? ')'

PatFields ::= '{' ( FieldPattern ( ',' FieldPattern )* ','? )? '}'

Stmt ::= KeywordStmt
       | IfStmt
       | MatchStmt
       | FnBlock
       | ExprStmt

/* 先頭の語で決まる文。 */
KeywordStmt ::= LetStmt
              | 'using' Name '=' Expr ';'
              | WhileStmt
              | ForStmt
              | 'break' ';'
              | 'continue' ';'
              | 'return' Expr? ';'
              | 'defer' Expr ';'
              | 'external' ( 'live' | 'fresh' )? FnBlock
              | 'commit' Name ';'
              | 'revert' LabelName ';'
              | 'resume' LabelName ';'
              | 'drop' Name ';'
              | 'publish' 'force'? ';'
              | 'branch' Name FnBlock
              | RuntimeStmt

/* `let (a, b) = e;` の括弧の中は Pattern と同じ形で受理する（束縛・タプル・`_` だけという検査は値の検査）。 */
LetStmt ::= ( 'let' | 'var' ) ( Name | TuplePattern ) ( ':' Type )? '=' Expr ';'

/* revert と resume は、`begin` だけ名前として書ける。 */
LabelName ::= 'begin' | Name

IfStmt ::= 'if' ( 'let' Pattern '=' | [ ns: 'let' ] ) CExpr FnBlock
           ( 'else' ( IfStmt | FnBlock ) | [ ns: 'else' ] )

WhileStmt ::= 'while' ( 'let' Pattern '=' | [ ns: 'let' ] ) CExpr FnBlock

/* `..` の範囲は、名前の形のときだけ。括弧のパターンのときは、式の 1 つだけ。 */
ForStmt ::= 'for' TuplePattern 'in' CExpr FnBlock
          | 'for' Name 'in' CExpr ( '..' CExpr )? FnBlock

/* 設定名は 4 つ。値は 10 進の数字だけのトークンで、単位（KB KiB MB MiB GB GiB）を続けられる。 */
RuntimeStmt ::= 'runtime' '{' RuntimeSetting* '}'

RuntimeSetting ::= RuntimeName '=' DIGITS RuntimeUnit? ';'

RuntimeName ::= 'historyMemory' | 'historyStorage' | 'spillThreshold' | 'executionSteps'

RuntimeUnit ::= 'KB' | 'KiB' | 'MB' | 'MiB' | 'GB' | 'GiB'

/* match の文。腕のあいだは必ず `,` で、`{ }` の腕のあとにも要る。 */
MatchStmt ::= 'match' CExpr '{' ( StmtArm ( ',' StmtArm )* ','? )? '}'

StmtArm ::= Pattern ( 'if' Expr )? '=>' ArmBody

ArmBody ::= 'return' ( Expr ';'? )?
          | FnBlock
          | [ ns: 'return' ] [ ns: '{' ] Expr

/* 文の先頭の語（external を除く）は、式の名前として読まれない。 */
KwNot ::= [ ns: 'let' ] [ ns: 'var' ] [ ns: 'using' ] [ ns: 'while' ] [ ns: 'for' ] [ ns: 'break' ]
          [ ns: 'continue' ] [ ns: 'return' ] [ ns: 'defer' ] [ ns: 'commit' ] [ ns: 'revert' ]
          [ ns: 'resume' ] [ ns: 'drop' ] [ ns: 'publish' ] [ ns: 'branch' ] [ ns: 'runtime' ]

/* FnBlock の中では、`if`・`match`・`{` で始まる文は、必ず文の形で読まれる。 */
ExprStmt ::= KwNot [ ns: 'if' ] [ ns: 'match' ] [ ns: '{' ] Expr ( AssignOp Expr )? ';'

AssignOp ::= '=' | '+=' | '-=' | '*=' | '/=' | '%='

/* ---------------------------------------------------------------- 式としてのブロックの中身 */

BlockExpr ::= '{' BlockItem* BlockTail? '}'

BlockStart ::= KwNot [ ns: 'external' ]

/* 文の先頭の語は、ブロックの値になる式の先頭でも名前にならない。ただし `external` が式の名前の文は、
   文の読み方（stmt()）で読まれるので、ExprStmt として書ける。 */
BlockItem ::= KeywordStmt
            | ExprStmt
            | BlockStart Expr AssignOp Expr ';'
            | BlockStart Expr ';'
            | BlockStart BlockLike NoContinue
            | BlockFallback NoContinue

BlockTail ::= BlockStart Expr

/* `;` を省けるのは、式の全体が `if`・`match`・`{ }`・マップ（Parser の式の種類が Block か Match）のとき。 */
BlockLike ::= IfExpr | MatchExpr | BlockExpr | MapLit

/* 式として読めなかったときの、文としての読み直し。 */
BlockFallback ::= IfStmt | MatchStmt | FnBlock

/* 式が続く記号。直後にこれが来ると、前の `if`・`match`・`{ }` は式の一部になる。 */
NoContinue ::= [ ns: '(' ] [ ns: '[' ] [ ns: '.' ] [ ns: '?' ] [ ns: '||' ] [ ns: '&&' ] [ ns: '==' ]
               [ ns: '!=' ] [ ns: '<' ] [ ns: '<=' ] [ ns: '>' ] [ ns: '+' ] [ ns: '-' ] [ ns: '*' ]
               [ ns: '/' ] [ ns: '%' ]

/* ================================================================ 宣言と全体（段階 D）
   Parser の program()。`pub` のあとは、宣言だけが続く（そうでなければ誤り）。`pub import` と `pub impl` は誤り。
   `pub fn` は `->` が必要。どの宣言の先頭の語でもないものは、文として読む。
   2.0.0 以前のトップレベルの文と、3.x の `fn main` の規則は、構文では区別しない（どちらも Item の列）。
   入力の終わり（EOF）は、トークン列の終わりで表す。 */

Program ::= Item*

Item ::= Decl
       | 'pub' Decl
       | FnDecl
       | 'pub' PubFnDecl
       | ImportDecl
       | ImplDecl
       | TopStmt

Decl ::= EffectsDecl | TypeDecl | EnumDecl | TraitDecl | StructDecl | ConstDecl

/* 宣言の先頭の語は、トップレベルでは必ず宣言として読まれ、式の名前にならない。 */
TopStmt ::= [ ns: 'pub' ] [ ns: 'effects' ] [ ns: 'import' ] [ ns: 'type' ] [ ns: 'enum' ] [ ns: 'trait' ]
            [ ns: 'impl' ] [ ns: 'struct' ] [ ns: 'record' ] [ ns: 'fn' ] [ ns: 'async' ] [ ns: 'const' ] Stmt

EffectsDecl ::= 'effects' '{' ( Name ( ',' Name )* ','? )? '}' ';'?

/* `import a.b`、`import a.b.{x, y as z}`、`import a.b::{x}`、`import a.b as c`。
   別名は、選ぶ名前の一覧が空か、ないときだけ書ける。 */
ImportDecl ::= 'import' ImportPath ( ( '.' ImportList )? ( '::' ImportList )?
                                   | ( '.' ImportEmpty )? ( '::' ImportEmpty )? 'as' Name ) ';'

ImportPath ::= Name ( '.' Name )*

ImportList ::= '{' ( ImportItem ( ',' ImportItem )* ','? )? '}'

ImportEmpty ::= '{' '}'

ImportItem ::= Name ( 'as' Name )?

TypeDecl ::= 'type' Name TypeParams '=' Type ';'

EnumDecl ::= 'enum' Name TypeParams '{' ( Variant ( ',' Variant )* ','? )? '}'

Variant ::= Name ( '(' ( Type ( ',' Type )* ','? )? ')'
                 | '{' ( FieldDecl1 ( ',' FieldDecl1 )* ','? )? '}' )?

FieldDecl1 ::= Name ':' Type

TraitDecl ::= 'trait' Name '{' TraitItem* '}'

TraitItem ::= 'type' Name ';'
            | 'fn' Name '(' ( FieldDecl1 ( ',' FieldDecl1 )* ','? )? ')' '->' Type EffectSet? ( FnBlock | ';' )

ImplDecl ::= 'impl' TypeParams Name 'for' Type '{' ImplItem* '}'

ImplItem ::= 'type' Name '=' Type ';'
           | 'fn' Name '(' ( FieldDecl1 ( ',' FieldDecl1 )* ','? )? ')' '->' Type EffectSet? FnBlock

/* 欄の前の `private` か `pub`。修飾なしの欄の名前は `private` と `pub` にできない。 */
StructDecl ::= ( 'struct' | 'record' ) Name TypeParams WhereClause? '{' ( StructField ( ',' StructField )* ','? )? '}'

StructField ::= ( 'private' | 'pub' ) Name ':' Type
              | [ ns: 'private' ] [ ns: 'pub' ] Name ':' Type

ConstDecl ::= 'const' Name ':' Type '=' Expr ';'

/* `test` は直後が `fn` のときだけ接頭辞になる（`test async fn` は誤り）。 */
FnPrefix ::= 'test' 'fn' | 'async' 'fn' | 'fn'

FnDecl ::= FnPrefix Name TypeParams FnParams
           ( '->' Type EffectSet? WhereClause? FnBody1
           | EffectSet? WhereClause? FnBlock )

PubFnDecl ::= FnPrefix Name TypeParams FnParams '->' Type EffectSet? WhereClause? FnBody1

FnBody1 ::= FnBlock | '=' Expr ';'

/* 既定値のある引数は、既定値のない引数のあとに、まとめて置く。 */
FnParams ::= '(' ')' | '(' ParamSeq ','? ')'

ParamSeq ::= Param ( ',' Param )* ( ',' DefParam )*
           | DefParam ( ',' DefParam )*

Param ::= Name ':' Type

DefParam ::= Name ':' Type '=' DefaultValue

/* 既定値は、リテラル（`None` と `null` と `()` を含む）か、`-` のあとにリテラル。Parser の式の種類が値のもの
   だけを受理する。括弧は式をそのまま返すので、囲んでもよい（`(-1)` は受理、`-(-1)` は拒否）。 */
DefaultValue ::= DefLit | '-' DefLit | '(' DefaultValue ')'

DefLit ::= INT | FLOAT | STRING | RAW_STRING | 'true' | 'false' | 'null' | 'None' | '(' ')' | '(' DefLit ')'

/* 数字だけのトークン（runtime の値）。テスト側が種別 DIGITS をつける。 */
DIGITS ::= [0-9]+

/* 先頭が大文字（char::is_uppercase）の名前。テスト側が種別 UPPER_IDENT をつける。 */
UPPER_IDENT ::= [A-Z] IDENT_CHAR*

/* 前処理で `>=` を分けたトークンの種別。lex() が出す種別ではない（上の説明を参照）。 */
GE_FIRST ::= '>'

GE_SECOND ::= '='

/* `_` と ASCII の数字だけの名前。種別は IDENT のほかにこれも持つ（1 つのトークンが複数の種別を持てる）。 */
UNDERSCORE_NUM ::= '_' [_0-9]*

/* ================================================================ 付録 A: Unicode の表
   次の 3 つの表は、Rust の標準ライブラリ（char::is_alphabetic、char::is_alphanumeric、
   char::is_whitespace）の結果を、そのまま範囲にしたもの。
   lexcheck の単体テストが、全コードポイントでこの表と標準ライブラリが一致することを確かめる。
   Rust の版を上げて Unicode の版が変わったときは、そのテストの失敗が知らせる。 */

