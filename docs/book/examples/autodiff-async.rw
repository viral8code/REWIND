import std.autodiff as ad;import std.autodiffAsync as jobs;import std.numeric as n;import std.numericIndex as index;import std.task as task;
fn take<T,E>(r:Result<T,E>)->T effects {} {match move r{Ok(v)=>{return move v;},Err(_)=>{panic("backward failed");}}}
fn model(x:FloatArray)->(ad.Tape,ad.Node,ad.Node) effects {} {var tape=ad.create();let parameter=take(ad.parameter(&mut tape,"x",x));let square=take(ad.unary(&mut tape,"square",parameter));let loss=take(ad.sum(&mut tape,square));return (move tape,parameter,loss);}
async fn marker()->Int effects {tasks}{return 7;}
let one=List<Int>();one.add(1);let values=List<Float>();values.add(0.5);let scalar=take(n.fromFloat(&one,&values));let shape=List<Int>();shape.add(32769);let x=take(n.broadcastFloat(&scalar,&shape));
let graph=model(x);let expected=take(ad.backward(&graph._0,graph._2));let work=spawn jobs.backward(move graph._0,graph._2);let fast=spawn marker();assert_eq(take(await fast),7);assert(!work.isDone());
commit halfway;
let answer=take(take(await work));assert_eq(take(ad.gradient(&answer,graph._1)),take(ad.gradient(&expected,graph._1)));Out.println(true);publish;
revert halfway;
let restored=take(take(await work));assert_eq(take(ad.gradient(&restored,graph._1)),take(ad.gradient(&expected,graph._1)));Out.println(true);drop halfway;publish;
let another=model(x);let cancelled=spawn jobs.backward(move another._0,another._2);task.yieldNow();assert(!cancelled.isDone());cancelled.cancel();match await cancelled{Err(TaskError::Cancelled)=>{},_=>{panic("partial gradient escaped");}}
Out.println("backward done");publish;
