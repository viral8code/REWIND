import std.persistentSet as persistentSet;

fn take<T,E>(value:Result<T,E>)->T effects {} {
    match move value {Ok(result)=>{return move result;},Err(_)=>{panic("persistent set example");}}
}

// Expected output (not executed): false, true, false, true.
fn main()->Int {
    let base=take(persistentSet.create(4));
    let left=take(persistentSet.unite(base,0,1)).state;
    let right=take(persistentSet.unite(base,1,2)).state;
    Out.println(take(persistentSet.same(base,0,1)));
    Out.println(take(persistentSet.same(left,0,1)));
    Out.println(take(persistentSet.same(right,0,1)));
    Out.println(take(persistentSet.same(right,1,2)));
    return 0;
}
