import std.memo as memo;
import std.memo.{create as createMemo};

fn take<T,E>(value:Result<T,E>)->T effects {} {
    match move value {Ok(result)=>{return move result;},Err(_)=>{panic("memo example");}}
}
fn answer()->Int effects {} {return 42;}

// Expected output (not executed): false, true, 42.
fn main()->Int {
    let cache=take(createMemo<Int>(16,1024));
    let key=take(memo.key("answer","implementation-v1",""));
    let first=take(memo.resolve(&mut cache,key,1,answer));
    let second=take(memo.resolve(&mut cache,key,1,answer));
    Out.println(first.hit);Out.println(second.hit);Out.println(second.value);
    return 0;
}
