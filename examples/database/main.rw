import std.db as db;

record Score {name:String,score:Int}
fn mapScore(row:Frozen<DbRow>,columns:&db.ColumnMap)->Result<Score,DbError> effects {} {
    let nameIndex=db.columnNumber(columns,"name")?;
    let scoreIndex=db.columnNumber(columns,"score")?;
    let name=db.text(row,nameIndex)?;
    let score=db.integer(row,scoreIndex)?;
    return Ok(Score(name,score));
}
fn take<T,E>(value:Result<T,E>)->T effects {} {
    match move value {Ok(item)=>{return move item;},Err(_)=>{panic("database operation failed");}}
}
var opening:Option<Task<Result<DbConnection,DbError>>>=None;
external {opening=Some(db.sqlite(":memory:",false,5000));}
match opening {
    None=>{panic("missing connection");},
    Some(task)=>{
        let connection=take(take(await task));
        var writing:Option<Task<Result<Int,DbError>>>=None;
        external {writing=Some(db.execute(&mut connection,"CREATE TABLE scores (name TEXT, score INTEGER)",freeze(List<DbValue>()),5000));}
        match writing {Some(task)=>{take(take(await task));},None=>{panic("missing write");}}
        let values=List<DbValue>();values.push(DbValue::Text("Alice"));values.push(DbValue::Int(42));
        external {writing=Some(db.execute(&mut connection,"INSERT INTO scores VALUES (?1, ?2)",freeze(move values),5000));}
        match writing {Some(task)=>{Out.println(take(take(await task)));},None=>{panic("missing insert");}}
        var querying:Option<Task<Result<DbCursor,DbError>>>=None;
        external {querying=Some(db.query(&mut connection,"SELECT name, score FROM scores",freeze(List<DbValue>()),5000));}
        match querying {
            None=>{panic("missing query");},
            Some(task)=>{
                let cursor=take(take(await task));
                var reading:Option<Task<Result<DbBatch,DbError>>>=None;
                external {reading=Some(db.next(&mut cursor,64,1048576,5000));}
                match reading {None=>{panic("missing read");},Some(task)=>{let batch=take(take(await task));let columnMap=take(db.indexColumns(cursor.columns));let mapped=take(db.mapBatch(&batch,&columnMap,mapScore));let score=mapped.rows.get(0);Out.println(score.name);Out.println(score.score);}}
            }
        }
    }
}
var cleanup:Option<Task<Result<Unit,DbError>>>=None;
external {cleanup=Some(db.waitForCleanup(5000));}
match cleanup {None=>{panic("missing cleanup");},Some(task)=>{take(take(await task));}}
publish;
