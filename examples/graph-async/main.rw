import std.numeric as numeric;
import std.numericRange as range;
import std.numericIndex as index;
import std.graphLargeAsync as jobs;
import std.task as task;
fn take<T,E>(value:Result<T,E>)->T effects {} {
 match move value {Ok(v)=>{return move v;},Err(_)=>{panic("graph operation failed");}}
}
async fn marker()->Int effects {tasks} {return 7;}
// A directed chain plus one unreachable vertex; immutable shared edge pages.
let froms=take(range.integers(0,1,16383));
let tos=take(range.integers(1,1,16383));
let reversedFroms=take(numeric.sliceInt(&froms,0,16382,16383,-1));
let reversedTos=take(numeric.sliceInt(&tos,0,16382,16383,-1));
let work=spawn jobs.bfs(16385,reversedFroms,reversedTos,0);
let fast=spawn marker();assert_eq(take(await fast),7);assert(!work.isDone());
commit halfway;
let distances=take(take(await work));
assert_eq(take(index.getInt(&distances,16383)),16383);
assert_eq(take(index.getInt(&distances,16384)),-1);
Out.println(true);publish;
revert halfway;
let again=take(take(await work));
assert_eq(take(index.getInt(&again,16383)),16383);
assert_eq(take(index.getInt(&again,16384)),-1);
Out.println(true);drop halfway;publish;
let cancelled=spawn jobs.bfs(16385,froms,tos,0);task.yieldNow();assert(!cancelled.isDone());
cancelled.cancel();match await cancelled{Err(TaskError::Cancelled)=>{},_=>{panic("partial result escaped");}}
Out.println("graph done");publish;
