fn take<T,E>(r:Result<T,E>)->T effects {} {match move r{Ok(v)=>{return move v;},Err(_)=>{panic("unexpected encoding error");}}}
var text="x";for i in 0..20{text+=text;}
let data=take(stdEncode(text));
let items=List<Bytes>();commit saved;
for i in 0..32{items.add(data);}
Out.println(items.len());publish;
revert saved;assert_eq(items.len(),0);Out.println(items.len());drop saved;publish;
