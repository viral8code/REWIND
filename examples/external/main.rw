import std.external as host;
var stamp=0;
commit before;
external {
    match host.millis() {
        Ok(n)=>{stamp=n;},
        Err(e)=>{Out.println(e.code);}
    }
}
Out.println(stamp);
publish;
revert before;
external {
    match host.millis() {
        Ok(n)=>{stamp=n;},
        Err(e)=>{Out.println(e.code);}
    }
}
Out.println(stamp);
publish;
