import std.text as text;
import std.number as number;
import std.collections as collections;
fn main()->Int effects {input,output} {
    var line="";
    match In.readLine(){Some(value)=>{line=value;},None=>{return 2;}}
    var tokens=List<String>();
    match text.tokens(line){Ok(value)=>{tokens=move value;},Err(_)=>{return 2;}}
    let values=List<Int>();var i=0;
    while i<tokens.len(){match number.decimal(tokens.get(i)){Ok(value)=>{values.add(value);},Err(_)=>{return 2;}}i+=1;}
    let total=collections.fold(&values,0,|a:Int,b:Int|->Int{return a+b;});
    Out.println(total);publish;return 0;
}
