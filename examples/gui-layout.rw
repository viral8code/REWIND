import std.gui as gui;

fn take<T,E>(value:Result<T,E>)->T effects {} {
    match move value {
        Ok(item)=>{return move item;},
        Err(_)=>{panic("layout calculation failed");}
    }
}

fn main()->Int {
    let view=take(gui.window("nested layout",320,240));
    take(gui.label(&mut view,"header","Header",0,0,10,10));
    take(gui.label(&mut view,"left","Left",0,0,10,10));
    take(gui.label(&mut view,"right","Right",0,0,10,10));

    let bodyChildren=List<gui.WeightedLayout>();
    bodyChildren.add(take(gui.sized(take(gui.leaf("left")),3,80,150)));
    bodyChildren.add(take(gui.sized(take(gui.leaf("right")),1,60,240)));
    let body=take(gui.row(&bodyChildren,4));

    let pageChildren=List<gui.WeightedLayout>();
    pageChildren.add(take(gui.weighted(take(gui.leaf("header")),1)));
    pageChildren.add(take(gui.weighted(body,3)));
    let page=take(gui.column(&pageChildren,4));
    take(gui.applyLayout(&mut view,&page,gui.Rect(0,0,320,240)));
    Out.println(take(gui.scene(&view)));
    return 0;
}
