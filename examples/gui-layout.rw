import std.gui as gui;

fn take<T,E>(value:Result<T,E>)->T effects {} {
    match move value {
        Ok(item)=>{return move item;},
        Err(_)=>{panic("layout calculation failed");}
    }
}

let view=take(gui.window("weighted layout",100,64));
take(gui.label(&mut view,"left","Left",0,0,10,10));
take(gui.label(&mut view,"right","Right",10,0,10,10));
let ids=List<String>();
ids.add("left");
ids.add("right");
let weights=List<Int>();
weights.add(1);
weights.add(2);
take(gui.arrangeRow(&mut view,&ids,Rect(0,0,100,30),&weights,2));
Out.println(take(gui.scene(&view)));
