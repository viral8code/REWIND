import std.textIndex as textIndex;

fn take<T,E>(value:Result<T,E>)->T effects {} {
    match move value {Ok(result)=>{return move result;},Err(_)=>{panic("text position example");}}
}

// Expected output (not executed): 8, 4, 3, é on separate lines.
fn main()->Int {
    let source=take(textIndex.create("A😀é"));
    Out.println(textIndex.byteLength(source));
    Out.println(textIndex.scalarLength(source));
    Out.println(textIndex.graphemeLength(source));
    let start=take(textIndex.graphemeAt(source,2));
    let end=take(textIndex.graphemeAt(source,3));
    Out.println(take(textIndex.sliceGraphemes(start,end)));
    return 0;
}
