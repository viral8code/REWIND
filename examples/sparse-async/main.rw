import std.numeric as numeric;import std.sparse as sparse;import std.sparseAsync as sparseAsync;import std.task as task;
fn take<T,E>(value:Result<T,E>)->T effects {} {match move value{Ok(v)=>{return move v;},Err(_)=>{panic("failed");}}}
async fn marker()->Int effects {tasks}{return 7;}
let shape=List<Int>();shape.add(16384);let zero=take(numeric.zerosFloat(&shape));let ones=take(numeric.mapFloat("exp",&zero));
let offsetsShape=List<Int>();offsetsShape.add(16385);let offsets=take(numeric.zerosInt(&offsetsShape));
let emptyShape=List<Int>();emptyShape.add(0);let indices=take(numeric.zerosInt(&emptyShape));let values=take(numeric.zerosFloat(&emptyShape));
let matrix=sparse.Matrix(16384,16384,offsets,indices,values);
let work=spawn sparseAsync.matvec(matrix,ones);let fast=spawn marker();assert_eq(take(await fast),7);assert(!work.isDone());
commit halfway;let first=take(take(await work));assert_eq(take(numeric.sum(&first)),0.0);
revert halfway;let restored=take(take(await work));assert_eq(take(numeric.sum(&restored)),0.0);drop halfway;
let cancelled=spawn sparseAsync.matvec(matrix,ones);task.yieldNow();assert(!cancelled.isDone());cancelled.cancel();match await cancelled{Err(TaskError::Cancelled)=>{},_=>{panic("partial result escaped");}}
Out.println("sparse done");publish;
