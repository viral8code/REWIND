import std.guiTable as table;

pub record Task {title:String,done:Bool}
enum RowError {Shape,Done}

fn take<T,E>(value:Result<T,E>)->T effects {} {
    match move value {
        Ok(item)=>{return move item;},
        Err(_)=>{panic("table row conversion failed");}
    }
}

fn parseTask(cells:Frozen<List<String>>)->Result<Task,RowError> effects {} {
    if cells.len()!=2{return Err(RowError::Shape);}
    let done=match cells.get(1) {
        "true"=>{true},
        "false"=>{false},
        _=>{return Err(RowError::Done);}
    };
    return Ok(Task(cells.get(0),done));
}

let headers=List<String>();
headers.add("Title");
headers.add("Done");
let rowIds=List<String>();
rowIds.add("task-a");
rowIds.add("task-b");
let cells=List<String>();
cells.add("Alpha");
cells.add("false");
cells.add("Beta");
cells.add("true");
let model=take(table.createWithIds(freeze(headers),freeze(rowIds),freeze(cells),4));

take(table.filterByText(&mut model,0,"Beta"));
take(table.editCellId(&mut model,"task-a",0,"Alpha revised"));
let task=take(table.toValue(&model,"task-a",parseTask));
Out.println(task.title);
Out.println(task.done.format());
