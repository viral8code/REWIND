import std.db as db;

record StatusRow {ready:Bool,score:Int,name:String}
fn mapStatus(row:Frozen<DbRow>,columns:&db.ColumnMap)->Result<StatusRow,DbError> effects {} {
    let readyIndex=db.columnNumber(columns,"ready")?;
    let scoreIndex=db.columnNumber(columns,"score")?;
    let nameIndex=db.columnNumber(columns,"name")?;
    let ready=db.boolean(row,readyIndex)?;
    let score=db.integer(row,scoreIndex)?;
    let name=db.text(row,nameIndex)?;
    return Ok(StatusRow(ready,score,name));
}
fn take<T,E>(value:Result<T,E>)->T effects {} {
    match move value {Ok(item)=>{return move item;},Err(_)=>{panic("database operation failed");}}
}
var opening:Option<Task<Result<DbConnection,DbError>>>=None;
match Env.getSecret("REWIND_PG_DSN") {
    None=>{panic("supply REWIND_PG_DSN as a secret environment value");},
    Some(connectionString)=>{
        let ca=take(File.readBytes("ca.der"));
        external {take(db.credentials("database",move connectionString,move ca));opening=Some(db.postgres("database",5000));}
    }
}
match opening {
    None=>{panic("missing connection task");},
    Some(task)=>{
        let connection=take(take(await task));
        let parameters=List<DbValue>();parameters.push(DbValue::Bool(true));parameters.push(DbValue::Int(42));parameters.push(DbValue::Text("Alice"));
        var querying:Option<Task<Result<DbCursor,DbError>>>=None;
        external {querying=Some(db.query(&mut connection,"SELECT $1::boolean AS ready, $2::bigint AS score, $3::text AS name",freeze(move parameters),5000));}
        match querying {
            None=>{panic("missing query task");},
            Some(task)=>{
                let cursor=take(take(await task));
                var reading:Option<Task<Result<DbBatch,DbError>>>=None;
                external {reading=Some(db.next(&mut cursor,64,1048576,5000));}
                match reading {None=>{panic("missing read task");},Some(task)=>{
                    let batch=take(take(await task));let columnMap=take(db.indexColumns(batch.columns));let row=take(mapStatus(batch.rows.get(0),&columnMap));
                    Out.println(row.ready);Out.println(row.score);Out.println(row.name);
                }}
            }
        }
    }
}
var cleanup:Option<Task<Result<Unit,DbError>>>=None;
external {cleanup=Some(db.waitForCleanup(5000));}
match cleanup {None=>{panic("missing cleanup");},Some(task)=>{take(take(await task));}}
publish;
