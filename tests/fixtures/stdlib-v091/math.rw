pub fn min(a:Int,b:Int)->Int effects {} {if a<b {return a;}return b;}
pub fn max(a:Int,b:Int)->Int effects {} {if a>b {return a;}return b;}
pub fn clamp(value:Int,low:Int,high:Int)->Result<Int,String> effects {} {
    if low>high {return Err("InvalidRange");}
    if value<low {return Ok(low);}if value>high {return Ok(high);}return Ok(value);
}
