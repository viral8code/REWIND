await spawn check_mul(positive);

async fn check_matmul(array:FloatArray)->Unit effects {tasks} {
 let expectedTape=ad.create();let x=take(ad.parameter(&mut expectedTape,"x",array));let c=take(ad.constant(&mut expectedTape,array));let y=take(ad.matmul(&mut expectedTape,x,c));let objective=take(ad.sum(&mut expectedTape,y));
 let initial=take(take(await spawn forward.parameter(ad.create(),"x",array)));let owned=move initial._0;let p=initial._1;
 let added=take(take(await spawn forward.constant(move owned,array)));let stage=move added._0;let k=added._1;assert_eq(k,c);
 let transformed=take(take(await spawn forward.matmul(move stage,p,k)));let next=move transformed._0;let actual=transformed._1;assert_eq(actual,y);
 let summed=take(take(await spawn forward.sum(move next,actual)));let complete=move summed._0;let loss=summed._1;assert_eq(loss,objective);
 assert_eq(take(ad.value(&complete,actual)),take(ad.value(&expectedTape,y)));
 let gradients=take(ad.backward(&complete,loss));let expected=take(ad.backward(&expectedTape,objective));assert_eq(take(ad.gradient(&gradients,p)),take(ad.gradient(&expected,x)));
}
await spawn check_matmul(positive);


async fn check_transpose(array:FloatArray)->Unit effects {tasks} {
 let dims=List<Int>();dims.add(3);dims.add(2);dims.add(2);
 let expectedTape=ad.create();let x=take(ad.parameter(&mut expectedTape,"x",array));let y=take(ad.transpose(&mut expectedTape,x));let objective=take(ad.sum(&mut expectedTape,y));
 let initial=take(take(await spawn forward.parameter(ad.create(),"x",array)));let owned=move initial._0;let p=initial._1;
 let transformed=take(take(await spawn forward.transpose(move owned,p)));let next=move transformed._0;let actual=transformed._1;assert_eq(actual,y);
 let summed=take(take(await spawn forward.sum(move next,actual)));let complete=move summed._0;let loss=summed._1;assert_eq(loss,objective);
 assert_eq(take(ad.value(&complete,actual)),take(ad.value(&expectedTape,y)));
 let gradients=take(ad.backward(&complete,loss));let expected=take(ad.backward(&expectedTape,objective));assert_eq(take(ad.gradient(&gradients,p)),take(ad.gradient(&expected,x)));
}
await spawn check_transpose(positive);

async fn check_reshape(array:FloatArray)->Unit effects {tasks} {
 let dims=List<Int>();dims.add(4);
 let expectedTape=ad.create();let x=take(ad.parameter(&mut expectedTape,"x",array));let y=take(ad.reshape(&mut expectedTape,x,&dims));let objective=take(ad.sum(&mut expectedTape,y));
 let initial=take(take(await spawn forward.parameter(ad.create(),"x",array)));let owned=move initial._0;let p=initial._1;
 let transformed=take(take(await spawn forward.reshape(move owned,p,move dims)));let next=move transformed._0;let actual=transformed._1;assert_eq(actual,y);
 let summed=take(take(await spawn forward.sum(move next,actual)));let complete=move summed._0;let loss=summed._1;assert_eq(loss,objective);
 assert_eq(take(ad.value(&complete,actual)),take(ad.value(&expectedTape,y)));
 let gradients=take(ad.backward(&complete,loss));let expected=take(ad.backward(&expectedTape,objective));assert_eq(take(ad.gradient(&gradients,p)),take(ad.gradient(&expected,x)));
}
await spawn check_reshape(positive);

async fn check_broadcast(array:FloatArray)->Unit effects {tasks} {
 let dims=List<Int>();dims.add(3);dims.add(2);dims.add(2);
 let expectedTape=ad.create();let x=take(ad.parameter(&mut expectedTape,"x",array));let y=take(ad.broadcast(&mut expectedTape,x,&dims));let objective=take(ad.sum(&mut expectedTape,y));
 let initial=take(take(await spawn forward.parameter(ad.create(),"x",array)));let owned=move initial._0;let p=initial._1;
 let transformed=take(take(await spawn forward.broadcast(move owned,p,move dims)));let next=move transformed._0;let actual=transformed._1;assert_eq(actual,y);
 let summed=take(take(await spawn forward.sum(move next,actual)));let complete=move summed._0;let loss=summed._1;assert_eq(loss,objective);
 assert_eq(take(ad.value(&complete,actual)),take(ad.value(&expectedTape,y)));
 let gradients=take(ad.backward(&complete,loss));let expected=take(ad.backward(&expectedTape,objective));assert_eq(take(ad.gradient(&gradients,p)),take(ad.gradient(&expected,x)));
}
await spawn check_broadcast(positive);
let axes=List<Int>();axes.add(1);axes.add(0);let transposed=take(n.transposeFloat(&positive,&axes));await spawn check_reshape(transposed);
publish;
