import std.db as db;
import std.dbMigration as mig;
import std.dbTransaction as tx;

fn take<T,E>(value:Result<T,E>)->T effects {} {
    match move value {Ok(item)=>{return move item;},Err(_)=>{panic("operation failed");}}
}
fn text2(a:String,b:String)->Frozen<List<DbValue>> effects {} {
    let items=List<DbValue>();items.add(DbValue::Text(a));items.add(DbValue::Text(b));return freeze(items);
}
fn noParams()->Frozen<List<DbValue>> effects {} {return freeze(List<DbValue>());}
fn commandsOf(first:String,second:String)->List<String> effects {} {
    let c=List<String>();c.add(first);c.add(second);return c;
}
fn migrationOf(id:String,first:String,second:String)->mig.Migration effects {} {
    let c=commandsOf(first,second);
    return take(mig.migration(id,"sqlite",&c));
}
fn goodList()->List<mig.Migration> effects {} {
    let list=List<mig.Migration>();
    list.add(migrationOf("001_users","CREATE TABLE users(id INTEGER)","CREATE INDEX users_id ON users(id)"));
    list.add(migrationOf("002_notes","CREATE TABLE notes(id INTEGER)","CREATE INDEX notes_id ON notes(id)"));
    return list;
}
var opening:Option<Task<Result<DbConnection,DbError>>>=None;
external {opening=Some(db.sqlite(":memory:",false,5000));}
match opening {None=>{panic("open");},Some(task)=>{
    let connection=take(take(await task));
    var step:Option<Task<Result<Int,DbError>>>=None;
    var flow:Option<Task<Result<Unit,DbError>>>=None;
    external {step=Some(db.execute(&mut connection,mig.createTableSql(),noParams(),5000));}
    match step {None=>{panic("version table");},Some(t)=>{take(take(await t));}}

    // First run: read applied rows (none), plan, apply every pending migration in its own transaction.
    let list=goodList();
    let none=List<mig.Applied>();
    let plan=take(mig.plan("sqlite",&list,&none));
    var applied=0;
    var i=0;
    while i<plan.pending.len() {
        let m=thaw(plan.pending.get(i));
        external {flow=Some(db.beginTransaction(&mut connection,5000));}
        match flow {None=>{panic("begin");},Some(t)=>{take(take(await t));}}
        let t=tx.begun();
        var c=0;
        while c<m.commands.len() {
            external {step=Some(db.execute(&mut connection,m.commands.get(c),noParams(),5000));}
            match step {None=>{panic("command");},Some(s)=>{take(take(await s));}}
            c+=1;
        }
        external {step=Some(db.execute(&mut connection,mig.recordSql("sqlite"),text2(m.id,mig.checksum(&m)),5000));}
        match step {None=>{panic("record");},Some(s)=>{take(take(await s));}}
        take(tx.requestCommit(&mut t));
        external {flow=Some(db.commitTransaction(&mut connection,5000));}
        match flow {None=>{panic("commit");},Some(f)=>{take(tx.completeCommit(&mut t,take(await f)));}}
        applied+=1;
        i+=1;
    }
    Out.println(applied);

    // Second run: read the version table back, the plan has nothing pending.
    var querying:Option<Task<Result<DbCursor,DbError>>>=None;
    external {querying=Some(db.query(&mut connection,mig.selectAppliedSql(),noParams(),5000));}
    match querying {None=>{panic("select");},Some(q)=>{
        let cursor=take(take(await q));
        var reading:Option<Task<Result<DbBatch,DbError>>>=None;
        external {reading=Some(db.next(&mut cursor,64,1048576,5000));}
        match reading {None=>{panic("read");},Some(r)=>{
            let batch=take(take(await r));
            let rows=List<mig.Applied>();
            var k=0;
            while k<batch.rows.len() {
                let row=batch.rows.get(k);
                rows.add(mig.Applied(take(db.text(row,0)),take(db.text(row,1))));
                k+=1;
            }
            let second=take(mig.plan("sqlite",&list,&rows));
            Out.println(second.pending.len());
            Out.println(second.alreadyApplied);

            // An edited migration is reported before anything runs.
            let edited=List<mig.Migration>();
            edited.add(migrationOf("001_users","CREATE TABLE users(id INTEGER, extra TEXT)","CREATE INDEX users_id ON users(id)"));
            edited.add(migrationOf("002_notes","CREATE TABLE notes(id INTEGER)","CREATE INDEX notes_id ON notes(id)"));
            match mig.plan("sqlite",&edited,&rows) {
                Err(mig.MigrationError::ChecksumMismatch(id))=>{Out.println("checksum mismatch "+id);},
                _=>{panic("edited migration accepted");}
            }
        }}
    }}

    // A failing command rolls its own migration back and leaves the earlier ones applied.
    let broken=migrationOf("003_broken","CREATE TABLE ok_table(id INTEGER)","THIS IS NOT SQL");
    external {flow=Some(db.beginTransaction(&mut connection,5000));}
    match flow {None=>{panic("begin3");},Some(t)=>{take(take(await t));}}
    let bt=tx.begun();
    external {step=Some(db.execute(&mut connection,broken.commands.get(0),noParams(),5000));}
    match step {None=>{panic("first");},Some(s)=>{take(take(await s));}}
    external {step=Some(db.execute(&mut connection,broken.commands.get(1),noParams(),5000));}
    match step {None=>{panic("second");},Some(s)=>{
        match await s {
            Ok(Ok(_))=>{panic("broken command succeeded");},
            _=>{Out.println("broken command failed");}
        }
    }}
    take(tx.requestRollback(&mut bt));
    external {flow=Some(db.rollbackTransaction(&mut connection,5000));}
    match flow {None=>{panic("rollback");},Some(f)=>{take(tx.completeRollback(&mut bt,take(await f)));}}
    external {step=Some(db.execute(&mut connection,"INSERT INTO ok_table VALUES (1)",noParams(),5000));}
    match step {None=>{panic("probe");},Some(s)=>{
        match await s {Ok(Ok(_))=>{panic("rolled back table exists");},_=>{Out.println("rolled back table is gone");}}
    }}
}}
publish;
