import numeric as numeric;
import flow as flow;
import matching as matching;
import error as error;
import sort as sort;
import segment as segment;
import csv as csv;
import matrix as matrix;
import dp as dp;
import stringSearch as stringSearch;
import bitset as bitset;
import stream as stream;
import collections as collections;
import math as math;
import option as option;
import json as json;
import config as config;
import args as args;
test fn algorithms() {
    assert_eq(json.floating(Json::Float(1.5)),Some(1.5));
    match json.parse("[1,true]") {Ok(v)=>{match json.array(v) {Some(values)=>{assert_eq(json.integer(thaw(values.get(0))),Some(1));assert_eq(json.boolean(thaw(values.get(1))),Some(true));},None=>{panic("expected array");}}},Err(_)=>{panic("expected parsed array");}}

    let values=List<Int>();values.add(1);values.add(2);values.add(3);
    let even=collections.filter(&values,|n:Int|->Bool{return n%2==0;});assert_eq(even.len(),1);assert_eq(even.get(0),2);
    let doubled=collections.map(&values,|n:Int|->Int{return n*2;});assert_eq(doubled.get(2),6);
    assert(collections.any(&values,|n:Int|->Bool{return n==2;}));assert(collections.all(&values,|n:Int|->Bool{return n>0;}));
    let empty=List<Int>();assert(collections.all(&empty,|n:Int|->Bool{return false;}));assert(!collections.any(&empty,|n:Int|->Bool{return true;}));
    assert_eq(math.min(2,3),2);assert_eq(math.max(2,3),3);assert_eq(math.clamp(9,0,5),Ok(5));assert_eq(math.clamp(1,3,2),Err("InvalidRange"));
    assert_eq(option.valueOr(Some(4),0),4);assert_eq(option.valueOr(None,7),7);assert_eq(option.map(Some(3),|n:Int|->Int{return n+1;}),Some(4));
}
test fn configuration_and_arguments() {
    let names=List<String>();names.add("count");let values=List<String>();values.add("--count");values.add("3");
    match args.parse(&values,&names) {Ok(v)=>{assert_eq(v.get("count"),Some("3"));},Err(_)=>{panic("unexpected argument failure");}}
    values.add("--count");values.add("secret-value");match args.parse(&values,&names){Err(e)=>{assert_eq(e.code,"DuplicateOption");},Ok(_)=>{panic("expected duplicate");}}
    let fields=List<config.Field>();fields.add(config.Field("count","Int",false,Json::Int(1)));
    let base=Map<String,Json>();base.set("count",Json::Int(2));let environment=Map<String,Json>();environment.set("count",Json::Int(3));let arguments=Map<String,Json>();arguments.set("count",Json::Int(4));
    match config.resolve(Json::Object(freeze(base)),Json::Object(freeze(environment)),Json::Object(freeze(arguments)),&fields){Ok(v)=>{assert_eq(json.get(v,"count"),Some(Json::Int(4)));},Err(_)=>{panic("unexpected configuration failure");}}
    let bad=Map<String,Json>();bad.set("unknown-secret-key",Json::Text("secret"));let empty=Map<String,Json>();let object=Json::Object(freeze(empty));
    match config.resolve(Json::Object(freeze(bad)),object,object,&fields){Err(e)=>{assert_eq(e.code,"UnknownField");assert_eq(e.field,"");},Ok(_)=>{panic("expected schema failure");}}
}

test fn configuration_defaults_required_and_types() {
    let empty=Map<String,Json>();let object=Json::Object(freeze(empty));
    let fields=List<config.Field>();fields.add(config.Field("count","Int",false,Json::Int(5)));
    match config.resolve(object,object,object,&fields) {Ok(v)=>{assert_eq(json.get(v,"count"),Some(Json::Int(5)));},Err(_)=>{panic("expected fallback");}}
    let required=List<config.Field>();required.add(config.Field("count","Int",true,Json::Int(5)));
    match config.resolve(object,object,object,&required) {Err(e)=>{assert_eq(e.code,"MissingField");},Ok(_)=>{panic("expected required failure");}}
    let wrong=Map<String,Json>();wrong.set("count",Json::Text("private-value"));
    match config.resolve(Json::Object(freeze(wrong)),object,object,&fields) {Err(e)=>{assert_eq(e.code,"FieldType");assert_eq(e.field,"count");},Ok(_)=>{panic("expected type failure");}}
    fields.add(config.Field("count","Int",false,Json::Int(1)));
    match config.resolve(object,object,object,&fields) {Err(e)=>{assert_eq(e.code,"DuplicateSchema");},Ok(_)=>{panic("expected duplicate failure");}}
    let names=List<String>();names.add("count");let missing=List<String>();missing.add("--count");
    match args.parse(&missing,&names) {Err(e)=>{assert_eq(e.code,"MissingValue");},Ok(_)=>{panic("expected missing value");}}
    let unknown=List<String>();unknown.add("--unknown");unknown.add("secret-value");
    match args.parse(&unknown,&names) {Err(e)=>{assert_eq(e.code,"UnknownOption");},Ok(_)=>{panic("expected unknown option");}}
}

import text as text;
import bytes as bytes;
import number as number;
import bits as bits;
import result as result;
import map as map;
test fn codecs_and_scalar_indices() {
    assert_eq(text.length("a日本"),3);assert_eq(text.slice("a日本",1,3),Ok("日本"));assert_eq(text.find("a日本","本"),Some(2));assert_eq(text.trim("  x\n"),Ok("x"));
    match text.split("a,,b",","){Ok(v)=>{assert_eq(v.len(),3);assert_eq(v.get(1),"");},Err(_)=>{panic("unexpected split");}}
    match text.tokens("  2\t3\n-4 "){Ok(v)=>{assert_eq(v.len(),3);assert_eq(v.get(2),"-4");},Err(_)=>{panic("unexpected tokens");}}
    assert_eq(bytes.decode(Bytes("日本")),Ok("日本"));assert_eq(bytes.encode("日本"),Ok(Bytes("日本")));assert_eq(bytes.get(Bytes("abc"),1),Ok(98));assert_eq(bytes.slice(Bytes("abc"),1,3),Ok(Bytes("bc")));
    assert_eq(number.integer("-ff",16),Ok(-255));assert_eq(number.formatInt(-255,16),Ok("-ff"));assert_eq(number.floating("1.5"),Ok(1.5));assert_eq(number.formatFloat(1.5),Ok("1.5"));
    match number.decimal("9223372036854775808"){Err(e)=>{assert_eq(e.code,"NumberRange");},Ok(_)=>{panic("expected overflow");}}
    assert_eq(bits.and(6,3),2);assert_eq(bits.or(6,3),7);assert_eq(bits.xor(6,3),5);assert_eq(bits.count(-1),64);assert_eq(bits.shiftUnsigned(-1,1),Ok(9223372036854775807));
    match bits.shiftLeft(1,64){Err(e)=>{assert_eq(e.code,"ShiftRange");},Ok(_)=>{panic("expected shift range");}}
    assert_eq(math.mulMod(9223372036854775807,9223372036854775807,1000000007),Ok(737564071));
}
test fn folds_maps_and_result_branches() {
    let values=List<Int>();values.add(1);values.add(2);values.add(3);
    assert_eq(collections.fold(&values,0,|a:Int,b:Int|->Int{return a+b;}),6);assert_eq(collections.find(&values,|n:Int|->Bool{return n>1;}),Some(2));assert_eq(collections.count(&values,|n:Int|->Bool{return n>1;}),2);
    let lookup=Map<Int,String>();lookup.set(1,"one");assert_eq(map.getOr(&lookup,1,"none"),"one");assert_eq(map.getOr(&lookup,2,"none"),"none");assert(map.contains(&lookup,1));
    let good:Result<Int,String>=Ok(3);let bad:Result<Int,String>=Err("failed");
    assert_eq(result.valueOr(good,0),3);assert_eq(result.valueOr(bad,0),0);
    assert_eq(result.map(good,|n:Int|->Int{return n*2;}),Ok(6));assert_eq(result.map(bad,|n:Int|->Int{return n*2;}),Err("failed"));
    assert_eq(result.mapError(good,|s:String|->String{return "mapped";}),Ok(3));assert_eq(result.mapError(bad,|s:String|->String{return "mapped";}),Err("mapped"));
}

import search as search;
import sequence as sequence;
import heap as heap;
import deque.{create as createDeque,pushBack,pushFront,popFront,popBack,length as dequeLength};
import disjointSet as disjointSet;
import integer as integer;
import modular as modular;
test fn sorting_sequences_and_heap() {
 let cmp=|a:Int,b:Int|->Int{if a<b{return -1;}if a>b{return 1;}return 0;};let values=List<Int>();values.add(3);values.add(1);values.add(1);values.add(2);
 let sorted=sort.stable(&values,cmp);assert_eq(sorted.get(0),1);assert_eq(sorted.get(3),3);assert_eq(search.lowerBound(&sorted,1,cmp),0);assert_eq(search.upperBound(&sorted,1,cmp),2);assert_eq(search.binary(&sorted,5,cmp),None);
 sort.inPlace(&mut values,cmp);sequence.reverse(&mut values);assert_eq(values.get(0),3);let rotated=sequence.rotate(&values,-1);assert_eq(rotated.get(0),1);let distinct=sequence.compressed(&values);assert_eq(distinct.len(),3);
 let h=List<Int>();assert_eq(heap.push(&mut h,3,4,cmp),Ok(()));assert_eq(heap.push(&mut h,1,4,cmp),Ok(()));assert_eq(heap.push(&mut h,2,4,cmp),Ok(()));assert_eq(heap.pop(&mut h,cmp),Some(1));assert_eq(heap.pop(&mut h,cmp),Some(2));assert_eq(heap.pop(&mut h,cmp),Some(3));assert_eq(heap.pop(&mut h,cmp),None);
}
test fn deque_dsu_and_number_theory(){
 match createDeque<Int>(3){Ok(d)=>{assert_eq(pushBack(&mut d,2),Ok(()));assert_eq(pushFront(&mut d,1),Ok(()));assert_eq(popFront(&mut d),Some(1));assert_eq(popBack(&mut d),Some(2));assert_eq(dequeLength(&d),0);},Err(_)=>{panic("deque");}}
 match disjointSet.create(4){Ok(d)=>{assert_eq(disjointSet.unite(&mut d,1,2),Ok(true));assert_eq(disjointSet.same(&mut d,1,2),Ok(true));assert_eq(disjointSet.size(&mut d,1),Ok(2));},Err(_)=>{panic("dsu");}}
 assert_eq(integer.gcd(-24,18),Ok(6));assert_eq(integer.gcd(-9223372036854775807-1,2),Ok(2));assert_eq(integer.lcm(6,8),Ok(24));assert_eq(integer.combination(10,3),Ok(120));assert_eq(integer.multiply(-1,-9223372036854775807-1),Err("Overflow"));assert_eq(modular.power(2,10,1000),Ok(24));assert_eq(modular.inverse(3,11),Ok(4));assert_eq(modular.inverse(2,4),Err("NonInvertible"));
}
import fenwick as fenwick;
import graph as graph;
test fn ranges_and_graphs(){
 match fenwick.create(4){Ok(t)=>{assert_eq(fenwick.add(&mut t,0,2),Ok(()));assert_eq(fenwick.add(&mut t,2,5),Ok(()));assert_eq(fenwick.range(&t,0,3),Ok(7));assert_eq(fenwick.range(&t,1,3),Ok(5));},Err(_)=>{panic("fenwick");}}
 let xs=List<String>();xs.add("a");xs.add("b");xs.add("c");let combine=|a:String,b:String|->String{return a+b;};
 match segment.build(&xs,"",combine){Ok(t)=>{assert_eq(segment.query(&t,0,3,combine),Ok("abc"));assert_eq(segment.set(&mut t,1,"B",combine),Ok(()));assert_eq(segment.query(&t,1,3,combine),Ok("Bc"));},Err(_)=>{panic("segment");}}
 match graph.create(4,4){Ok(g)=>{assert_eq(graph.add(&mut g,0,1,4),Ok(()));assert_eq(graph.add(&mut g,0,2,1),Ok(()));assert_eq(graph.add(&mut g,2,1,1),Ok(()));match graph.bfs(&g,0){Ok(d)=>{assert_eq(d.get(1),1);assert_eq(d.get(3),-1);},Err(_)=>{panic("bfs");}}match graph.dijkstra(&g,0){Ok(d)=>{assert_eq(d.get(1),Some(2));assert_eq(d.get(3),None);},Err(_)=>{panic("dijkstra");}}},Err(_)=>{panic("graph");}}
}
import scanner as scanner;
test fn bounded_byte_scanner(){match scanner.fromBytes(Bytes(" 12 -9223372036854775808\t+3 ")){Ok(s)=>{assert_eq(scanner.nextInt(&mut s),Ok(Some(12)));assert_eq(scanner.nextInt(&mut s),Ok(Some(-9223372036854775807-1)));assert_eq(scanner.nextInt(&mut s),Ok(Some(3)));assert_eq(scanner.nextInt(&mut s),Ok(None));},Err(_)=>{panic("scanner");}}}
import path as path;
test fn option_schema_paths_and_map_adapters(){
 let schema=List<args.OptionSpec>();schema.add(args.OptionSpec("verbose","v",false,false));schema.add(args.OptionSpec("count","c",true,true));let input=List<String>();input.add("-v");input.add("--count");input.add("4");match args.parseOptions(&input,&schema){Ok(v)=>{assert_eq(v.get("verbose"),Some("true"));assert_eq(v.get("count"),Some("4"));},Err(_)=>{panic("options");}}
 assert_eq(path.join("data","state.json"),Ok("data/state.json"));assert_eq(path.relative("../key"),Err("InvalidPath"));
 let lookup=Map<String,Int>();lookup.set("a",2);map.update(&mut lookup,"a",|v:Option<Int>|->Option<Int>{match v{Some(n)=>{return Some(n+1);},None=>{return Some(0);}}});assert_eq(lookup.get("a"),Some(3));let entries=map.entries(&lookup);assert_eq(entries.len(),1);assert_eq(entries.get(0)._0,"a");
}

test fn streaming_chunk_boundaries() {
 match stdEncode("-9223372036854775808 42"){Ok(bytes)=>{match stream.tokens(32){Ok(tokens)=>{var i=0;while i<stdBytesLength(bytes){match stdBytesSlice(bytes,i,i+1){Ok(chunk)=>{assert_eq(stream.feed(&mut tokens,chunk,false),Ok(()));},Err(_)=>{panic("slice");}}i+=1;}match stdEncode(""){Ok(empty)=>{assert_eq(stream.feed(&mut tokens,empty,true),Ok(()));},Err(_)=>{panic("encode");}}assert_eq(stream.nextInt(&mut tokens),Ok(Some(-9223372036854775807-1)));assert_eq(stream.nextInt(&mut tokens),Ok(Some(42)));assert_eq(stream.nextInt(&mut tokens),Ok(None));},Err(_)=>{panic("tokens");}}},Err(_)=>{panic("encode");}}
 let decoder=stream.utf8();match stdEncode("あ"){Ok(bytes)=>{var i=0;while i<3{match stdBytesSlice(bytes,i,i+1){Ok(chunk)=>{let result=stream.decode(&mut decoder,chunk,i==2);if i<2{assert_eq(result,Ok(""));}else{assert_eq(result,Ok("あ"));}},Err(_)=>{panic("slice");}}i+=1;}},Err(_)=>{panic("encode");}}
}

test fn exact_search_and_bitset()->Unit effects {} {
 match stdEncode("abababa"){Ok(input)=>{match stdEncode("aba"){Ok(pattern)=>{match stringSearch.kmp(input,pattern){Ok(found)=>{assert_eq(found.len(),3);assert_eq(found.get(2),4);},Err(_)=>{panic("search");}}},Err(_)=>{panic("encode");}}},Err(_)=>{panic("encode");}}
 match bitset.create(65){Ok(set)=>{bitset.set(&mut set,63,true);assert_eq(bitset.count(&set),1);},Err(_)=>{panic("bitset");}}
}

test fn graph_components_and_forest()->Unit effects {} {match graph.create(3,3){Ok(g)=>{graph.add(&mut g,0,1,2);graph.add(&mut g,1,0,2);graph.add(&mut g,1,2,1);match graph.components(&g){Ok(ids)=>{assert_eq(ids.get(0),ids.get(1));assert(ids.get(1)!=ids.get(2));},Err(_)=>{panic("scc");}}match graph.minimumForest(&g){Ok(f)=>{assert_eq(f.weight,3);},Err(_)=>{panic("forest");}}},Err(_)=>{panic("graph");}}}

test fn csv_roundtrip_and_dynamic_programming()->Unit effects {} {match stdEncode("a,b\n"){Ok(input)=>{match csv.parse(input){Ok(table)=>{assert_eq(csv.get(&table,0,1),Ok("b"));match csv.format(&table){Ok(output)=>{match csv.parse(output){Ok(copy)=>{assert_eq(csv.rows(&copy),1);},Err(_)=>{panic("csv");}}},Err(_)=>{panic("format");}}},Err(_)=>{panic("csv");}}},Err(_)=>{panic("encode");}}let values=List<Int>();values.add(2);values.add(1);values.add(3);assert_eq(dp.lisLength(&values),Ok(2));}

test fn fallible_callbacks_leave_originals_unchanged()->Unit effects {} {
 let values=List<Int>();values.add(3);values.add(1);values.add(2);
 assert_eq(sort.tryStable(&values,|a:Int,b:Int|->Result<Int,String>{return Err("Compare");}),Err("Compare"));assert_eq(values.get(0),3);
 match sort.tryStable(&values,|a:Int,b:Int|->Result<Int,String>{if a<b{return Ok(-1);}if a>b{return Ok(1);}return Ok(0);}){Ok(sorted)=>{assert_eq(sorted.get(0),1);assert_eq(sorted.get(2),3);},Err(_)=>{panic("sort");}}
 match segment.build(&values,0,|a:Int,b:Int|->Int{return a+b;}){Err(_)=>{panic("tree");},Ok(tree)=>{
 assert_eq(segment.tryUpdated(&tree,1,9,"Range",|a:Int,b:Int|->Result<Int,String>{return Err("Combine");}),Err("Combine"));
 assert_eq(segment.query(&tree,0,3,|a:Int,b:Int|->Int{return a+b;}),Ok(6));
 match segment.tryUpdated(&tree,1,9,"Range",|a:Int,b:Int|->Result<Int,String>{return Ok(a+b);}){Err(_)=>{panic("update");},Ok(updated)=>{assert_eq(segment.query(&updated,0,3,|a:Int,b:Int|->Int{return a+b;}),Ok(14));assert_eq(segment.query(&tree,0,3,|a:Int,b:Int|->Int{return a+b;}),Ok(6));}}
 }}
 let converted=error.fromStd(StdError("Range",7),"input");assert_eq(converted.code,"Range");assert_eq(converted.offset,7);assert_eq(converted.source,"input");
}

import gui as gui;
test fn gui_controls_hit_testing_focus_and_validation() {
 match gui.window("test",320,200) {Err(_)=>{panic("window");},Ok(view)=>{
 assert_eq(gui.button(&mut view,"add","Add",10,10,100,30),Ok(()));
 assert_eq(gui.checkbox(&mut view,"check","Enabled",false,10,50,100,30),Ok(()));
 assert_eq(gui.button(&mut view,"add","duplicate",10,90,100,30),Err(StdError("GuiDuplicateId",0)));
 assert_eq(gui.rectangle(&mut view,"bad",310,0,20,20,0),Err(StdError("GuiInvalidBounds",0)));
 assert_eq(gui.background(&mut view,0x1000000),Err(StdError("GuiInvalidColor",0)));
 assert_eq(gui.dispatch(&mut view,gui.Event("pointer",10,10,"",0,0)),Some(gui.Action::Activate("add")));
 assert_eq(gui.dispatch(&mut view,gui.Event("pointer",110,10,"",0,0)),None);
 assert_eq(gui.dispatch(&mut view,gui.Event("key",0,0,"Tab",0,0)),None);
 assert_eq(gui.dispatch(&mut view,gui.Event("key",0,0,"Space",0,0)),Some(gui.Action::Changed("check",true)));
 assert_eq(gui.checked(&view,"check"),Ok(true));
 assert_eq(gui.setEnabled(&mut view,"check",false),Ok(()));
 assert_eq(gui.dispatch(&mut view,gui.Event("pointer",20,60,"",0,0)),None);
 assert_eq(gui.dispatch(&mut view,gui.Event("close",0,0,"",0,0)),Some(gui.Action::Close));
 assert_eq(gui.setText(&mut view,"add","hello"),Ok(()));assert_eq(gui.text(&view,"add"),Ok("hello"));
 match gui.scene(&view){Ok(value)=>{match json.parse(value){Ok(_)=>{},Err(_)=>{panic("scene JSON");}}},Err(_)=>{panic("scene");}}
 }}
 assert_eq(gui.window("bad",63,200),Err(StdError("GuiInvalidSize",0)));
}

test fn gui_unicode_editing_layout_and_selection() {
 match gui.window("edit",320,240){Err(e)=>{panic(e.code);},Ok(view)=>{
 assert_eq(gui.textArea(&mut view,"body","a😀界",10,10,200,120),Ok(()));
 assert_eq(gui.setSelection(&mut view,"body",3,1),Ok(()));
 assert_eq(gui.edit(&mut view,"body",gui.Event("text",0,0,"日本語",0,0)),Ok(()));
 assert_eq(gui.text(&view,"body"),Ok("a日本語"));assert_eq(gui.selection(&view,"body"),Ok((4,4)));
 assert_eq(gui.edit(&mut view,"body",gui.Event("key",0,0,"Backspace",0,0)),Ok(()));assert_eq(gui.text(&view,"body"),Ok("a日本"));
 assert_eq(gui.button(&mut view,"save","Save",10,160,90,40),Ok(()));
 let ids=List<String>();ids.add("body");ids.add("save");assert_eq(gui.arrange(&mut view,&ids,gui.Rect(10,10,300,220),1,10),Ok(()));
 ids.add("missing");assert_eq(gui.arrange(&mut view,&ids,gui.Rect(10,10,300,220),1,10),Err(StdError("GuiUnknownId",0)));
 assert_eq(gui.setSelection(&mut view,"body",99,0),Err(StdError("GuiInvalidSelection",0)));
 assert_eq(gui.textBox(&mut view,"single","a\nb",0,0,100,20),Err(StdError("GuiSingleLine",0)));
 }}
}

test fn residual_flow_and_matching_contracts() {
 match flow.create(3,3) {Err(e)=>{panic(e);},Ok(network)=>{
 assert_eq(flow.add(&mut network,0,1,4),Ok(0));assert_eq(flow.add(&mut network,1,2,3),Ok(1));assert_eq(flow.add(&mut network,0,2,2),Ok(2));
 assert_eq(flow.augment(&mut network,0,2,2),Ok(2));assert_eq(flow.augment(&mut network,0,2,99),Ok(3));assert_eq(flow.augment(&mut network,0,2,99),Ok(0));
 match flow.reachable(&network,0){Err(e)=>{panic(e);},Ok(seen)=>{assert_eq(seen.get(0),true);assert_eq(seen.get(2),false);}}
 }}
 let pairs=List<Tuple<Int,Int>>();pairs.push((0,0));pairs.push((0,1));pairs.push((1,0));
 match matching.maximum(2,2,&pairs) {Err(e)=>{panic(e);},Ok(result)=>{assert_eq(result.size,2);assert_eq(result.left.get(0),Some(1));assert_eq(result.left.get(1),Some(0));}}
}

test fn gui_grapheme_selection_mode_and_legacy_compatibility() {
 match gui.window("clusters",320,200){Err(e)=>{panic(e.code);},Ok(view)=>{
 assert_eq(gui.textBox(&mut view,"body","é👩‍💻",10,10,200,30),Ok(()));
 assert_eq(gui.setSelection(&mut view,"body",1,1),Ok(()));
 assert_eq(gui.graphemeEditing(&mut view,true),Ok(()));
 assert_eq(gui.selection(&view,"body"),Ok((2,2)));
 assert_eq(gui.setSelection(&mut view,"body",1,1),Err(StdError("GuiInvalidSelection",0)));
 assert_eq(gui.setSelection(&mut view,"body",5,5),Ok(()));
 assert_eq(gui.edit(&mut view,"body",gui.Event("key",0,0,"Backspace",0,0)),Ok(()));
 assert_eq(gui.text(&view,"body"),Ok("é"));
 assert_eq(gui.graphemeEditing(&mut view,false),Ok(()));
 assert_eq(gui.edit(&mut view,"body",gui.Event("key",0,0,"Backspace",0,0)),Ok(()));
 assert_eq(gui.text(&view,"body"),Ok("e"));
 }}
}

import lazySegment as lazySegment;
import trie as trie;
import suffix as suffix;
import geometry as geometry;
fn lazySum(a:Int,b:Int)->Int effects {} {return a+b;}
fn lazyApply(a:Int,b:Int,n:Int)->Int effects {} {return a+b*n;}
fn lazyCompose(a:Int,b:Int)->Int effects {} {return a+b;}
test fn lazy_range_contract() {
 let input=List<Int>();for i in 0..7{input.add(i);}
 match lazySegment.build<Int,Int>(&input,0,lazySum){Err(e)=>{panic(e);},Ok(tree)=>{
 assert_eq(lazySegment.update(&mut tree,1,5,2,lazySum,lazyApply,lazyCompose),Ok(()));
 assert_eq(lazySegment.query(&mut tree,0,7,lazySum,lazyApply,lazyCompose),Ok(29));
 assert_eq(lazySegment.query(&mut tree,2,4,lazySum,lazyApply,lazyCompose),Ok(9));
 assert_eq(lazySegment.update(&mut tree,0,8,1,lazySum,lazyApply,lazyCompose),Err("Range"));
 }}
}
test fn trie_reusable_capacity_contract() {
 match trie.createText<Int>(5){Err(e)=>{panic(e);},Ok(words)=>{
 assert_eq(trie.textInsert(&mut words,"abcd",3),Ok(None));
 assert_eq(trie.textInsert(&mut words,"z",4),Err("Capacity"));
 assert_eq(trie.textPrefixCount(&words,"ab"),Ok(1));
 assert_eq(trie.textRemove(&mut words,"abcd"),Ok(Some(3)));
 assert_eq(trie.textNodes(&words),1);
 assert_eq(trie.textInsert(&mut words,"zyx",4),Ok(None));
 }}
}
test fn native_suffix_contract() {
 match stdEncode("banana"){Err(e)=>{panic(e.code);},Ok(input)=>{
 match suffix.build(input){Err(e)=>{panic(e.code);},Ok(index)=>{
 let sa=suffix.order(&index);let lcp=suffix.lcp(&index);
 match numeric.valuesInt(&sa){Err(e)=>{panic(e.code);},Ok(values)=>{assert_eq(values.get(0),5);}}
 match numeric.valuesInt(&lcp){Err(e)=>{panic(e.code);},Ok(values)=>{assert_eq(values.get(2),3);}}
 match stdEncode("ana"){Err(e)=>{panic(e.code);},Ok(pattern)=>{assert_eq(suffix.find(&index,pattern),Ok((1,3)));}}
 }}
 }}
}
test fn exact_geometry_contract() {
 let lo=(-9223372036854775807-1);let hi=9223372036854775807;
 assert_eq(geometry.orientation(geometry.Point(lo,lo),geometry.Point(hi,lo),geometry.Point(lo,hi)),Ok(1));
 assert_eq(geometry.onSegment(geometry.Point(1,0),geometry.Point(0,0),geometry.Point(2,0)),Ok(true));
 assert_eq(geometry.orientationFloat(geometry.Vector(0.0,0.0),geometry.Vector(1.0,0.0),geometry.Vector(1.0,0.001),0.01),Ok(0));
}

import numericAsync as numericAsync;
import task as task;
test fn cooperative_empty_dot_contract()->Unit effects {tasks} {
 let shape=List<Int>();shape.add(0);
 match numeric.zerosFloat(&shape){Err(e)=>{panic(e.code);},Ok(empty)=>{
 let work=spawn numericAsync.dot(empty,empty);assert_eq(await work,Ok(Ok(0.0)));
 }}
 task.yieldNow();
}
test fn cooperative_numeric_domain_is_inner_result()->Unit effects {tasks} {
 let shape=List<Int>();shape.add(2);shape.add(3);
 match numeric.zerosFloat(&shape){Err(e)=>{panic(e.code);},Ok(matrix)=>{
 let work=spawn numericAsync.matmul(matrix,matrix);assert_eq(await work,Ok(Err(StdError("NumericShape",0))));
 }}
}

import guiForm as guiForm;
import guiTable as guiTable;
test fn form_and_empty_table_contracts() {
 let defs=List<guiForm.Field>();defs.add(guiForm.Field("age","Age",guiForm.Kind::Integer(0,150),true,16,"-"));
 match guiForm.create(&defs,1){Err(_)=>{panic("form creation");},Ok(model)=>{
  assert(!guiForm.validate(&mut model));assert_eq(guiForm.value(&model,"age"),Ok("-"));assert_eq(guiForm.setValue(&mut model,"age","13"),Ok(()));assert(guiForm.validate(&mut model));
  match guiForm.toJson(&model){Err(_)=>{panic("typed form");},Ok(data)=>{assert_eq(jsonGet(data,"age"),Some(Json::Int(13)));}}
 }}
 let headings=List<String>();headings.add("Value");let cells=List<String>();
 match guiTable.create(freeze(headings),freeze(cells),4){Err(_)=>{panic("empty table");},Ok(table)=>{assert_eq(guiTable.rows(&table),0);guiTable.scroll(&mut table,9223372036854775807);assert_eq(guiTable.position(&table),0);assert_eq(guiTable.selection(&table),None);}}
}

import fft as fft;
import sparse as sparse;
fn transformTake<T,E>(result:Result<T,E>)->T effects {} {match move result {Ok(value)=>{return move value;},Err(_)=>{panic("numeric contract");}}}
test fn sparse_and_transform_contracts() {
 let shape=List<Int>();shape.add(1);let zero=transformTake(numeric.zerosFloat(&shape));
 assert_eq(numeric.norm2(&zero),Ok(0.0));
 let spectrum=transformTake(fft.transform(&zero,&zero,false));
 assert_eq(numeric.norm2(&spectrum.real),Ok(0.0));assert_eq(numeric.norm2(&spectrum.imag),Ok(0.0));
 let emptyShape=List<Int>();emptyShape.add(0);let indices=transformTake(numeric.zerosInt(&emptyShape));let values=transformTake(numeric.zerosFloat(&emptyShape));
 let matrix=transformTake(sparse.create(1,1,&indices,&indices,&values));let result=transformTake(sparse.matvec(&matrix,&zero));
 assert_eq(numeric.norm2(&result),Ok(0.0));
}

import autodiff as autodiff;
import optimize as optimize;
import models as models;
test fn native_gradient_optimizer_model_contracts() {
 let shape=List<Int>();shape.add(1);let data=List<Float>();data.add(2.0);let parameter=transformTake(numeric.fromFloat(&shape,&data));
 var tape=autodiff.create();let node=transformTake(autodiff.parameter(&mut tape,"x",parameter));let square=transformTake(autodiff.unary(&mut tape,"square",node));let loss=transformTake(autodiff.mean(&mut tape,square));let derivatives=transformTake(autodiff.backward(&tape,loss));
 let gradient=Map<String,FloatArray>();match transformTake(autodiff.gradient(&derivatives,node)){Some(value)=>{assert_eq(numeric.sum(&value),Ok(4.0));gradient.set("x",value);},None=>{panic("gradient");}}
 let weights=Map<String,FloatArray>();weights.set("x",parameter);let updated=transformTake(optimize.sgd(&weights,&gradient,0.25));
 let model=transformTake(models.create(move updated));let bytes=transformTake(models.encode(&model));let restored=transformTake(models.decode(bytes));match models.get(&restored,"x"){Some(array)=>{assert_eq(numeric.sum(&array),Ok(1.0));},None=>{panic("model weight");}}
}

async fn readyNumber()->Int effects {tasks} {task.yieldNow();return 42;}
async fn readyText()->String effects {} {return "ready";}
test fn heterogeneous_task_readiness() {
 let left=readyNumber();let right=readyText();assert_eq(await task.selectReady(left,right),Ok(1));
 assert_eq(await right,Ok("ready"));assert_eq(await left,Ok(42));
}

import snapshot as snapshot;
import history as history;
import history.{create as createHistory,HistoryError};

test fn data_snapshot_isolates_capture_and_forks()->Unit effects {} {
    let values=List<Int>();values.add(10);
    let first=snapshot.capture(&values);
    values.set(0,99);
    let second=snapshot.capture(&values);
    let old=snapshot.read(first);let latest=snapshot.read(second);
    assert_eq(old.get(0),10);assert_eq(latest.get(0),99);
    let left=snapshot.fork(first);let right=snapshot.fork(first);
    left.set(0,7);right.add(20);
    assert_eq(left.len(),1);assert_eq(right.get(0),10);
    assert_eq(right.len(),2);assert_eq(old.len(),1);assert_eq(values.get(0),99);
    let scalar=42;assert_eq(snapshot.fork(snapshot.capture(&scalar)),42);
}

test fn named_data_history_preserves_removed_and_reused_roots()->Unit effects {} {
    match createHistory<List<Int>>(2) {
        Ok(versions)=>{
            let values=List<Int>();values.add(10);
            assert_eq(history.save(&mut versions,"initial",&values),Ok(()));
            values.set(0,99);
            assert_eq(history.save(&mut versions,"latest",&values),Ok(()));
            assert_eq(history.length(&versions),2);
            match history.get(&versions,"initial") {
                Some(saved)=>{
                    assert_eq(history.save(&mut versions,"initial",&values),Err(HistoryError::DuplicateName));
                    assert_eq(history.save(&mut versions,"overflow",&values),Err(HistoryError::Capacity));
                    match history.remove(&mut versions,"initial") {
                        Some(removed)=>{assert_eq(snapshot.read(removed).get(0),10);},
                        None=>{panic("missing registered version");}
                    }
                    assert_eq(history.length(&versions),1);
                    assert_eq(history.save(&mut versions,"initial",&values),Ok(()));
                    assert_eq(snapshot.read(saved).get(0),10);
                    match history.get(&versions,"initial") {
                        Some(reused)=>{assert_eq(snapshot.read(reused).get(0),99);},
                        None=>{panic("missing replacement");}
                    }
                    history.clear(&mut versions);
                    assert_eq(history.length(&versions),0);
                    let fork=snapshot.fork(saved);fork.set(0,5);
                    assert_eq(snapshot.read(saved).get(0),10);
                },
                None=>{panic("missing initial version");}
            }
            assert(!history.contains(&versions,"initial"));
            match history.get(&versions,"missing") {None=>{},Some(_)=>{panic("unexpected version");}}
            match history.remove(&mut versions,"missing") {None=>{},Some(_)=>{panic("unexpected removed version");}}
        },
        Err(_)=>{panic("history setup");}
    }
}

test fn data_history_validates_before_mutating_and_lists_names()->Unit effects {} {
    match createHistory<Int>(0) {Err(e)=>{assert_eq(e,HistoryError::InvalidCapacity);},Ok(_)=>{panic("capacity accepted");}}
    match createHistory<Int>(65537) {Err(e)=>{assert_eq(e,HistoryError::InvalidCapacity);},Ok(_)=>{panic("capacity accepted");}}
    match createHistory<Int>(3) {
        Ok(versions)=>{
            let value=1;
            assert_eq(history.save(&mut versions,"",&value),Err(HistoryError::InvalidName));
            var name="";for i in 0..128 {name=name+"界";}
            assert_eq(history.save(&mut versions,name+"界",&value),Err(HistoryError::InvalidName));
            assert_eq(history.length(&versions),0);
            assert_eq(history.save(&mut versions,name,&value),Ok(()));
            assert_eq(history.save(&mut versions,"z",&value),Ok(()));
            assert_eq(history.save(&mut versions,"a",&value),Ok(()));
            let listed=history.names(&versions);
            assert_eq(listed.len(),3);assert_eq(listed.get(0),"a");assert_eq(listed.get(1),"z");assert_eq(listed.get(2),name);
            listed.add("detached");
            assert_eq(history.length(&versions),3);
        },
        Err(_)=>{panic("history setup");}
    }
}

import timeline as timeline;
import timeline.{create as createTimeline,TimelineError};

test fn timeline_wraps_truncates_and_keeps_detached_snapshots()->Unit effects {} {
    let value=10;
    match createTimeline(&value,3) {
        Ok(line)=>{
            let original=timeline.current(&line);
            for n in 11..15 {timeline.push(&mut line,&n);}
            assert_eq(timeline.length(&line),3);
            assert_eq(timeline.position(&line),2);
            match timeline.get(&line,0) {Some(v)=>{assert_eq(snapshot.fork(v),12);},None=>{panic("missing oldest");}}
            match timeline.undo(&mut line) {Some(v)=>{assert_eq(snapshot.fork(v),13);},None=>{panic("undo");}}
            let replacement=99;timeline.push(&mut line,&replacement);
            assert(!timeline.canRedo(&line));
            assert_eq(snapshot.fork(timeline.current(&line)),99);
            assert_eq(snapshot.fork(original),10);
            match timeline.seek(&mut line,-1) {Err(e)=>{assert_eq(e,TimelineError::Index);},Ok(_)=>{panic("negative index");}}
            assert_eq(timeline.position(&line),2);
            timeline.clear(&mut line);
            assert_eq(timeline.length(&line),1);
            assert(!timeline.canUndo(&line));
            assert_eq(snapshot.fork(timeline.current(&line)),99);
        },
        Err(_)=>{panic("timeline setup");}
    }
}

test fn timeline_capacity_one_and_redo_boundaries()->Unit effects {} {
    let value=1;
    match createTimeline(&value,0) {Err(e)=>{assert_eq(e,TimelineError::InvalidCapacity);},Ok(_)=>{panic("capacity");}}
    match createTimeline(&value,65537) {Err(e)=>{assert_eq(e,TimelineError::InvalidCapacity);},Ok(_)=>{panic("capacity");}}
    match createTimeline(&value,1) {
        Ok(line)=>{
            let two=2;timeline.push(&mut line,&two);
            assert_eq(timeline.length(&line),1);
            assert_eq(snapshot.fork(timeline.current(&line)),2);
            match timeline.undo(&mut line) {None=>{},Some(_)=>{panic("undo past start");}}
            match timeline.redo(&mut line) {None=>{},Some(_)=>{panic("redo past end");}}
        },
        Err(_)=>{panic("timeline setup");}
    }
    match createTimeline(&value,2) {
        Ok(line)=>{
            let two=2;timeline.push(&mut line,&two);
            timeline.undo(&mut line);
            match timeline.redo(&mut line) {Some(v)=>{assert_eq(snapshot.fork(v),2);},None=>{panic("redo");}}
        },
        Err(_)=>{panic("timeline setup");}
    }
}

import changes as changes;
import changes.{Change};

test fn changes_apply_inverse_preserve_unrelated_keys_and_reject_conflict()->Unit effects {} {
    let same=|a:Int,b:Int|->Bool{return a==b;};
    let before=Map<String,Int>();before.set("a",1);before.set("b",2);
    let after=Map<String,Int>();after.set("a",3);after.set("c",4);
    match changes.diff(&before,&after,same) {
        Ok(patch)=>{
            assert_eq(changes.length(patch),3);
            before.set("unrelated",9);
            match changes.apply(&before,patch,same) {
                Ok(result)=>{
                    assert_eq(result.get("a"),Some(3));assert_eq(result.get("b"),None);
                    assert_eq(result.get("c"),Some(4));assert_eq(result.get("unrelated"),Some(9));
                    match changes.apply(&result,changes.inverse(patch),same) {
                        Ok(restored)=>{assert_eq(restored.get("a"),Some(1));assert_eq(restored.get("b"),Some(2));assert_eq(restored.get("c"),None);},
                        Err(_)=>{panic("inverse failed");}
                    }
                },
                Err(_)=>{panic("apply failed");}
            }
            before.set("b",8);
            match changes.apply(&before,patch,same) {Err(e)=>{assert_eq(e.code,"Conflict");assert_eq(e.key,"b");},Ok(_)=>{panic("conflict accepted");}}
            assert_eq(before.get("a"),Some(1));assert_eq(before.get("b"),Some(8));
        },
        Err(_)=>{panic("diff failed");}
    }
}

test fn changes_compose_cancel_and_validate_duplicate_keys()->Unit effects {} {
    let same=|a:Int,b:Int|->Bool{return a==b;};
    let first=List<Change<Int>>();first.add(Change<Int>("x",None,Some(1)));
    let second=List<Change<Int>>();second.add(Change<Int>("x",Some(1),None));
    match changes.fromChanges(&first,same) {
        Ok(a)=>{match changes.fromChanges(&second,same) {
            Ok(b)=>{match changes.compose(a,b,same) {Ok(p)=>{assert_eq(changes.length(p),0);},Err(_)=>{panic("compose failed");}}},
            Err(_)=>{panic("second patch");}
        }},
        Err(_)=>{panic("first patch");}
    }
    first.add(Change<Int>("x",Some(1),Some(2)));
    match changes.fromChanges(&first,same) {Err(e)=>{assert_eq(e.code,"DuplicateKey");},Ok(_)=>{panic("duplicate accepted");}}
}

test fn changes_three_way_merge_detects_incompatible_edits()->Unit effects {} {
    let same=|a:Int,b:Int|->Bool{return a==b;};
    let base=Map<String,Int>();base.set("a",1);base.set("b",2);
    let left=Map<String,Int>();left.set("a",3);left.set("b",2);
    let right=Map<String,Int>();right.set("a",1);right.set("b",4);
    match changes.merge(&base,&left,&right,same) {
        Ok(merged)=>{assert_eq(merged.get("a"),Some(3));assert_eq(merged.get("b"),Some(4));},
        Err(_)=>{panic("independent edits");}
    }
    right.set("a",5);
    match changes.merge(&base,&left,&right,same) {Err(e)=>{assert_eq(e.code,"Conflict");assert_eq(e.key,"a");},Ok(_)=>{panic("conflict accepted");}}
    right.set("a",3);
    match changes.merge(&base,&left,&right,same) {Ok(merged)=>{assert_eq(merged.get("a"),Some(3));},Err(_)=>{panic("same edit");}}
    assert_eq(base.get("a"),Some(1));assert_eq(left.get("b"),Some(2));
}

import historyGraph as historyGraph;
import historyGraph.{create as createGraph,Annotation};

test fn history_graph_separates_data_parents_heads_and_annotations()->Unit effects {} {
    match createGraph<Int>(8) {
        Ok(graph)=>{
            let empty=List<String>();let base=10;
            match historyGraph.add(&mut graph,"base",&empty,&base) {
                Ok(original)=>{
                    let parents=List<String>();parents.add("base");
                    let left=20;let right=30;
                    historyGraph.add(&mut graph,"left",&parents,&left);
                    historyGraph.add(&mut graph,"right",&parents,&right);
                    let both=List<String>();both.add("left");both.add("right");let merged=40;
                    historyGraph.add(&mut graph,"merged",&both,&merged);
                    assert_eq(historyGraph.length(&graph),4);
                    assert_eq(historyGraph.isAncestor(&graph,"base","merged"),Ok(true));
                    assert_eq(historyGraph.isAncestor(&graph,"left","right"),Ok(false));
                    assert_eq(historyGraph.isAncestor(&graph,"left","left"),Ok(true));
                    assert_eq(historyGraph.setHead(&mut graph,"main","base"),Ok(()));
                    assert_eq(historyGraph.setHead(&mut graph,"main","left"),Ok(()));
                    match historyGraph.head(&graph,"main") {
                        Some(v)=>{assert_eq(historyGraph.fork(v),20);},
                        None=>{panic("head");}
                    }
                    assert_eq(historyGraph.fork(original),10);
                    assert_eq(historyGraph.annotate(&mut graph,"base",Annotation("initial","tester")),Ok(()));
                    match historyGraph.annotation(&graph,"base") {Some(note)=>{assert_eq(note.description,"initial");},None=>{panic("annotation");}}
                    assert_eq(historyGraph.fork(original),10);
                    let found=historyGraph.matching(&graph,|v:Frozen<Int>|->Bool{return thaw(v)>=20;});
                    assert_eq(found.len(),3);
                    assert(historyGraph.dropHead(&mut graph,"main"));
                    assert(!historyGraph.dropHead(&mut graph,"main"));
                    assert_eq(historyGraph.length(&graph),4);
                },
                Err(_)=>{panic("base");}
            }
        },
        Err(_)=>{panic("graph setup");}
    }
}

test fn history_graph_rejects_invalid_edges_and_names_before_insertion()->Unit effects {} {
    match createGraph<Int>(4) {
        Ok(graph)=>{
            let empty=List<String>();let value=1;
            historyGraph.add(&mut graph,"base",&empty,&value);
            let missing=List<String>();missing.add("missing");
            match historyGraph.add(&mut graph,"bad",&missing,&value) {Err(e)=>{assert_eq(e.code,"UnknownParent");},Ok(_)=>{panic("dangling edge");}}
            let duplicate=List<String>();duplicate.add("base");duplicate.add("base");
            match historyGraph.add(&mut graph,"bad",&duplicate,&value) {Err(e)=>{assert_eq(e.code,"DuplicateParent");},Ok(_)=>{panic("duplicate edge");}}
            match historyGraph.add(&mut graph,"base",&empty,&value) {Err(e)=>{assert_eq(e.code,"DuplicateVersion");},Ok(_)=>{panic("duplicate version");}}
            match historyGraph.setHead(&mut graph,"main","missing") {Err(e)=>{assert_eq(e.code,"UnknownVersion");},Ok(_)=>{panic("dangling head");}}
            assert_eq(historyGraph.length(&graph),1);
            assert_eq(historyGraph.branches(&graph).len(),0);
        },
        Err(_)=>{panic("graph setup");}
    }
}

import parser as parser;
import parser.{pure as parserPure};

test fn parser_choice_tracks_farthest_failure_and_merged_expectations()->Unit effects {} {
    let first=parser.literal(Bytes("ab"),"ab");
    let second=parser.literal(Bytes("ac"),"ac");
    match parser.complete(parser.orElse(first,second),Bytes("ac")) {Ok(value)=>{assert_eq(value,Bytes("ac"));},Err(_)=>{panic("choice");}}
    match parser.complete(parser.orElse(first,second),Bytes("ax")) {
        Err(problem)=>{
            assert_eq(problem.offset,1);assert_eq(problem.expected.len(),2);
            assert_eq(problem.expected.get(0),"ab");assert_eq(problem.expected.get(1),"ac");
        },
        Ok(_)=>{panic("bad prefix accepted");}
    }
    match parser.complete(first,Bytes("abx")) {Err(problem)=>{assert_eq(problem.code,"TrailingInput");assert_eq(problem.offset,2);},Ok(_)=>{panic("trailing input");}}
    let utf=parser.literal(Bytes("日本"),"Japanese word");
    match parser.parse(utf,Bytes("日本!")) {Ok(result)=>{assert_eq(parser.position(result.next),6);assert_eq(parser.remaining(result.next),1);},Err(_)=>{panic("byte offsets");}}
}

test fn parser_cut_prevents_fallback_and_optional_preserves_cursor()->Unit effects {} {
    let committed=parser.cut(parser.literal(Bytes("ab"),"ab"));
    let fallback=parser.literal(Bytes("ac"),"ac");
    match parser.complete(parser.orElse(committed,fallback),Bytes("ac")) {Err(problem)=>{assert(problem.committed);},Ok(_)=>{panic("cut ignored");}}
    let sequence=parser.pair(parser.optional(parser.literal(Bytes("x"),"x")),parser.literal(Bytes("a"),"a"));
    match parser.complete(sequence,Bytes("a")) {Ok(value)=>{assert_eq(value.0,None);assert_eq(value.1,Bytes("a"));},Err(_)=>{panic("optional");}}
}

test fn parser_repeat_is_bounded_and_rejects_empty_success()->Unit effects {} {
    let digit=parser.satisfy("digit",|byte:Int|->Bool{return byte>=48 && byte<=57;});
    match parser.repeat(digit,1,3) {
        Ok(digits)=>{
            match parser.complete(digits,Bytes("123")) {Ok(values)=>{assert_eq(values.len(),3);assert_eq(values.get(0),49);},Err(_)=>{panic("digits");}}
            match parser.complete(digits,Bytes("")) {Err(_)=>{},Ok(_)=>{panic("minimum");}}
            match parser.complete(digits,Bytes("1234")) {Err(problem)=>{assert_eq(problem.code,"TrailingInput");},Ok(_)=>{panic("maximum");}}
        },
        Err(_)=>{panic("repeat setup");}
    }
    match parser.repeat(parserPure<Int>(1),0,4) {
        Ok(empty)=>{match parser.complete(empty,Bytes("")) {Err(problem)=>{assert_eq(problem.code,"NonProgress");},Ok(_)=>{panic("empty repeat");}}},
        Err(_)=>{panic("empty setup");}
    }
}

import orderedMap as orderedMap;
import orderedMap.{create as createOrderedMap,OrderedMapError};

test fn ordered_map_preserves_insertion_order_and_relinks_removals()->Unit effects {} {
    match createOrderedMap<Int>(3) {
        Ok(map)=>{
            assert_eq(orderedMap.put(&mut map,"z",1),Ok(None));
            assert_eq(orderedMap.put(&mut map,"a",2),Ok(None));
            assert_eq(orderedMap.put(&mut map,"m",3),Ok(None));
            assert_eq(orderedMap.put(&mut map,"a",20),Ok(Some(2)));
            assert_eq(orderedMap.put(&mut map,"full",4),Err(OrderedMapError::Capacity));
            let keys=orderedMap.keys(&map);
            assert_eq(keys.get(0),"z");assert_eq(keys.get(1),"a");assert_eq(keys.get(2),"m");
            assert_eq(orderedMap.remove(&mut map,"a"),Some(20));
            assert_eq(orderedMap.put(&mut map,"a",22),Ok(None));
            let changed=orderedMap.keys(&map);
            assert_eq(changed.get(0),"z");assert_eq(changed.get(1),"m");assert_eq(changed.get(2),"a");
            assert_eq(orderedMap.remove(&mut map,"z"),Some(1));
            assert_eq(orderedMap.remove(&mut map,"a"),Some(22));
            assert_eq(orderedMap.remove(&mut map,"m"),Some(3));
            assert_eq(orderedMap.remove(&mut map,"missing"),None);
            assert_eq(orderedMap.length(&map),0);
            orderedMap.put(&mut map,"new",7);
            assert_eq(orderedMap.keys(&map).get(0),"new");
            orderedMap.clear(&mut map);
            assert_eq(orderedMap.keys(&map).len(),0);
        },
        Err(_)=>{panic("ordered map setup");}
    }
}

test fn ordered_map_snapshot_keeps_order_and_values_independent()->Unit effects {} {
    match createOrderedMap<Int>(3) {
        Ok(map)=>{
            orderedMap.put(&mut map,"b",2);orderedMap.put(&mut map,"a",1);
            let saved=snapshot.capture(&map);
            orderedMap.remove(&mut map,"b");orderedMap.put(&mut map,"c",3);
            let old=snapshot.fork(saved);
            let keys=orderedMap.keys(&old);
            assert_eq(keys.get(0),"b");assert_eq(keys.get(1),"a");
            assert_eq(orderedMap.get(&old,"b"),Some(2));
            assert_eq(orderedMap.get(&map,"b"),None);
        },
        Err(_)=>{panic("ordered map setup");}
    }
}

test fn snapshots_and_changes_preserve_frozen_payload_types()->Unit effects {} {
    let a=List<Int>();a.add(10);let b=List<Int>();b.add(20);
    let first=freeze(a);let second=freeze(b);
    let saved=snapshot.capture(&first);
    let again=snapshot.fork(saved);
    assert_eq(thaw(again).get(0),10);
    let old=Map<String,Frozen<List<Int>>>();old.set("x",first);
    let next=Map<String,Frozen<List<Int>>>();next.set("x",second);
    let same=|left:Frozen<List<Int>>,right:Frozen<List<Int>>|->Bool{return left.get(0)==right.get(0);};
    match changes.diff(&old,&next,same) {
        Ok(patch)=>{
            match changes.apply(&old,patch,same) {
                Ok(result)=>{match result.get("x") {Some(value)=>{assert_eq(value.get(0),20);assert_eq(thaw(value).get(0),20);},None=>{panic("missing payload");}}},
                Err(_)=>{panic("apply frozen payload");}
            }
        },
        Err(_)=>{panic("diff frozen payload");}
    }
    assert_eq(first.get(0),10);
}

test fn history_graph_prune_retains_heads_pins_and_their_ancestors()->Unit effects {} {
    let graph=transformTake(createGraph<Int>(8));let empty=List<String>();
    let value=1;transformTake(historyGraph.add(&mut graph,"base",&empty,&value));
    let parents=List<String>();parents.add("base");
    transformTake(historyGraph.add(&mut graph,"left",&parents,&value));
    transformTake(historyGraph.add(&mut graph,"right",&parents,&value));
    let right=List<String>();right.add("right");
    transformTake(historyGraph.add(&mut graph,"leaf",&right,&value));
    let detached=transformTake(historyGraph.add(&mut graph,"orphan",&empty,&value));
    transformTake(historyGraph.annotate(&mut graph,"orphan",Annotation("removable","tester")));
    transformTake(historyGraph.setHead(&mut graph,"main","left"));
    transformTake(historyGraph.pin(&mut graph,"leaf"));
    transformTake(historyGraph.pin(&mut graph,"leaf"));
    assert_eq(historyGraph.pins(&graph).len(),1);
    let preview=transformTake(historyGraph.previewPrune(&graph,&empty));
    assert_eq(preview.len(),1);assert_eq(preview.get(0),"orphan");
    assert_eq(historyGraph.length(&graph),5);
    let removed=transformTake(historyGraph.prune(&mut graph,&empty));
    assert_eq(removed.len(),1);assert_eq(removed.get(0),"orphan");
    assert_eq(historyGraph.length(&graph),4);
    assert_eq(historyGraph.annotation(&graph,"orphan"),None);
    assert_eq(historyGraph.fork(detached),1);
    assert_eq(historyGraph.isAncestor(&graph,"base","leaf"),Ok(true));
    assert(historyGraph.unpin(&mut graph,"leaf"));assert(!historyGraph.unpin(&mut graph,"leaf"));
    let more=transformTake(historyGraph.prune(&mut graph,&empty));
    assert_eq(more.len(),2);assert_eq(more.get(0),"leaf");assert_eq(more.get(1),"right");
    assert_eq(historyGraph.length(&graph),2);
    let roots=List<String>();roots.add("left");roots.add("left");
    let ancestors=transformTake(historyGraph.ancestors(&graph,&roots));
    assert_eq(ancestors.len(),2);assert_eq(ancestors.get(0),"base");assert_eq(ancestors.get(1),"left");
}

test fn history_graph_prune_recomputes_roots_and_validates_before_change()->Unit effects {} {
    let graph=transformTake(createGraph<Int>(2));let empty=List<String>();
    let old=10;let original=transformTake(historyGraph.add(&mut graph,"version",&empty,&old));
    let preview=transformTake(historyGraph.previewPrune(&graph,&empty));
    assert_eq(preview.len(),1);
    transformTake(historyGraph.setHead(&mut graph,"keep","version"));
    assert_eq(transformTake(historyGraph.prune(&mut graph,&empty)).len(),0);
    let missing=List<String>();missing.add("unknown");
    match historyGraph.prune(&mut graph,&missing) {Err(e)=>{assert_eq(e.code,"UnknownVersion");},Ok(_)=>{panic("missing keep root");}}
    match historyGraph.pin(&mut graph,"unknown") {Err(e)=>{assert_eq(e.code,"UnknownVersion");},Ok(_)=>{panic("missing pin");}}
    assert_eq(historyGraph.length(&graph),1);
    historyGraph.dropHead(&mut graph,"keep");
    let explicit=List<String>();explicit.add("version");
    assert_eq(transformTake(historyGraph.prune(&mut graph,&explicit)).len(),0);
    assert_eq(transformTake(historyGraph.prune(&mut graph,&empty)).len(),1);
    let updated=99;transformTake(historyGraph.add(&mut graph,"version",&empty,&updated));
    assert_eq(historyGraph.fork(original),10);
    match historyGraph.get(&graph,"version") {Some(v)=>{assert_eq(historyGraph.fork(v),99);},None=>{panic("reused local key");}}
}

test fn changes_rebase_retains_step_roots_and_accepts_already_applied_values()->Unit effects {} {
    let same=|a:Int,b:Int|->Bool{return a==b;};
    let base=Map<String,Int>();base.set("score",10);
    let middle=Map<String,Int>();middle.set("score",20);
    let last=Map<String,Int>();last.set("score",30);
    let patches=List<changes.ChangeSet<Int>>();
    patches.add(transformTake(changes.diff(&base,&middle,same)));
    patches.add(transformTake(changes.diff(&middle,&last,same)));
    let onto=Map<String,Int>();onto.set("score",20);onto.set("unrelated",7);
    let preview=transformTake(changes.previewRebase(&base,&onto,&patches,same));
    assert_eq(preview.conflict,None);assert_eq(preview.steps.len(),2);
    let first=thaw(preview.steps.get(0));let second=thaw(preview.steps.get(1));
    assert_eq(changes.length(first.patch),0);assert_eq(changes.length(second.patch),1);
    assert_eq(first.value.get("score"),Some(20));
    assert_eq(second.value.get("score"),Some(30));
    assert_eq(preview.value.get("unrelated"),Some(7));
    assert_eq(onto.get("score"),Some(20));assert_eq(base.get("score"),Some(10));
    let replayed=transformTake(changes.apply(&onto,second.patch,same));
    assert_eq(replayed.get("score"),Some(30));assert_eq(replayed.get("unrelated"),Some(7));
}

test fn changes_rebase_stops_before_conflicting_step_without_partial_edits()->Unit effects {} {
    let same=|a:Int,b:Int|->Bool{return a==b;};
    let base=Map<String,Int>();base.set("a",1);base.set("b",1);
    let one=Map<String,Int>();one.set("a",2);one.set("b",1);
    let two=Map<String,Int>();two.set("a",3);two.set("b",2);
    let patches=List<changes.ChangeSet<Int>>();
    patches.add(transformTake(changes.diff(&base,&one,same)));
    patches.add(transformTake(changes.diff(&one,&two,same)));
    let onto=Map<String,Int>();onto.set("a",1);onto.set("b",9);
    let preview=transformTake(changes.previewRebase(&base,&onto,&patches,same));
    assert_eq(preview.steps.len(),1);
    match preview.conflict {Some(c)=>{assert_eq(c.step,1);assert_eq(c.key,"b");},None=>{panic("missing conflict");}}
    assert_eq(preview.value.get("a"),Some(2));assert_eq(preview.value.get("b"),Some(9));
    assert_eq(onto.get("a"),Some(1));assert_eq(base.get("b"),Some(1));
    let invalid=List<Change<Int>>();invalid.add(Change<Int>("a",Some(99),Some(4)));
    patches.add(transformTake(changes.fromChanges(&invalid,same)));
    match changes.previewRebase(&base,&onto,&patches,same) {
        Err(e)=>{assert_eq(e.code,"OriginalConflict");assert_eq(e.step,2);assert_eq(e.key,"a");},
        Ok(_)=>{panic("invalid original chain hidden by target conflict");}
    }
}

test fn changes_rebase_handles_deletions_and_empty_sequences()->Unit effects {} {
    let same=|a:Int,b:Int|->Bool{return a==b;};
    let base=Map<String,Int>();base.set("x",1);
    let absent=Map<String,Int>();let after=Map<String,Int>();after.set("x",2);
    let patches=List<changes.ChangeSet<Int>>();
    patches.add(transformTake(changes.diff(&base,&absent,same)));
    patches.add(transformTake(changes.diff(&absent,&after,same)));
    let preview=transformTake(changes.previewRebase(&base,&absent,&patches,same));
    assert_eq(preview.conflict,None);assert_eq(preview.value.get("x"),Some(2));
    assert_eq(changes.length(thaw(preview.steps.get(0)).patch),0);
    let empty=List<changes.ChangeSet<Int>>();
    let identity=transformTake(changes.previewRebase(&base,&after,&empty,same));
    assert_eq(identity.steps.len(),0);assert_eq(identity.conflict,None);
    after.set("x",3);assert_eq(identity.value.get("x"),Some(2));
}

import textIndex as textIndex;

test fn text_indices_distinguish_bytes_scalars_and_graphemes()->Unit effects {} {
    let source=transformTake(textIndex.create("A😀é\r\n日"));
    assert_eq(textIndex.byteLength(source),13);
    assert_eq(textIndex.scalarLength(source),7);
    assert_eq(textIndex.graphemeLength(source),5);
    let combining=transformTake(textIndex.byteAt(source,6));
    assert_eq(textIndex.scalarValue(transformTake(textIndex.byteToScalar(combining))),3);
    match textIndex.byteToGrapheme(combining) {Err(e)=>{assert_eq(e.code,"GraphemeBoundary");},Ok(_)=>{panic("combining boundary");}}
    let insideEmoji=transformTake(textIndex.byteAt(source,3));
    match textIndex.byteToScalar(insideEmoji) {Err(e)=>{assert_eq(e.code,"ScalarBoundary");assert_eq(e.offset,3);},Ok(_)=>{panic("UTF-8 boundary");}}
    let lf=transformTake(textIndex.scalarAt(source,5));
    assert_eq(textIndex.byteValue(textIndex.scalarToByte(lf)),9);
    match textIndex.byteToGrapheme(textIndex.scalarToByte(lf)) {Err(e)=>{assert_eq(e.code,"GraphemeBoundary");},Ok(_)=>{panic("CRLF boundary");}}
    let end=transformTake(textIndex.byteAt(source,13));
    assert_eq(textIndex.scalarValue(transformTake(textIndex.byteToScalar(end))),7);
    assert_eq(textIndex.graphemeValue(transformTake(textIndex.byteToGrapheme(end))),5);
    let start=transformTake(textIndex.graphemeAt(source,2));
    let finish=transformTake(textIndex.graphemeAt(source,3));
    assert_eq(textIndex.sliceGraphemes(start,finish),Ok("é"));
    assert_eq(textIndex.byteValue(textIndex.graphemeToByte(start)),5);
}

test fn text_indices_retain_original_source_and_reject_mixed_text()->Unit effects {} {
    var contents="日本";
    let source=transformTake(textIndex.create(contents));
    let start=transformTake(textIndex.scalarAt(source,0));
    let end=transformTake(textIndex.scalarAt(source,2));
    contents="日曜";let edited=transformTake(textIndex.create(contents));
    assert_eq(textIndex.sliceScalars(start,end),Ok("日本"));
    assert_eq(textIndex.text(textIndex.scalarSource(start)),"日本");
    let other=transformTake(textIndex.scalarAt(edited,2));
    match textIndex.sliceScalars(start,other) {Err(e)=>{assert_eq(e.code,"TextMismatch");},Ok(_)=>{panic("mixed source");}}
    let equal=transformTake(textIndex.create("日本"));
    assert_eq(textIndex.sliceScalars(start,transformTake(textIndex.scalarAt(equal,2))),Ok("日本"));
    match textIndex.sliceScalars(end,start) {Err(e)=>{assert_eq(e.code,"Range");},Ok(_)=>{panic("reversed range");}}
    match textIndex.byteAt(source,-1) {Err(e)=>{assert_eq(e.code,"ByteRange");},Ok(_)=>{panic("negative byte");}}
    match textIndex.scalarAt(source,3) {Err(e)=>{assert_eq(e.code,"ScalarRange");},Ok(_)=>{panic("scalar overflow");}}
    match textIndex.graphemeAt(source,3) {Err(e)=>{assert_eq(e.code,"GraphemeRange");},Ok(_)=>{panic("grapheme overflow");}}
    let empty=transformTake(textIndex.create(""));
    assert_eq(textIndex.byteLength(empty),0);assert_eq(textIndex.scalarLength(empty),0);assert_eq(textIndex.graphemeLength(empty),0);
    let zero=transformTake(textIndex.byteAt(empty,0));
    assert_eq(textIndex.scalarValue(transformTake(textIndex.byteToScalar(zero))),0);
    assert_eq(textIndex.graphemeValue(transformTake(textIndex.byteToGrapheme(zero))),0);
}

test fn parser_lookahead_and_negative_lookahead_preserve_input()->Unit effects {} {
    let letter=parser.literal(Bytes("a"),"a");
    let pair=parser.pair(parser.lookAhead(letter),letter);
    match parser.complete(pair,Bytes("a")) {Ok(value)=>{assert_eq(value.0,Bytes("a"));assert_eq(value.1,Bytes("a"));},Err(_)=>{panic("lookahead consumed input");}}
    let digit=parser.satisfy("digit",|v:Int|->Bool{return v>=48 && v<=57;});
    let keyword=parser.pair(letter,parser.notFollowedBy(digit,"non-digit"));
    match parser.parse(keyword,Bytes("ax")) {Ok(value)=>{assert_eq(parser.position(value.next),1);},Err(_)=>{panic("negative lookahead");}}
    match parser.parse(keyword,Bytes("a1")) {Err(e)=>{assert_eq(e.offset,1);},Ok(_)=>{panic("forbidden suffix");}}
    match parser.parse(parser.notFollowedBy(parser.cut(letter),"not a"),Bytes("b")) {Err(e)=>{assert(e.committed);},Ok(_)=>{panic("cut swallowed");}}
}

test fn parser_spans_keep_original_bytes_and_verify_reports_value_end()->Unit effects {} {
    var input=Bytes("日本!");
    let word=parser.spanned(parser.literal(Bytes("日本"),"word"));
    let parsed=transformTake(parser.parse(word,input));
    input=Bytes("changed");
    assert_eq(parser.spanStart(parsed.value.span),0);assert_eq(parser.spanEnd(parsed.value.span),6);
    assert_eq(parser.spanBytes(parsed.value.span),Bytes("日本"));
    assert_eq(parsed.value.value,Bytes("日本"));
    let offset=parser.pair(parser.literal(Bytes("!"),"prefix"),word);
    let nested=transformTake(parser.complete(offset,Bytes("!日本")));
    assert_eq(parser.spanStart(nested.1.span),1);assert_eq(parser.spanEnd(nested.1.span),7);
    let even=parser.verify(parser.satisfy("digit",|v:Int|->Bool{return v>=48 && v<=57;}),"even",|v:Int|->Bool{return (v-48)%2==0;});
    match parser.complete(even,Bytes("3")) {Err(e)=>{assert_eq(e.offset,1);assert_eq(e.expected.get(0),"even");},Ok(_)=>{panic("predicate ignored");}}
    assert_eq(parser.complete(even,Bytes("2")),Ok(50));
}

test fn parser_value_dependent_choice_uses_the_same_cursor()->Unit effects {} {
    let tag=parser.satisfy("tag",|v:Int|->Bool{return v==65 || v==66;});
    let tagged=parser.andThen(tag,|v:Int|->parser.Parser<Bytes>{
        if v==65 {return parser.literal(Bytes("one"),"one");}
        return parser.literal(Bytes("two"),"two");
    });
    assert_eq(parser.complete(tagged,Bytes("Aone")),Ok(Bytes("one")));
    assert_eq(parser.complete(tagged,Bytes("Btwo")),Ok(Bytes("two")));
    match parser.complete(tagged,Bytes("Atwo")) {Err(e)=>{assert_eq(e.offset,1);},Ok(_)=>{panic("wrong dependent branch");}}
}

test fn parser_operator_chains_preserve_association_and_precedence()->Unit effects {} {
    let digit=parser.map(parser.satisfy("digit",|v:Int|->Bool{return v>=48 && v<=57;}),|v:Int|->Int{return v-48;});
    let minus=parser.binary(Bytes("-"),"minus",|a:Int,b:Int|->Int{return a-b;});
    let left=transformTake(parser.chainLeft(digit,minus,8));
    let right=transformTake(parser.chainRight(digit,minus,8));
    assert_eq(parser.complete(left,Bytes("9-3-1")),Ok(5));
    assert_eq(parser.complete(right,Bytes("9-3-1")),Ok(7));
    let times=parser.binary(Bytes("*"),"times",|a:Int,b:Int|->Int{return a*b;});
    let plus=parser.binary(Bytes("+"),"plus",|a:Int,b:Int|->Int{return a+b;});
    let products=transformTake(parser.chainLeft(digit,times,8));
    let sums=transformTake(parser.chainLeft(products,plus,8));
    assert_eq(parser.complete(sums,Bytes("2+3*4")),Ok(14));
    match parser.complete(sums,Bytes("2+")) {Err(e)=>{assert_eq(e.offset,2);},Ok(_)=>{panic("missing operand");}}
    let one=transformTake(parser.chainLeft(digit,plus,1));
    match parser.complete(one,Bytes("1+2+3")) {Err(e)=>{assert_eq(e.code,"TrailingInput");assert_eq(e.offset,3);},Ok(_)=>{panic("operator bound");}}
}

test fn parser_operator_chains_reject_nonprogress_and_propagate_cut()->Unit effects {} {
    let pure=parserPure<Int>(1);
    let empty=parser.binary(Bytes(""),"empty",|a:Int,b:Int|->Int{return a+b;});
    let left=transformTake(parser.chainLeft(pure,empty,1));
    let right=transformTake(parser.chainRight(pure,empty,1));
    match parser.complete(left,Bytes("")) {Err(e)=>{assert_eq(e.code,"NonProgress");},Ok(_)=>{panic("left nonprogress");}}
    match parser.complete(right,Bytes("")) {Err(e)=>{assert_eq(e.code,"NonProgress");},Ok(_)=>{panic("right nonprogress");}}
    let zero=transformTake(parser.chainRight(pure,empty,0));
    assert_eq(parser.complete(zero,Bytes("")),Ok(1));
    let plus=parser.cut(parser.binary(Bytes("+"),"plus",|a:Int,b:Int|->Int{return a+b;}));
    let chain=transformTake(parser.chainLeft(pure,plus,1));
    match parser.complete(chain,Bytes("")) {Err(e)=>{assert(e.committed);},Ok(_)=>{panic("operator cut");}}
    match parser.chainRight(pure,empty,65536) {Err(e)=>{assert_eq(e.code,"InvalidBounds");},Ok(_)=>{panic("operator limit");}}
}

test fn history_graph_merge_bases_keep_all_nearest_common_ancestors()->Unit effects {} {
    let graph=transformTake(createGraph<Int>(8));let empty=List<String>();let value=1;
    transformTake(historyGraph.add(&mut graph,"root",&empty,&value));
    let root=List<String>();root.add("root");
    transformTake(historyGraph.add(&mut graph,"left",&root,&value));
    transformTake(historyGraph.add(&mut graph,"right",&root,&value));
    let parents=List<String>();parents.add("left");parents.add("right");
    transformTake(historyGraph.add(&mut graph,"first",&parents,&value));
    let reversed=List<String>();reversed.add("right");reversed.add("left");
    transformTake(historyGraph.add(&mut graph,"second",&reversed,&value));
    let bases=transformTake(historyGraph.mergeBases(&graph,"first","second"));
    assert_eq(bases.len(),2);assert_eq(bases.get(0),"left");assert_eq(bases.get(1),"right");
    let fork=transformTake(historyGraph.mergeBases(&graph,"left","right"));
    assert_eq(fork.len(),1);assert_eq(fork.get(0),"root");
    let inclusive=transformTake(historyGraph.mergeBases(&graph,"left","first"));
    assert_eq(inclusive.len(),1);assert_eq(inclusive.get(0),"left");
    let identical=transformTake(historyGraph.mergeBases(&graph,"first","first"));
    assert_eq(identical.len(),1);assert_eq(identical.get(0),"first");
    transformTake(historyGraph.add(&mut graph,"separate",&empty,&value));
    assert_eq(transformTake(historyGraph.mergeBases(&graph,"first","separate")).len(),0);
}

test fn history_graph_path_is_shortest_and_uses_declared_parent_order()->Unit effects {} {
    let graph=transformTake(createGraph<Int>(8));let empty=List<String>();let value=1;
    transformTake(historyGraph.add(&mut graph,"root",&empty,&value));
    let root=List<String>();root.add("root");
    transformTake(historyGraph.add(&mut graph,"left",&root,&value));
    transformTake(historyGraph.add(&mut graph,"right",&root,&value));
    let parents=List<String>();parents.add("right");parents.add("left");
    transformTake(historyGraph.add(&mut graph,"merge",&parents,&value));
    match transformTake(historyGraph.path(&graph,"root","merge")) {
        Some(path)=>{assert_eq(path.len(),3);assert_eq(path.get(0),"root");assert_eq(path.get(1),"right");assert_eq(path.get(2),"merge");},
        None=>{panic("missing path");}
    }
    parents.add("root");transformTake(historyGraph.add(&mut graph,"shortcut",&parents,&value));
    match transformTake(historyGraph.path(&graph,"root","shortcut")) {
        Some(path)=>{assert_eq(path.len(),2);assert_eq(path.get(1),"shortcut");},None=>{panic("missing shortcut");}
    }
    match transformTake(historyGraph.path(&graph,"left","right")) {None=>{},Some(_)=>{panic("unrelated siblings");}}
    match transformTake(historyGraph.path(&graph,"root","root")) {Some(path)=>{assert_eq(path.len(),1);},None=>{panic("reflexive path");}}
    match historyGraph.path(&graph,"missing","root") {Err(e)=>{assert_eq(e.code,"UnknownVersion");},Ok(_)=>{panic("missing endpoint");}}
    assert_eq(historyGraph.length(&graph),5);
}

import lens as lens;
record LensAddress {city:String,number:Int}
record LensPerson {name:String,address:LensAddress}
fn lensAddress()->lens.Lens<LensPerson,LensAddress,String> effects {} {
    return lens.create(
        |root:LensPerson|->LensAddress{return root.address;},
        |root:LensPerson,value:LensAddress|->Result<LensPerson,String>{return Ok(LensPerson(root.name,value));}
    );
}
fn lensNumber()->lens.Lens<LensAddress,Int,String> effects {} {
    return lens.create(
        |root:LensAddress|->Int{return root.number;},
        |root:LensAddress,value:Int|->Result<LensAddress,String>{
            if value<0 {return Err("Negative");}
            return Ok(LensAddress(root.city,value));
        }
    );
}

test fn lens_composition_validates_updates_and_preserves_unrelated_fields()->Unit effects {} {
    let path=lens.compose(lensAddress(),lensNumber());
    let original=LensPerson("before",LensAddress("Tokyo",10));
    let change=lens.plan(path,original,20);
    assert_eq(lens.before(change),10);assert_eq(lens.after(change),20);
    let renamed=LensPerson("renamed",original.address);
    let same=|a:Int,b:Int|->Bool{return a==b;};
    let changed=transformTake(lens.apply(change,renamed,same));
    assert_eq(changed.name,"renamed");assert_eq(changed.address.city,"Tokyo");assert_eq(changed.address.number,20);
    let restored=transformTake(lens.apply(lens.inverse(change),changed,same));
    assert_eq(restored.address.number,10);assert_eq(restored.name,"renamed");
    match lens.apply(change,changed,same) {Err(e)=>{assert_eq(e.code,"Conflict");},Ok(_)=>{panic("focus conflict");}}
    assert_eq(lens.set(path,original,-1),Err("Negative"));
    let rejected=lens.plan(path,original,-1);
    match lens.apply(rejected,original,same) {Err(e)=>{assert_eq(e.code,"Rejected");assert_eq(e.cause,Some("Negative"));},Ok(_)=>{panic("validation ignored");}}
    let modified=transformTake(lens.modify(path,original,|n:Int|->Result<Int,String>{return Ok(n+1);}));
    assert_eq(modified.address.number,11);assert_eq(original.address.number,10);
}

test fn optional_lenses_do_not_create_missing_values_or_run_callbacks()->Unit effects {} {
    let key=lens.optional(
        |root:Frozen<Map<String,Int>>|->Option<Int>{return root.get("x");},
        |root:Frozen<Map<String,Int>>,value:Int|->Result<Option<Frozen<Map<String,Int>>>,String>{
            let updated=thaw(root);updated.set("x",value);return Ok(Some(freeze(updated)));
        }
    );
    let empty=Map<String,Int>();let missing=freeze(empty);
    assert_eq(lens.setIfPresent(key,missing,3),Ok(None));
    assert_eq(lens.modifyIfPresent(key,missing,|v:Int|->Result<Int,String>{return Err("must not run");}),Ok(None));
    empty.set("x",1);let present=freeze(empty);
    let changed=transformTake(lens.modifyIfPresent(key,present,|v:Int|->Result<Int,String>{return Ok(v+1);}));
    match changed {Some(root)=>{assert_eq(root.get("x"),Some(2));},None=>{panic("present focus");}}
    assert_eq(present.get("x"),Some(1));assert_eq(missing.get("x"),None);
    let number=lens.composeOptional(lens.asOptional(lensAddress()),lens.asOptional(lensNumber()));
    let person=LensPerson("name",LensAddress("city",5));
    assert_eq(lens.preview(number,person),Some(5));
    match transformTake(lens.setIfPresent(number,person,6)) {Some(value)=>{assert_eq(value.address.number,6);},None=>{panic("optional composition");}}
}

test fn lens_law_checks_report_sample_violations()->Unit effects {} {
    let same=|a:Int,b:Int|->Bool{return a==b;};
    let lawful=lens.create(|root:Int|->Int{return root;},|root:Int,value:Int|->Result<Int,String>{return Ok(value);});
    let good=transformTake(lens.checkLaws(lawful,10,21,32,same,same));
    assert(good.getPut);assert(good.putGet);assert(good.putPut);
    let rounding=lens.create(|root:Int|->Int{return root;},|root:Int,value:Int|->Result<Int,String>{return Ok((value/10)*10);});
    let bad=transformTake(lens.checkLaws(rounding,11,21,32,same,same));
    assert(!bad.getPut);assert(!bad.putGet);assert(bad.putPut);
}
