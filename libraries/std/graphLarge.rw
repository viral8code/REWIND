// Native adjacency companion to the existing std.graph. Language 1.9.49.
import sort as sort;
import disjointSet as disjointSet;
import heap as heap;
import integer as integer;
pub struct Graph{private heads:IntArray,private destinations:IntArray,private links:IntArray,private weights:IntArray,private capacity:Int,private count:Int}
fn take<T>(result:Result<T,StdError>)->T effects {} {match move result{Ok(value)=>{return move value;},Err(_)=>{panic("graph storage invariant");}}}
fn native<T>(result:Result<T,StdError>)->Result<T,String> effects {} {match move result{Ok(value)=>{return Ok(move value);},Err(e)=>{return Err(e.code);}}}
fn buffer(length:Int)->IntArray effects {} {let shape=List<Int>();shape.add(length);return take(stdNumericZerosInt(&shape));}
fn size(array:&IntArray)->Int effects {} {return take(stdNumericLengthInt(array));}
fn at(array:&IntArray,index:Int)->Int effects {} {return take(stdNumericGetFlatInt(array,index));}
fn head(array:&IntArray,index:Int)->Int effects {} {return at(array,index)-1;}
record Candidate{distance:Int,vertex:Int}
fn compare(a:Candidate,b:Candidate)->Int effects {} {if a.distance<b.distance{return -1;}if a.distance>b.distance{return 1;}if a.vertex<b.vertex{return -1;}if a.vertex>b.vertex{return 1;}return 0;}
// @api create cost O(1) virtual-zero storage; pages are admitted as touched. Capacity is at most 1048576.
pub fn create(vertices:Int,capacity:Int)->Result<Graph,String> effects {} {
 if vertices<0 || vertices>1048576 || capacity<0 || capacity>1048576{return Err("Capacity");}
 return Ok(Graph(buffer(vertices),buffer(capacity),buffer(capacity),buffer(capacity),capacity,0));
}
// @api fromEdges cost O(edges log pages); native bulk adjacency builder, no per-edge VM callback or coordinate List.
// @api fromEdges failure Capacity/Shape or NumericIndex; input arrays are rank-one, equal length and retained immutable views.
pub fn fromEdges(vertices:Int,froms:&IntArray,tos:IntArray,weights:IntArray)->Result<Graph,String> effects {} {
 if vertices<0 || vertices>1048576 || size(froms)>1048576{return Err("Capacity");}
 let fromShape=take(stdNumericShapeInt(froms));let toShape=take(stdNumericShapeInt(&tos));let weightShape=take(stdNumericShapeInt(&weights));
 if fromShape.len()!=1 || toShape.len()!=1 || weightShape.len()!=1 || size(froms)!=size(&tos) || size(froms)!=size(&weights){return Err("Shape");}
 let arrays=native(stdNumericGraphAdjacency(vertices,froms,&tos))?;
 let count=size(froms);return Ok(Graph(arrays._0,tos,arrays._1,weights,count,count));
}
// @api add cost Four COW point updates; bulk construction is preferred for large edge sets.
pub fn add(graph:&mut Graph,from:Int,to:Int,weight:Int)->Result<Unit,String> effects {} {
 if from<0 || to<0 || from>=size(&graph.heads) || to>=size(&graph.heads){return Err("Range");}
 if graph.count>=graph.capacity{return Err("Capacity");}
 let index=graph.count;let previous=at(&graph.heads,from);
 graph.destinations=take(stdNumericWithFlatInt(&graph.destinations,index,to));graph.weights=take(stdNumericWithFlatInt(&graph.weights,index,weight));
 graph.links=take(stdNumericWithFlatInt(&graph.links,index,previous));graph.heads=take(stdNumericWithFlatInt(&graph.heads,from,index+1));graph.count=index+1;return Ok(());
}
// @api bfs cost O(vertices + edges) bounded native traversal, times page lookup; returns native IntArray, -1 for unreachable vertices.
pub fn bfs(graph:&Graph,source:Int)->Result<IntArray,String> effects {} {
 if source<0 || source>=size(&graph.heads){return Err("Range");}
 return native(stdNumericGraphBfs(&graph.heads,&graph.destinations,&graph.links,graph.count,source));
}
pub fn dfs(graph:&Graph,source:Int)->Result<List<Int>,String> effects {} {if source<0 || source>=size(&graph.heads){return Err("Range");}let seen=List<Bool>();var i=0;while i<size(&graph.heads){seen.add(false);i+=1;}let stack=List<Int>();let order=List<Int>();seen.set(source,true);stack.add(source);while stack.len()>0{var v=source;match stack.pop(){Some(x)=>{v=x;},None=>{break;}}order.add(v);var e=head(&graph.heads,v);while e!=-1{let to=at(&graph.destinations,e);if !seen.get(to){seen.set(to,true);stack.add(to);}e=head(&graph.links,e);}}return Ok(order);}
pub fn dijkstra(graph:&Graph,source:Int)->Result<List<Option<Int>>,String> effects {} {if source<0 || source>=size(&graph.heads){return Err("Range");}var i=0;while i<graph.count{if at(&graph.weights,i)<0{return Err("NegativeWeight");}i+=1;}let distance=List<Option<Int>>();i=0;while i<size(&graph.heads){distance.add(None);i+=1;}distance.set(source,Some(0));let queue=List<Candidate>();heap.push(&mut queue,Candidate(0,source),graph.capacity+1,compare)?;
 while queue.len()>0{var current=Candidate(0,source);match heap.pop(&mut queue,compare){Some(v)=>{current=v;},None=>{break;}}var known=-1;match distance.get(current.vertex){Some(v)=>{known=v;},None=>{}}
  if known==current.distance{var edge=head(&graph.heads,current.vertex);while edge!=-1{let next=at(&graph.destinations,edge);let candidate=integer.add(current.distance,at(&graph.weights,edge))?;var improve=false;match distance.get(next){None=>{improve=true;},Some(old)=>{improve=candidate<old;}}if improve{distance.set(next,Some(candidate));heap.push(&mut queue,Candidate(candidate,next),graph.capacity+1,compare)?;}edge=head(&graph.links,edge);}}
 }return Ok(distance);
}
// Deterministic Kahn order; ties follow vertex initialization and adjacency order.
pub fn topological(graph:&Graph)->Result<List<Int>,String> effects {} {
 let n=size(&graph.heads);let degree=List<Int>();let queue=List<Int>();let out=List<Int>();var i=0;while i<n{degree.add(0);i+=1;}i=0;while i<graph.count{let to=at(&graph.destinations,i);degree.set(to,degree.get(to)+1);i+=1;}i=0;while i<n{if degree.get(i)==0{queue.add(i);}i+=1;}var cursor=0;
 while cursor<queue.len(){let v=queue.get(cursor);cursor+=1;out.add(v);var edge=head(&graph.heads,v);while edge!=-1{let to=at(&graph.destinations,edge);degree.set(to,degree.get(to)-1);if degree.get(to)==0{queue.add(to);}edge=head(&graph.links,edge);}}if out.len()!=n{return Err("Cycle");}return Ok(out);
}
pub fn bellmanFord(graph:&Graph,source:Int)->Result<List<Option<Int>>,String> effects {} {
 let n=size(&graph.heads);if source<0 || source>=n{return Err("Range");}let distance=List<Option<Int>>();var i=0;while i<n{distance.add(None);i+=1;}distance.set(source,Some(0));var round=0;
 while round<n{var changed=false;var v=0;while v<n{match distance.get(v){None=>{},Some(d)=>{var edge=head(&graph.heads,v);while edge!=-1{let to=at(&graph.destinations,edge);let candidate=integer.add(d,at(&graph.weights,edge))?;var improve=false;match distance.get(to){None=>{improve=true;},Some(old)=>{improve=candidate<old;}}if improve{if round==n-1{return Err("NegativeCycle");}distance.set(to,Some(candidate));changed=true;}edge=head(&graph.links,edge);}}}v+=1;}if !changed{return Ok(distance);}round+=1;}return Ok(distance);
}
// Iterative Kosaraju; component identifiers are dense from zero.
pub fn components(graph:&Graph)->Result<List<Int>,String> effects {} {
 let n=size(&graph.heads);let reverse=create(n,graph.count)?;var v=0;while v<n{var edge=head(&graph.heads,v);while edge!=-1{add(&mut reverse,at(&graph.destinations,edge),v,0)?;edge=head(&graph.links,edge);}v+=1;}
 let seen=List<Bool>();let ids=List<Int>();let order=List<Int>();v=0;while v<n{seen.add(false);ids.add(-1);v+=1;}let vertices=List<Int>();let edges=List<Int>();v=0;
 while v<n{if !seen.get(v){seen.set(v,true);vertices.add(v);edges.add(head(&graph.heads,v));while vertices.len()>0{let p=vertices.len()-1;let current=vertices.get(p);let edge=edges.get(p);if edge==-1{vertices.pop();edges.pop();order.add(current);}else{edges.set(p,head(&graph.links,edge));let to=at(&graph.destinations,edge);if !seen.get(to){seen.set(to,true);vertices.add(to);edges.add(head(&graph.heads,to));}}}}v+=1;}
 var component=0;var cursor=order.len();while cursor>0{cursor-=1;let start=order.get(cursor);if ids.get(start)==-1{ids.set(start,component);vertices.add(start);while vertices.len()>0{var current=0;match vertices.pop(){Some(x)=>{current=x;},None=>{panic("stack");}}var edge=head(&reverse.heads,current);while edge!=-1{let to=at(&reverse.destinations,edge);if ids.get(to)==-1{ids.set(to,component);vertices.add(to);}edge=head(&reverse.links,edge);}}component+=1;}}return Ok(ids);
}
record WeightedEdge{weight:Int,from:Int,to:Int}
fn compareEdge(a:WeightedEdge,b:WeightedEdge)->Int effects {} {if a.weight<b.weight{return -1;}if a.weight>b.weight{return 1;}if a.from<b.from{return -1;}if a.from>b.from{return 1;}if a.to<b.to{return -1;}if a.to>b.to{return 1;}return 0;}
pub struct Forest{weight:Int,components:Int,froms:List<Int>,tos:List<Int>}
// Each directed edge is interpreted as an undirected candidate, including duplicates.
pub fn minimumForest(graph:&Graph)->Result<Forest,String> effects {} {
 let n=size(&graph.heads);let candidates=List<WeightedEdge>();var v=0;while v<n{var edge=head(&graph.heads,v);while edge!=-1{candidates.add(WeightedEdge(at(&graph.weights,edge),v,at(&graph.destinations,edge)));edge=head(&graph.links,edge);}v+=1;}
 let sorted=sort.stable(&candidates,compareEdge);let set=disjointSet.create(n)?;let froms=List<Int>();let tos=List<Int>();var count=n;var weight=0;var i=0;while i<sorted.len(){let edge=sorted.get(i);if disjointSet.unite(&mut set,edge.from,edge.to)?{weight=integer.add(weight,edge.weight)?;count-=1;froms.add(edge.from);tos.add(edge.to);}i+=1;}return Ok(Forest(weight,count,froms,tos));
}
pub struct Ancestors{private jumps:List<Int>,private depths:List<Int>,private length:Int,private levels:Int}
// A directed rooted tree: root has no incoming edge, every other vertex has one.
pub fn ancestors(graph:&Graph,root:Int)->Result<Ancestors,String> effects {} {
 let n=size(&graph.heads);if root<0 || root>=n{return Err("Range");}if n>4096{return Err("Capacity");}if graph.count!=n-1{return Err("Tree");}let parents=List<Int>();let depths=List<Int>();var i=0;while i<n{parents.add(-1);depths.add(-1);i+=1;}
 var v=0;while v<n{var edge=head(&graph.heads,v);while edge!=-1{let to=at(&graph.destinations,edge);if to==root || parents.get(to)!=-1{return Err("Tree");}parents.set(to,v);edge=head(&graph.links,edge);}v+=1;}parents.set(root,root);depths.set(root,0);let queue=List<Int>();queue.add(root);var cursor=0;while cursor<queue.len(){let current=queue.get(cursor);cursor+=1;var edge=head(&graph.heads,current);while edge!=-1{let to=at(&graph.destinations,edge);if depths.get(to)!=-1{return Err("Tree");}depths.set(to,depths.get(current)+1);queue.add(to);edge=head(&graph.links,edge);}}if queue.len()!=n{return Err("Tree");}
 let jumps=List<Int>();i=0;while i<n{jumps.add(parents.get(i));i+=1;}var levels=1;var width=2;while width<=n{i=0;while i<n{let parent=jumps.get((levels-1)*n+i);jumps.add(jumps.get((levels-1)*n+parent));i+=1;}levels+=1;width*=2;}return Ok(Ancestors(jumps,depths,n,levels));
}
pub fn lca(tree:&Ancestors,a:Int,b:Int)->Result<Int,String> effects {} {
 if a<0 || b<0 || a>=tree.length || b>=tree.length{return Err("Range");}var x=a;var y=b;if tree.depths.get(x)<tree.depths.get(y){let t=x;x=y;y=t;}var distance=tree.depths.get(x)-tree.depths.get(y);var level=0;while distance>0{if distance%2==1{x=tree.jumps.get(level*tree.length+x);}distance/=2;level+=1;}if x==y{return Ok(x);}level=tree.levels;while level>0{level-=1;let px=tree.jumps.get(level*tree.length+x);let py=tree.jumps.get(level*tree.length+y);if px!=py{x=px;y=py;}}return Ok(tree.jumps.get(x));
}

pub fn vertices(graph:&Graph)->Int effects {} {return size(&graph.heads);}
pub fn edges(graph:&Graph)->Int effects {} {return graph.count;}
