pub struct SparseMin{private values:List<Int>,private logs:List<Int>,private length:Int}
pub fn sparseMin(input:&List<Int>)->Result<SparseMin,String> effects {} {
 let n=input.len();if n>4096{return Err("Capacity");}let values=List<Int>();let logs=List<Int>();logs.add(0);var i=1;while i<=n{var log=0;if i>=2{log=logs.get(i/2)+1;}logs.add(log);i+=1;}
 i=0;while i<n{values.add(input.get(i));i+=1;}var level=1;var width=2;while width<=n{i=0;while i<n{var value=values.get((level-1)*n+i);if i+width/2<n{let other=values.get((level-1)*n+i+width/2);if other<value{value=other;}}values.add(value);i+=1;}level+=1;width*=2;}return Ok(SparseMin(values,logs,n));
}
pub fn minimum(table:&SparseMin,start:Int,end:Int)->Result<Int,String> effects {} {if start<0 || end<=start || end>table.length{return Err("Range");}let level=table.logs.get(end-start);var width=1;var i=0;while i<level{width*=2;i+=1;}let a=table.values.get(level*table.length+start);let b=table.values.get(level*table.length+end-width);if a<b{return Ok(a);}return Ok(b);}

pub fn length(table:&SparseMin)->Int effects {} {return table.length;}
