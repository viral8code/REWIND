import bigint as bigint;
import decimal as decimal;
import json as json;
import schema as schema;
pub type Event=JsonStreamEvent;
pub struct Reader {private state:JsonStreamState}
pub enum IntegerEventError {Stream(StdError),ExpectedNumber(Int),InvalidInteger(StdError)}
pub enum DecimalEventError {Stream(StdError),ExpectedNumber(Int),InvalidDecimal(StdError)}
pub fn reader()->Result<Reader,StdError> effects {} {match stdJsonStreamNew(){Err(error)=>{return Err(error);},Ok(state)=>{return Ok(Reader(state));}}}
// A failed feed leaves the Reader unchanged. Drain queued events and retry the same chunk after JsonQueueLimit.
pub fn feed(reader:&mut Reader,chunk:Bytes,finish:Bool)->Result<Unit,StdError> effects {} {match stdJsonStreamFeed(&reader.state,chunk,finish){Err(error)=>{return Err(error);},Ok(state)=>{reader.state=state;return Ok(());}}}
// peek observes the next queued event without advancing the reader.
pub fn peek(reader:&Reader)->Result<Option<Event>,StdError> effects {} {return stdJsonStreamPeek(&reader.state);}
fn eventPosition(event:Event)->Int effects {} {
 match event {
  JsonStreamEvent::ObjectStart(position)=>{return position;},
  JsonStreamEvent::ObjectEnd(position)=>{return position;},
  JsonStreamEvent::ArrayStart(position)=>{return position;},
  JsonStreamEvent::ArrayEnd(position)=>{return position;},
  JsonStreamEvent::Key(_,position)=>{return position;},
  JsonStreamEvent::Text(_,position)=>{return position;},
  JsonStreamEvent::Number(_,position)=>{return position;},
  JsonStreamEvent::Bool(_,position)=>{return position;},
  JsonStreamEvent::Null(position)=>{return position;}
 }
}
// @api nextBigInt failure parses an exact base-10 integer token before advancing; a non-number or failed conversion remains queued.
pub fn nextBigInt(reader:&mut Reader)->Result<Option<BigInt>,IntegerEventError> effects {} {
 match stdJsonStreamPeek(&reader.state) {
  Err(error)=>{return Err(IntegerEventError::Stream(error));},
  Ok(value)=>{
   match move value {
    None=>{return Ok(None);},
    Some(event)=>{
     match event {
      JsonStreamEvent::Number(raw,_)=>{
       match bigint.parse(raw,10) {
        Err(error)=>{return Err(IntegerEventError::InvalidInteger(error));},
        Ok(number)=>{
         match stdJsonStreamAdvance(&reader.state) {
          Err(error)=>{return Err(IntegerEventError::Stream(error));},
          Ok(state)=>{reader.state=state;return Ok(Some(number));}
         }
        }
       }
      },
      _=>{return Err(IntegerEventError::ExpectedNumber(eventPosition(event)));}
     }
    }
   }
  }
 }
}
// @api nextDecimal failure parses a JSON number token as exact base-10 Decimal before advancing; a wrong event kind or parse failure remains queued.
pub fn nextDecimal(reader:&mut Reader)->Result<Option<Decimal>,DecimalEventError> effects {} {
 match stdJsonStreamPeek(&reader.state) {
  Err(error)=>{return Err(DecimalEventError::Stream(error));},
  Ok(value)=>{
   match move value {
    None=>{return Ok(None);},
    Some(event)=>{
     match event {
      JsonStreamEvent::Number(raw,_)=>{
       match decimal.parse(raw) {
        Err(error)=>{return Err(DecimalEventError::InvalidDecimal(error));},
        Ok(number)=>{
         match stdJsonStreamAdvance(&reader.state) {
          Err(error)=>{return Err(DecimalEventError::Stream(error));},
          Ok(state)=>{reader.state=state;return Ok(Some(number));}
         }
        }
       }
      },
      _=>{return Err(DecimalEventError::ExpectedNumber(eventPosition(event)));}
     }
    }
   }
  }
 }
}
pub fn next(reader:&mut Reader)->Result<Option<Event>,StdError> effects {} {
 match stdJsonStreamPeek(&reader.state){Err(error)=>{return Err(error);},Ok(value)=>{
 match move value{None=>{return Ok(None);},Some(event)=>{match stdJsonStreamAdvance(&reader.state){Err(error)=>{return Err(error);},Ok(state)=>{reader.state=state;return Ok(Some(move event));}}}}
 }}
}
pub fn finish(reader:&mut Reader)->Result<Unit,StdError> effects {} {match stdEncode(""){Err(error)=>{return Err(error);},Ok(empty)=>{return feed(reader,empty,true);}}}
pub fn cancel(reader:&mut Reader)->Result<Unit,StdError> effects {} {match stdJsonStreamCancel(&reader.state){Err(error)=>{return Err(error);},Ok(state)=>{reader.state=state;return Ok(());}}}
pub fn position(reader:&Reader)->Result<Int,StdError> effects {} {return stdJsonStreamPosition(&reader.state);}


pub enum JsonValueError {Stream(StdError),InvalidNumber(String,Int),DepthLimit(Int),ExpectedValue(Int),ExpectedKey(Int),DuplicateKey(Int),ContainerLimit(Int)}
pub enum SchemaEventError {Event(JsonValueError),Validation(schema.ValidationError)}
fn valueEvent(reader:&mut Reader)->Result<Option<Event>,JsonValueError> effects {} {
 match next(reader){Err(error)=>{return Err(JsonValueError::Stream(error));},Ok(value)=>{return Ok(value);}}
}
fn readObject(reader:&mut Reader,depth:Int)->Result<Option<Json>,JsonValueError> effects {} {
 let fields=Map<String,Json>();
 while true {
  match peek(reader){
   Err(error)=>{return Err(JsonValueError::Stream(error));},
   Ok(None)=>{return Ok(None);},
   Ok(Some(event))=>{
    match event {
     JsonStreamEvent::ObjectEnd(_)=>{
      match valueEvent(reader){Err(error)=>{return Err(error);},Ok(None)=>{return Ok(None);},Ok(Some(_))=>{return Ok(Some(Json::Object(freeze(fields))));}}
     },
     JsonStreamEvent::Key(name,position)=>{
      if fields.len()>=65536{return Err(JsonValueError::ContainerLimit(position));}
      if fields.get(name)!=None{return Err(JsonValueError::DuplicateKey(position));}
      match valueEvent(reader){Err(error)=>{return Err(error);},Ok(None)=>{return Ok(None);},Ok(Some(_))=>{}}
      match readValue(reader,depth+1){
       Err(error)=>{return Err(error);},
       Ok(None)=>{return Ok(None);},
       Ok(Some(value))=>{fields.set(name,value);}
      }
     },
     _=>{return Err(JsonValueError::ExpectedKey(eventPosition(event)));}
    }
   }
  }
 }
 return Ok(None);
}
fn readArray(reader:&mut Reader,depth:Int)->Result<Option<Json>,JsonValueError> effects {} {
 let values=List<Json>();
 while true {
  match peek(reader){
   Err(error)=>{return Err(JsonValueError::Stream(error));},
   Ok(None)=>{return Ok(None);},
   Ok(Some(event))=>{
    match event {
     JsonStreamEvent::ArrayEnd(_)=>{
      match valueEvent(reader){Err(error)=>{return Err(error);},Ok(None)=>{return Ok(None);},Ok(Some(_))=>{return Ok(Some(Json::Array(freeze(values))));}}
     },
     _=>{
      if values.len()>=65536{return Err(JsonValueError::ContainerLimit(eventPosition(event)));}
      match readValue(reader,depth+1){
       Err(error)=>{return Err(error);},
       Ok(None)=>{return Ok(None);},
       Ok(Some(value))=>{values.add(value);}
      }
     }
    }
   }
  }
 }
 return Ok(None);
}
fn readValue(reader:&mut Reader,depth:Int)->Result<Option<Json>,JsonValueError> effects {} {
 match peek(reader){
  Err(error)=>{return Err(JsonValueError::Stream(error));},
  Ok(None)=>{return Ok(None);},
  Ok(Some(event))=>{
   let position=eventPosition(event);
   match event {
    JsonStreamEvent::ObjectStart(_)=>{
     if depth>=64{return Err(JsonValueError::DepthLimit(position));}
     match valueEvent(reader){Err(error)=>{return Err(error);},Ok(None)=>{return Ok(None);},Ok(Some(_))=>{}}
     return readObject(reader,depth);
    },
    JsonStreamEvent::ArrayStart(_)=>{
     if depth>=64{return Err(JsonValueError::DepthLimit(position));}
     match valueEvent(reader){Err(error)=>{return Err(error);},Ok(None)=>{return Ok(None);},Ok(Some(_))=>{}}
     return readArray(reader,depth);
    },
    JsonStreamEvent::Text(value,_)=>{
     match valueEvent(reader){Err(error)=>{return Err(error);},Ok(None)=>{return Ok(None);},Ok(Some(_))=>{return Ok(Some(Json::Text(value)));}}
    },
    JsonStreamEvent::Bool(value,_)=>{
     match valueEvent(reader){Err(error)=>{return Err(error);},Ok(None)=>{return Ok(None);},Ok(Some(_))=>{return Ok(Some(Json::Bool(value)));}}
    },
    JsonStreamEvent::Null(_)=>{
     match valueEvent(reader){Err(error)=>{return Err(error);},Ok(None)=>{return Ok(None);},Ok(Some(_))=>{return Ok(Some(Json::Null));}}
    },
    JsonStreamEvent::Number(raw,_)=>{
     match valueEvent(reader){Err(error)=>{return Err(error);},Ok(None)=>{return Ok(None);},Ok(Some(_))=>{}}
     match json.parse(raw){
      Err(error)=>{return Err(JsonValueError::InvalidNumber(error.code,error.offset));},
      Ok(value)=>{return Ok(Some(value));}
     }
    },
    _=>{return Err(JsonValueError::ExpectedValue(position));}
   }
  }
 }
}
// @api nextJson failure consumes one complete JSON value only after it has been materialized; incomplete input and failures preserve the queued events.
pub fn nextJson(reader:&mut Reader)->Result<Option<Json>,JsonValueError> effects {} {
 let trial=Reader(reader.state);
 match readValue(&mut trial,0){
  Err(error)=>{return Err(error);},
  Ok(None)=>{return Ok(None);},
  Ok(Some(value))=>{reader.state=trial.state;return Ok(Some(value));}
 }
}
// @api nextValidated failure consumes one complete value only after parsing and schema validation succeed; incomplete input and failures preserve the queued events.
pub fn nextValidated(reader:&mut Reader,rule:schema.Schema)->Result<Option<Json>,SchemaEventError> effects {} {
 let trial=Reader(reader.state);
 match readValue(&mut trial,0){
  Err(error)=>{return Err(SchemaEventError::Event(error));},
  Ok(None)=>{return Ok(None);},
  Ok(Some(value))=>{
   match schema.validate(rule,value){
    Err(error)=>{return Err(SchemaEventError::Validation(error));},
    Ok(checked)=>{reader.state=trial.state;return Ok(Some(checked));}
   }
  }
 }
}
