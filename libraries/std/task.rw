effects {tasks};
// @api yieldNow cost One scheduler handoff. Default choices rotate among ready tasks of the best priority; explicit recorded choices take precedence.
// @api yieldNow failure Only VM internal regions; forbidden in external regions and cleanup / guard execution. Does not wait for host input or allocate a new Task.
pub fn yieldNow()->Unit effects {tasks} {stdTaskYieldNow();}

// @api selectReady cost A cold scheduler action; starts both inputs when started. Constant metadata and no result copy.
// @api selectReady failure Reports completion (including failure or cancellation) with index 0/1; left wins an observed tie. Await the selected input to obtain its result. Cancelling this waiter leaves both inputs running.
pub fn selectReady<A,B>(left:Task<A>,right:Task<B>)->Task<Int> effects {tasks} {return left.selectReady(right);}
