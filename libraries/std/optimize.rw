import numeric as numeric;
pub struct Adam {private first:Map<String,FloatArray>,private second:Map<String,FloatArray>,private iteration:Int,private beta1:Float,private beta2:Float,private epsilon:Float}
fn validate(weights:&Map<String,FloatArray>,gradients:&Map<String,FloatArray>,rate:Float)->Result<Unit,StdError> effects {} {
 if !rate.isFinite() || rate<=0.0{return Err(StdError("OptimizerRate",0));}
 if weights.len()!=gradients.len(){return Err(StdError("OptimizerParameters",0));}
 stdNumericModelCheck(weights)?;stdNumericModelCheck(gradients)?;return Ok(());
}
fn find(values:&Map<String,FloatArray>,name:String)->Result<FloatArray,StdError> effects {} {match values.get(name){Some(v)=>{return Ok(v);},None=>{return Err(StdError("OptimizerParameters",0));}}}
// @api sgd cost O(parameters + elements) work/storage; native buffers, exact name/shape match, positive finite rate.
// @api sgd failure OptimizerRate/Parameters, NumericShape/Size/Domain/NonFinite/Overflow; fatal budgets apply. Inputs unchanged on error and success.
pub fn sgd(weights:&Map<String,FloatArray>,gradients:&Map<String,FloatArray>,rate:Float)->Result<Map<String,FloatArray>,StdError> effects {} {
 validate(weights,gradients,rate)?;let output=Map<String,FloatArray>();let names=weights.keys();
 for i in 0..names.len(){let name=names.get(i);let value=find(weights,name)?;let grad=find(gradients,name)?;let updated=stdNumericSgdStep(&value,&grad,rate)?;output.set(name,updated);}return Ok(move output);
}
// @api adam cost O(elements) moment initialization; beta1/beta2 in [0,1), finite epsilon>0; moments use native pages and support checkpoint/revert.
// @api adam failure OptimizerConfiguration or numeric validation failures; <=128 named finite Float64 parameters / <=32 MiB model.
pub fn adam(weights:&Map<String,FloatArray>,beta1:Float,beta2:Float,epsilon:Float)->Result<Adam,StdError> effects {} {
 if !beta1.isFinite() || !beta2.isFinite() || !epsilon.isFinite() || beta1<0.0 || beta1>=1.0 || beta2<0.0 || beta2>=1.0 || epsilon<=0.0{return Err(StdError("OptimizerConfiguration",0));}
 stdNumericModelCheck(weights)?;let first=Map<String,FloatArray>();let second=Map<String,FloatArray>();let names=weights.keys();
 for i in 0..names.len(){let name=names.get(i);let value=find(weights,name)?;let shape=numeric.shapeFloat(&value)?;let zero=numeric.zerosFloat(&shape)?;first.set(name,zero);second.set(name,zero);}
 return Ok(Adam(move first,move second,0,beta1,beta2,epsilon));
}
fn correction(beta:Float,iteration:Int)->Result<Float,StdError> effects {} {
 if beta==0.0{return Ok(1.0);}var exponent=0.0;match iteration.toFloatChecked(){Ok(n)=>{exponent=n;},Err(_)=>{return Err(StdError("OptimizerIterations",0));}}
 return Ok(-numeric.math("expM1",numeric.math("log",beta)?*exponent)?);
}
pub fn steps(state:&Adam)->Int effects {} {return state.iteration;}
// @api adamStep cost O(parameters + elements), several bounded native buffers; synchronous, maximum 2^53-1 steps. Keeps two moment arrays per parameter.
// @api adamStep failure OptimizerRate/Parameters/Iterations or NumericShape/Size/Domain/NonFinite/Overflow; typed failures leave state and input weights unchanged. Fatal VM failures require checkpoint recovery. Bias corrected Adam, epsilon outside sqrt.
pub fn adamStep(state:&mut Adam,weights:&Map<String,FloatArray>,gradients:&Map<String,FloatArray>,rate:Float)->Result<Map<String,FloatArray>,StdError> effects {} {
 validate(weights,gradients,rate)?;if state.iteration>=9007199254740991{return Err(StdError("OptimizerIterations",0));}
 if weights.len()!=state.first.len(){return Err(StdError("OptimizerParameters",0));}
 let iteration=state.iteration+1;let firstCorrection=correction(state.beta1,iteration)?;let secondCorrection=correction(state.beta2,iteration)?;
 let first=Map<String,FloatArray>();let second=Map<String,FloatArray>();let output=Map<String,FloatArray>();let names=weights.keys();
 for i in 0..names.len(){let name=names.get(i);let value=find(weights,name)?;let grad=find(gradients,name)?;let oldFirst=find(&state.first,name)?;let oldSecond=find(&state.second,name)?;
  let result=stdNumericAdamStep(&value,&grad,&oldFirst,&oldSecond,state.beta1,state.beta2,rate,state.epsilon,firstCorrection,secondCorrection)?;
  first.set(name,result._1);second.set(name,result._2);output.set(name,result._0);
 }
 state.first=move first;state.second=move second;state.iteration=iteration;return Ok(move output);
}
