import sort as sort;
pub fn reverse<T:Share>(values:&mut List<T>)->Unit effects {} {var l=0;var r=values.len();while l<r{r-=1;if l<r{let a=values.get(l);values.set(l,values.get(r));values.set(r,a);}l+=1;}}
pub fn rotate<T:Share>(values:&List<T>,offset:Int)->List<T> effects {} {let out=List<T>();let n=values.len();if n==0{return out;}var k=offset%n;if k<0{k+=n;}var i=0;while i<n{out.add(values.get((i+k)%n));i+=1;}return out;}
pub fn unique<T:Share>(values:&List<T>,compare:fn(T,T)->Int effects {} captures {Send,Share})->List<T> effects {} {let out=List<T>();var i=0;while i<values.len(){if out.len()==0{out.add(values.get(i));}else if compare(out.get(out.len()-1),values.get(i))!=0{out.add(values.get(i));}i+=1;}return out;}
pub fn compressed(values:&List<Int>)->List<Int> effects {} {let sorted=sort.integers(values);return unique(&sorted,|a:Int,b:Int|->Int{if a<b{return -1;}if a>b{return 1;}return 0;});}
pub fn prefix(values:&List<Int>)->Result<List<Int>,String> effects {} {let out=List<Int>();out.add(0);var total=0;var i=0;while i<values.len(){let x=values.get(i);if x>0 && total>9223372036854775807-x{return Err("Overflow");}if x<0 && total<(-9223372036854775807-1)-x{return Err("Overflow");}total+=x;out.add(total);i+=1;}return Ok(out);}
pub fn nextPermutation(values:&mut List<Int>)->Bool effects {} {if values.len()<2{return false;}var i=values.len()-2;while i>=0{if values.get(i)<values.get(i+1){break;}i-=1;}if i<0{reverse(values);return false;}var j=values.len()-1;while values.get(j)<=values.get(i){j-=1;}let t=values.get(i);values.set(i,values.get(j));values.set(j,t);var l=i+1;var r=values.len()-1;while l<r{let x=values.get(l);values.set(l,values.get(r));values.set(r,x);l+=1;r-=1;}return true;}
