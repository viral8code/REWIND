effects {tasks};
import sparse as sparse;
import numeric as numeric;
import task as task;
pub record SolveResult {solution:FloatArray,iterations:Int,residual:Float,converged:Bool}
// @api conjugateGradient cost O(iterations * (rows + nnz)); native buffers, yields between iterations, individual native calls remain synchronous.
// @api conjugateGradient failure NumericShape/Domain/NonFinite; positive tolerance, 1..100000 iterations; NumericDomain also reports underflow of the squared search residual, square symmetric positive-definite input required. No dense materialization; zero initial guess, residual is ||b-Ax||, convergence target tolerance * max(1,||b||). Returns converged=false on iteration exhaustion; fatal budgets/cancellation apply.
pub async fn conjugateGradient(matrix:sparse.Matrix,right:FloatArray,tolerance:Float,maxIterations:Int)->Result<SolveResult,StdError> effects {tasks} {
 if matrix.rows!=matrix.cols {return Err(StdError("NumericShape",0));}
 if !tolerance.isFinite() || tolerance<=0.0 || maxIterations<1 || maxIterations>100000 {return Err(StdError("NumericDomain",0));}
 let shape=numeric.shapeFloat(&right)?;
 if shape.len()!=1 || shape.get(0)!=matrix.rows {return Err(StdError("NumericShape",0));}
 var solution=numeric.zerosFloat(&shape)?;sparse.matvec(&matrix,&solution)?;var residual=right;var direction=residual;
 let bnorm=numeric.norm2(&residual)?;var target=tolerance;if bnorm>1.0 {target*=bnorm;}
 if !target.isFinite(){return Err(StdError("NumericOverflow",0));}
 if bnorm<=target{return Ok(SolveResult(solution,0,bnorm,true));}
 var squaredResidual=numeric.dot(&residual,&residual)?;if squaredResidual<=0.0{return Err(StdError("NumericDomain",0));}
 var iteration=0;
 while iteration<maxIterations {
  let product=sparse.matvec(&matrix,&direction)?;let denominator=numeric.dot(&direction,&product)?;
  if denominator<=0.0{return Err(StdError("NumericDomain",iteration));}
  let alpha=squaredResidual/denominator;if !alpha.isFinite(){return Err(StdError("NumericOverflow",iteration));}
  let step=numeric.scale(&direction,alpha)?;solution=numeric.zipFloat("add",&solution,&step)?;
  let change=numeric.scale(&product,alpha)?;residual=numeric.zipFloat("sub",&residual,&change)?;
  let next=numeric.dot(&residual,&residual)?;iteration+=1;let norm=numeric.norm2(&residual)?;if next<=0.0 && norm>target{return Err(StdError("NumericDomain",iteration));}
  if norm<=target {
   // Validate actual residual before claiming convergence, avoiding recurrence drift.
   let actualProduct=sparse.matvec(&matrix,&solution)?;residual=numeric.zipFloat("sub",&right,&actualProduct)?;
   squaredResidual=numeric.dot(&residual,&residual)?;let actual=numeric.norm2(&residual)?;
   if actual<=target{return Ok(SolveResult(solution,iteration,actual,true));}
   direction=residual;
  } else {let beta=next/squaredResidual;let scaled=numeric.scale(&direction,beta)?;direction=numeric.zipFloat("add",&residual,&scaled)?;squaredResidual=next;}
  task.yieldNow();
 }
 let product=sparse.matvec(&matrix,&solution)?;let error=numeric.zipFloat("sub",&right,&product)?;let finalNorm=numeric.norm2(&error)?;return Ok(SolveResult(solution,iteration,finalNorm,finalNorm<=target));
}
