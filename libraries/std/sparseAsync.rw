effects {tasks};
import sparse as sparse;
import numeric as numeric;
import task as task;
pub record SolveResult {solution:FloatArray,iterations:Int,residual:Float,converged:Bool}
// @api conjugateGradient cost O(iterations * (rows + cols + nnz) * log(max(rows,cols,nnz))); CSR validation/products and vector/norm/dot kernels yield after at most 4096 logical items; helpers share the current Task and native input pages.
// @api conjugateGradient failure NumericShape/Domain/NonFinite; positive tolerance, 1..100000 iterations; NumericDomain also reports underflow of the squared search residual, square symmetric positive-definite input required. No dense materialization; zero initial guess, residual is ||b-Ax||, convergence target tolerance * max(1,||b||). Returns converged=false on iteration exhaustion; fatal budgets/cancellation apply.
pub async fn conjugateGradient(matrix:sparse.Matrix,right:FloatArray,tolerance:Float,maxIterations:Int)->Result<SolveResult,StdError> effects {tasks} {
 if matrix.rows!=matrix.cols {return Err(StdError("NumericShape",0));}
 if !tolerance.isFinite() || tolerance<=0.0 || maxIterations<1 || maxIterations>100000 {return Err(StdError("NumericDomain",0));}
 let shape=numeric.shapeFloat(&right)?;
 if shape.len()!=1 || shape.get(0)!=matrix.rows {return Err(StdError("NumericShape",0));}
 var solution=numeric.zerosFloat(&shape)?;var initialWork=stdNumericSparseInit(matrix.rows,matrix.cols,&matrix.offsets,&matrix.indices,&matrix.values,&solution)?;while !stdNumericSparseDone(&initialWork)? {initialWork=stdNumericSparseStep(&initialWork)?;task.yieldNow();}stdNumericSparseResult(&initialWork)?;var residual=right;var direction=residual;
 let bnorm=cooperativeNorm(residual)?;var target=tolerance;if bnorm>1.0 {target*=bnorm;}
 if !target.isFinite(){return Err(StdError("NumericOverflow",0));}
 if bnorm<=target{return Ok(SolveResult(solution,0,bnorm,true));}
 var squaredResidual=cooperativeDot(residual,residual)?;if squaredResidual<=0.0{return Err(StdError("NumericDomain",0));}
 var iteration=0;
 while iteration<maxIterations {
  var directionWork=stdNumericSparseInit(matrix.rows,matrix.cols,&matrix.offsets,&matrix.indices,&matrix.values,&direction)?;while !stdNumericSparseDone(&directionWork)? {directionWork=stdNumericSparseStep(&directionWork)?;task.yieldNow();}let product=stdNumericSparseResult(&directionWork)?;let denominator=cooperativeDot(direction,product)?;
  if denominator<=0.0{return Err(StdError("NumericDomain",iteration));}
  let alpha=squaredResidual/denominator;if !alpha.isFinite(){return Err(StdError("NumericOverflow",iteration));}
  let step=cooperativeVector("scale",direction,direction,alpha)?;solution=cooperativeVector("add",solution,step,0.0)?;
  let change=cooperativeVector("scale",product,product,alpha)?;residual=cooperativeVector("sub",residual,change,0.0)?;
  let next=cooperativeDot(residual,residual)?;iteration+=1;let norm=cooperativeNorm(residual)?;if next<=0.0 && norm>target{return Err(StdError("NumericDomain",iteration));}
  if norm<=target {
   // Validate actual residual before claiming convergence, avoiding recurrence drift.
   var actualWork=stdNumericSparseInit(matrix.rows,matrix.cols,&matrix.offsets,&matrix.indices,&matrix.values,&solution)?;while !stdNumericSparseDone(&actualWork)? {actualWork=stdNumericSparseStep(&actualWork)?;task.yieldNow();}let actualProduct=stdNumericSparseResult(&actualWork)?;residual=cooperativeVector("sub",right,actualProduct,0.0)?;
   squaredResidual=cooperativeDot(residual,residual)?;let actual=cooperativeNorm(residual)?;
   if actual<=target{return Ok(SolveResult(solution,iteration,actual,true));}
   direction=residual;
  } else {let beta=next/squaredResidual;let scaled=cooperativeVector("scale",direction,direction,beta)?;direction=cooperativeVector("add",residual,scaled,0.0)?;squaredResidual=next;}
  task.yieldNow();
 }
 var finalWork=stdNumericSparseInit(matrix.rows,matrix.cols,&matrix.offsets,&matrix.indices,&matrix.values,&solution)?;while !stdNumericSparseDone(&finalWork)? {finalWork=stdNumericSparseStep(&finalWork)?;task.yieldNow();}let product=stdNumericSparseResult(&finalWork)?;let error=cooperativeVector("sub",right,product,0.0)?;let finalNorm=cooperativeNorm(error)?;return Ok(SolveResult(solution,iteration,finalNorm,finalNorm<=target));
}

// @api matvec cost O(cols log(cols) + (rows + nnz) log(max(rows,cols,nnz))) work; bounded 4096 input checks, entries or row completions per step. Shared CSR/right pages, O(rows) COW output; no nnz-sized temporary copy or host worker.
// @api matvec failure NumericShape/Type/Index/Size/NonFinite; canonical rank-one CSR and finite right values (including unused cells), compensated sums, same 2^20 size bound as sparse.matvec. Cancellation discards private partial output; retained task checkpoints preserve it.
pub async fn matvec(matrix:sparse.Matrix,right:FloatArray)->Result<FloatArray,StdError> effects {tasks} {
 var work=stdNumericSparseInit(matrix.rows,matrix.cols,&matrix.offsets,&matrix.indices,&matrix.values,&right)?;
 while !stdNumericSparseDone(&work)? {work=stdNumericSparseStep(&work)?;task.yieldNow();}
 return stdNumericSparseResult(&work);
}

fn cooperativeVector(operation:String,left:FloatArray,right:FloatArray,factor:Float)->Result<FloatArray,StdError> effects {tasks} {
 var output=stdNumericVectorInit(operation,&left,&right,factor)?;var cursor=0;
 while true {
  let step=stdNumericVectorStep(operation,&left,&right,&output,factor,cursor)?;
  output=step._0;cursor=step._1;if step._2 {return Ok(output);}task.yieldNow();
 }
 return Err(StdError("NumericState",0));
}
fn cooperativeNorm(array:FloatArray)->Result<Float,StdError> effects {tasks} {
 var cursor=0;var scale=0.0;var sum=1.0;
 while true {
  let step=stdNumericNormStep(&array,cursor,scale,sum)?;cursor=step._0;scale=step._1;sum=step._2;
  if step._4 {return Ok(step._3);}task.yieldNow();
 }
 return Err(StdError("NumericState",0));
}
fn cooperativeDot(left:FloatArray,right:FloatArray)->Result<Float,StdError> effects {tasks} {
 var cursor=0;var sum=0.0;var correction=0.0;
 while true {
  let step=stdNumericDotStep(&left,&right,cursor,sum,correction)?;cursor=step._0;sum=step._1;correction=step._2;
  if step._3 {return Ok(sum+correction);}task.yieldNow();
 }
 return Err(StdError("NumericState",0));
}

// From 1.9.31, vector arithmetic, norms and dot products in conjugateGradient also yield in bounded native steps, without spawning child tasks.
