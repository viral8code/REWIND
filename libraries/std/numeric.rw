// Typed, reversible numeric values. Views retain their own storage version.
// @api zerosFloat cost O(elements); typed pages, without per-element VM objects
// @api zerosFloat failure StdError NumericShape/Index/Size/Type/Overflow/NonFinite/Domain/Singular/Empty/ReadOnly; fatal execution and memory budgets apply.
pub fn zerosFloat(shape:&List<Int>)->Result<FloatArray,StdError> effects {} {return stdNumericZerosFloat(shape);}
// @api fromFloat cost O(elements); typed pages, without per-element VM objects
// @api fromFloat failure StdError NumericShape/Index/Size/Type/Overflow/NonFinite/Domain/Singular/Empty/ReadOnly; fatal execution and memory budgets apply.
pub fn fromFloat(shape:&List<Int>,values:&List<Float>)->Result<FloatArray,StdError> effects {} {return stdNumericFromFloat(shape,values);}
// @api shapeFloat cost O(rank + log pages); views share the storage version
