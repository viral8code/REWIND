pub fn histogram(array:&FloatArray,edges:&FloatArray)->Result<HistogramResult,StdError> effects {} {return stdNumericHistogram(array,edges);}
// Incremental Welford moments. Errors are validated before mutating the owner.
pub struct OnlineMoments{private count:Int,private mean:Float,private m2:Float}
fn countFloat(value:Int)->Result<Float,StdError> effects {} {match value.toFloatChecked(){Ok(value)=>{return Ok(value);},Err(_)=>{return Err(StdError("NumericOverflow",0));}}}
// @api onlineMoments cost O(1); checkpointed mutable owner with no retained sample list.
// @api onlineMoments failure Fatal VM allocation budget only.
pub fn onlineMoments()->OnlineMoments effects {} {return OnlineMoments(0,0.0,0.0);}
// @api onlineCount cost O(1).
// @api onlineCount failure No recoverable errors; fatal VM execution budget applies.
pub fn onlineCount(moments:&OnlineMoments)->Int effects {} {return moments.count;}
// @api onlineMean cost O(1).
// @api onlineMean failure StdError NumericEmpty; fatal VM execution budget applies.
pub fn onlineMean(moments:&OnlineMoments)->Result<Float,StdError> effects {} {if moments.count==0{return Err(StdError("NumericEmpty",0));}return Ok(moments.mean);}
// @api onlineVariance cost O(1); divisor is count - ddof.
// @api onlineVariance failure StdError NumericDomain/Empty; fatal VM execution budget applies.
pub fn onlineVariance(moments:&OnlineMoments,ddof:Int)->Result<Float,StdError> effects {} {
    if ddof<0{return Err(StdError("NumericDomain",0));}if moments.count<=ddof{return Err(StdError("NumericEmpty",0));}
    return Ok(moments.m2/countFloat(moments.count-ddof)?);
}
// @api pushMoment cost O(1); count bounded to 2^53, errors leave previous statistics unchanged.
// @api pushMoment failure StdError NumericSize/NonFinite; fatal VM execution and allocation budgets apply.
pub fn pushMoment(moments:&mut OnlineMoments,value:Float)->Result<Unit,StdError> effects {} {
    stdNumericMath("abs",value)?;if moments.count>=9007199254740992{return Err(StdError("NumericSize",0));}
    let count=moments.count+1;let delta=value-moments.mean;let mean=moments.mean+delta/countFloat(count)?;
    let m2=moments.m2+delta*(value-mean);stdNumericMath("abs",mean)?;stdNumericMath("abs",m2)?;
    moments.count=count;moments.mean=mean;moments.m2=m2;return Ok(());
}
// @api mergeMoments cost O(1); combines independent owners without retaining their samples.
// @api mergeMoments failure StdError NumericSize/NonFinite; fatal VM execution and allocation budgets apply.
pub fn mergeMoments(target:&mut OnlineMoments,source:&OnlineMoments)->Result<Unit,StdError> effects {} {
    if source.count==0{return Ok(());}
    if target.count==0{target.count=source.count;target.mean=source.mean;target.m2=source.m2;return Ok(());}
    let count=target.count+source.count;
    if count>9007199254740992{return Err(StdError("NumericSize",0));}
    let n=countFloat(count)?;let left=countFloat(target.count)?;let right=countFloat(source.count)?;
    let delta=source.mean-target.mean;let mean=target.mean+delta*(right/n);
    let m2=target.m2+source.m2+(delta*left)*(delta*(right/n));
    stdNumericMath("abs",mean)?;stdNumericMath("abs",m2)?;
    target.count=count;target.mean=mean;target.m2=m2;return Ok(());
}
