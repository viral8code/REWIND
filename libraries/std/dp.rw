import integer as integer;
pub fn lisLength(input:&List<Int>)->Result<Int,String> effects {} {if input.len()>65536{return Err("Capacity");}let tails=List<Int>();var i=0;while i<input.len(){let value=input.get(i);var left=0;var right=tails.len();while left<right{let middle=(left+right)/2;if tails.get(middle)<value{left=middle+1;}else{right=middle;}}if left==tails.len(){tails.add(value);}else{tails.set(left,value);}i+=1;}return Ok(tails.len());}
pub fn knapsack(weights:&List<Int>,values:&List<Int>,capacity:Int)->Result<Int,String> effects {} {if capacity<0 || capacity>65536 || weights.len()>4096{return Err("Capacity");}if weights.len()!=values.len(){return Err("Dimension");}var i=0;while i<weights.len(){if weights.get(i)<0{return Err("Weight");}i+=1;}let best=List<Int>();i=0;while i<=capacity{best.add(0);i+=1;}i=0;while i<weights.len(){let weight=weights.get(i);let value=values.get(i);var c=capacity;while c>=weight{let candidate=integer.add(best.get(c-weight),value)?;if candidate>best.get(c){best.set(c,candidate);}c-=1;}i+=1;}return Ok(best.get(capacity));}
