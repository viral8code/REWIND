// Positions own the immutable text they refer to. Numeric extraction is explicit.
pub record IndexError {code:String,offset:Int}
pub record Source {
    private text:String,
    private encoded:Bytes,
    private scalars:Frozen<List<Int>>,
    private graphemes:Frozen<List<Int>>
}
pub record ByteOffset {private source:Source,private offset:Int}
pub record ScalarIndex {private source:Source,private index:Int}
pub record GraphemeIndex {private source:Source,private index:Int}

fn octet(input:Bytes,offset:Int)->Int effects {} {
    match stdBytesGet(input,offset) {Ok(value)=>{return value;},Err(_)=>{panic("text index invariant");}}
}

// @api create cost Indexes valid String data, at most 1 MiB and 65535 scalars. Uses the existing Unicode grapheme implementation.
pub fn create(text:String)->Result<Source,IndexError> effects {} {
    match stdEncode(text) {
        Err(e)=>{return Err(IndexError(e.code,e.offset));},
        Ok(encoded)=>{
            let size=stdBytesLength(encoded);
            if size>1048576 {return Err(IndexError("InputLimit",size));}
            let scalars=List<Int>();scalars.add(0);var cursor=0;
            while cursor<size {
                if scalars.len()==65536 {return Err(IndexError("ScalarLimit",cursor));}
                let lead=octet(encoded,cursor);
                if lead<128 {cursor+=1;}
                else if lead<224 {cursor+=2;}
                else if lead<240 {cursor+=3;}
                else {cursor+=4;}
                scalars.add(cursor);
            }
            match stdUnicodeOffsets(&text) {
                Err(e)=>{return Err(IndexError(e.code,e.offset));},
                Ok(graphemes)=>{return Ok(Source(text,encoded,freeze(scalars),freeze(graphemes)));}
            }
        }
    }
}

pub fn text(source:Source)->String effects {} {return source.text;}
pub fn bytes(source:Source)->Bytes effects {} {return source.encoded;}
pub fn byteLength(source:Source)->Int effects {} {return stdBytesLength(source.encoded);}
pub fn scalarLength(source:Source)->Int effects {} {return source.scalars.len()-1;}
pub fn graphemeLength(source:Source)->Int effects {} {return source.graphemes.len()-1;}

pub fn byteAt(source:Source,offset:Int)->Result<ByteOffset,IndexError> effects {} {
    if offset<0 || offset>byteLength(source) {return Err(IndexError("ByteRange",offset));}
    return Ok(ByteOffset(source,offset));
}
pub fn scalarAt(source:Source,index:Int)->Result<ScalarIndex,IndexError> effects {} {
    if index<0 || index>scalarLength(source) {return Err(IndexError("ScalarRange",index));}
    return Ok(ScalarIndex(source,index));
}
pub fn graphemeAt(source:Source,index:Int)->Result<GraphemeIndex,IndexError> effects {} {
    if index<0 || index>graphemeLength(source) {return Err(IndexError("GraphemeRange",index));}
    return Ok(GraphemeIndex(source,index));
}

pub fn byteValue(position:ByteOffset)->Int effects {} {return position.offset;}
pub fn scalarValue(position:ScalarIndex)->Int effects {} {return position.index;}
pub fn graphemeValue(position:GraphemeIndex)->Int effects {} {return position.index;}
pub fn byteSource(position:ByteOffset)->Source effects {} {return position.source;}
pub fn scalarSource(position:ScalarIndex)->Source effects {} {return position.source;}
pub fn graphemeSource(position:GraphemeIndex)->Source effects {} {return position.source;}

pub fn scalarToByte(position:ScalarIndex)->ByteOffset effects {} {
    return ByteOffset(position.source,position.source.scalars.get(position.index));
}
pub fn graphemeToByte(position:GraphemeIndex)->ByteOffset effects {} {
    return ByteOffset(position.source,position.source.graphemes.get(position.index));
}

fn boundary(offsets:Frozen<List<Int>>,offset:Int)->Option<Int> effects {} {
    var low=0;var high=offsets.len();
    while low<high {
        let middle=low+(high-low)/2;
        if offsets.get(middle)<offset {low=middle+1;}else {high=middle;}
    }
    if low<offsets.len() {if offsets.get(low)==offset {return Some(low);}}
    return None;
}

// @api byteToScalar failure Rejects byte positions inside a UTF-8 scalar; the terminal position is valid.
pub fn byteToScalar(position:ByteOffset)->Result<ScalarIndex,IndexError> effects {} {
    match boundary(position.source.scalars,position.offset) {
        Some(index)=>{return Ok(ScalarIndex(position.source,index));},
        None=>{return Err(IndexError("ScalarBoundary",position.offset));}
    }
}
// @api byteToGrapheme failure Rejects positions inside a grapheme, including between combining scalars or CR and LF.
pub fn byteToGrapheme(position:ByteOffset)->Result<GraphemeIndex,IndexError> effects {} {
    match boundary(position.source.graphemes,position.offset) {
        Some(index)=>{return Ok(GraphemeIndex(position.source,index));},
        None=>{return Err(IndexError("GraphemeBoundary",position.offset));}
    }
}

// @api sliceBytes cost Requires equal original text content and an ordered half-open range. Numeric offsets are never applied to different text implicitly.
pub fn sliceBytes(start:ByteOffset,end:ByteOffset)->Result<Bytes,IndexError> effects {} {
    if start.source.text!=end.source.text {return Err(IndexError("TextMismatch",end.offset));}
    if end.offset<start.offset {return Err(IndexError("Range",end.offset));}
    match stdBytesSlice(start.source.encoded,start.offset,end.offset) {
        Ok(value)=>{return Ok(value);},Err(e)=>{return Err(IndexError(e.code,e.offset));}
    }
}
pub fn sliceScalars(start:ScalarIndex,end:ScalarIndex)->Result<String,IndexError> effects {} {
    match sliceBytes(scalarToByte(start),scalarToByte(end)) {
        Err(e)=>{return Err(e);},
        Ok(value)=>{match stdDecode(value) {Ok(result)=>{return Ok(result);},Err(e)=>{return Err(IndexError(e.code,e.offset));}}}
    }
}
pub fn sliceGraphemes(start:GraphemeIndex,end:GraphemeIndex)->Result<String,IndexError> effects {} {
    match sliceBytes(graphemeToByte(start),graphemeToByte(end)) {
        Err(e)=>{return Err(e);},
        Ok(value)=>{match stdDecode(value) {Ok(result)=>{return Ok(result);},Err(e)=>{return Err(IndexError(e.code,e.offset));}}}
    }
}
