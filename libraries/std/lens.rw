// Pure typed access paths over Share values. Callbacks retain their normal visibility and effect restrictions.
pub record Lens<R:Share,V:Share,E:Share> {
    private read:fn(R)->V effects {} captures {Send,Share},
    private write:fn(R,V)->Result<R,E> effects {} captures {Send,Share}
}
pub record OptionalLens<R:Share,V:Share,E:Share> {
    private read:fn(R)->Option<V> effects {} captures {Send,Share},
    private write:fn(R,V)->Result<Option<R>,E> effects {} captures {Send,Share}
}
pub record Change<R:Share,V:Share,E:Share> {private path:Lens<R,V,E>,private before:V,private after:V}
pub record ApplyError<E:Share> {code:String,cause:Option<E>}
pub record LawReport {getPut:Bool,putGet:Bool,putPut:Bool}

pub fn create<R:Share,V:Share,E:Share>(read:fn(R)->V effects {} captures {Send,Share},write:fn(R,V)->Result<R,E> effects {} captures {Send,Share})->Lens<R,V,E> effects {} {
    return Lens<R,V,E>(read,write);
}
pub fn get<R:Share,V:Share,E:Share>(path:Lens<R,V,E>,root:R)->V effects {} {let read=path.read;return read(root);}
pub fn set<R:Share,V:Share,E:Share>(path:Lens<R,V,E>,root:R,value:V)->Result<R,E> effects {} {let write=path.write;return write(root,value);}
pub fn modify<R:Share,V:Share,E:Share>(path:Lens<R,V,E>,root:R,transform:fn(V)->Result<V,E> effects {} captures {Send,Share})->Result<R,E> effects {} {
    match transform(get(path,root)) {Ok(value)=>{return set(path,root,value);},Err(error)=>{return Err(error);}}
}

// @api compose failure Reads the outer focus once for each get/set; inner rejection prevents the outer setter from running.
pub fn compose<R:Share,M:Share,V:Share,E:Share>(outer:Lens<R,M,E>,inner:Lens<M,V,E>)->Lens<R,V,E> effects {} {
    return Lens<R,V,E>(
        |root:R|->V{return get(inner,get(outer,root));},
        |root:R,value:V|->Result<R,E>{
            let middle=get(outer,root);
            match set(inner,middle,value) {Ok(updated)=>{return set(outer,root,updated);},Err(error)=>{return Err(error);}}
        }
    );
}

pub fn optional<R:Share,V:Share,E:Share>(read:fn(R)->Option<V> effects {} captures {Send,Share},write:fn(R,V)->Result<Option<R>,E> effects {} captures {Send,Share})->OptionalLens<R,V,E> effects {} {
    return OptionalLens<R,V,E>(read,write);
}
pub fn preview<R:Share,V:Share,E:Share>(path:OptionalLens<R,V,E>,root:R)->Option<V> effects {} {let read=path.read;return read(root);}
// @api setIfPresent failure Does not call the setter for a missing focus and never automatically creates an intermediate value.
pub fn setIfPresent<R:Share,V:Share,E:Share>(path:OptionalLens<R,V,E>,root:R,value:V)->Result<Option<R>,E> effects {} {
    match preview(path,root) {
        None=>{return Ok(None);},
        Some(_)=>{let write=path.write;return write(root,value);}
    }
}
pub fn modifyIfPresent<R:Share,V:Share,E:Share>(path:OptionalLens<R,V,E>,root:R,transform:fn(V)->Result<V,E> effects {} captures {Send,Share})->Result<Option<R>,E> effects {} {
    match preview(path,root) {
        None=>{return Ok(None);},
        Some(value)=>{
            match transform(value) {
                Err(error)=>{return Err(error);},
                Ok(updated)=>{let write=path.write;return write(root,updated);}
            }
        }
    }
}
pub fn composeOptional<R:Share,M:Share,V:Share,E:Share>(outer:OptionalLens<R,M,E>,inner:OptionalLens<M,V,E>)->OptionalLens<R,V,E> effects {} {
    return OptionalLens<R,V,E>(
        |root:R|->Option<V>{
            match preview(outer,root) {Some(middle)=>{return preview(inner,middle);},None=>{return None;}}
        },
        |root:R,value:V|->Result<Option<R>,E>{
            match preview(outer,root) {
                None=>{return Ok(None);},
                Some(middle)=>{
                    match setIfPresent(inner,middle,value) {
                        Err(error)=>{return Err(error);},
                        Ok(updated)=>{
                            match updated {None=>{return Ok(None);},Some(next)=>{return setIfPresent(outer,root,next);}}
                        }
                    }
                }
            }
        }
    );
}
pub fn asOptional<R:Share,V:Share,E:Share>(path:Lens<R,V,E>)->OptionalLens<R,V,E> effects {} {
    return OptionalLens<R,V,E>(
        |root:R|->Option<V>{return Some(get(path,root));},
        |root:R,value:V|->Result<Option<R>,E>{
            match set(path,root,value) {Ok(updated)=>{return Ok(Some(updated));},Err(error)=>{return Err(error);}}
        }
    );
}

// @api plan failure Captures only the focused before/after values and path; unrelated root fields are not preconditions.
pub fn plan<R:Share,V:Share,E:Share>(path:Lens<R,V,E>,root:R,value:V)->Change<R,V,E> effects {} {return Change<R,V,E>(path,get(path,root),value);}
pub fn before<R:Share,V:Share,E:Share>(change:Change<R,V,E>)->V effects {} {return change.before;}
pub fn after<R:Share,V:Share,E:Share>(change:Change<R,V,E>)->V effects {} {return change.after;}
pub fn inverse<R:Share,V:Share,E:Share>(change:Change<R,V,E>)->Change<R,V,E> effects {} {return Change<R,V,E>(change.path,change.after,change.before);}
pub fn apply<R:Share,V:Share,E:Share>(change:Change<R,V,E>,root:R,same:fn(V,V)->Bool effects {} captures {Send,Share})->Result<R,ApplyError<E>> effects {} {
    if !same(get(change.path,root),change.before) {return Err(ApplyError<E>("Conflict",None));}
    match set(change.path,root,change.after) {
        Ok(updated)=>{return Ok(updated);},
        Err(error)=>{return Err(ApplyError<E>("Rejected",Some(error)));}
    }
}

// @api checkLaws failure Checks get-put, put-get and put-put on the supplied sample only; does not prove laws for every root or accepted value.
pub fn checkLaws<R:Share,V:Share,E:Share>(path:Lens<R,V,E>,root:R,first:V,second:V,sameRoot:fn(R,R)->Bool effects {} captures {Send,Share},sameValue:fn(V,V)->Bool effects {} captures {Send,Share})->Result<LawReport,E> effects {} {
    let reset=set(path,root,get(path,root))?;
    let once=set(path,root,first)?;
    let repeated=set(path,once,second)?;
    let direct=set(path,root,second)?;
    return Ok(LawReport(sameRoot(reset,root),sameValue(get(path,once),first),sameRoot(repeated,direct)));
}
