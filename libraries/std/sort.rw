// Bottom-up stable merge sort. Comparison callbacks return negative/zero/positive.
pub fn stable<T:Share>(input:&List<T>,compare:fn(T,T)->Int effects {} captures {Send,Share})->List<T> effects {} {
    var a=List<T>();var i=0;while i<input.len(){a.add(input.get(i));i+=1;}
    var width=1;while width<a.len(){let b=List<T>();var start=0;
        while start<a.len(){var middle=start+width;if middle>a.len(){middle=a.len();}var end=middle+width;if end>a.len(){end=a.len();}var l=start;var r=middle;
            while l<middle || r<end {if r==end {b.add(a.get(l));l+=1;}else if l==middle {b.add(a.get(r));r+=1;}else if compare(a.get(l),a.get(r))<=0 {b.add(a.get(l));l+=1;}else{b.add(a.get(r));r+=1;}}
            start=end;
        }a=move b;width*=2;
    }return a;
}
pub fn inPlace<T:Share>(input:&mut List<T>,compare:fn(T,T)->Int effects {} captures {Send,Share})->Unit effects {} {
    let sorted=stable(&input,compare);var i=0;while i<input.len(){input.set(i,sorted.get(i));i+=1;}
}
pub fn integers(input:&List<Int>)->List<Int> effects {} {return stable(input,|a:Int,b:Int|->Int{if a<b{return -1;}if a>b{return 1;}return 0;});}

// @api tryStable cost O(n log n) comparisons and temporary elements; caller work budget applies.
// @api tryStable failure First callback Err(E) is returned; borrowed input is unchanged, including on fatal budget failure.
pub fn tryStable<T:Share,E:Share>(input:&List<T>,compare:fn(T,T)->Result<Int,E> effects {} captures {Send,Share} )->Result<List<T>,E> effects {} {
    var a=List<T>();var i=0;while i<input.len(){a.add(input.get(i));i+=1;}
    var width=1;while width<a.len(){let b=List<T>();var start=0;
        while start<a.len(){var middle=start+width;if middle>a.len(){middle=a.len();}var end=middle+width;if end>a.len(){end=a.len();}var l=start;var r=middle;
            while l<middle || r<end {if r==end {b.add(a.get(l));l+=1;}else if l==middle {b.add(a.get(r));r+=1;}else if compare(a.get(l),a.get(r))?<=0 {b.add(a.get(l));l+=1;}else{b.add(a.get(r));r+=1;}}
            start=end;
        }a=move b;width*=2;
    }return Ok(a);
}
