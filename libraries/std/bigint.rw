// Immutable native arbitrary-precision integers. Existing Int is unchanged.
// @api parse cost native work is precharged from input/output size; quadratic kernels and powers have additional work.
// @api parse failure StdError BigIntSyntax/Radix/Size/Domain/Overflow/DivisionByZero/JsonType; fatal VM work and memory budgets apply.
pub fn parse(value:String,radix:Int)->Result<BigInt,StdError> effects {} {return stdBigIntParse(value,radix);}
