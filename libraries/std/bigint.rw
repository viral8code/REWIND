// Exact JSON representation is a decimal string, never a binary64 number.
// @api toJson cost native work is precharged from input/output size; quadratic kernels and powers have additional work.
// @api toJson failure StdError BigIntSyntax/Radix/Size/Domain/Overflow/DivisionByZero/JsonType; fatal VM work and memory budgets apply.
pub fn toJson(value:&BigInt)->Result<Json,StdError> effects {} {match format(value,10){Ok(text)=>{return Ok(Json::Text(text));},Err(error)=>{return Err(error);}}}
// @api fromJson cost native work is precharged from input/output size; quadratic kernels and powers have additional work.
// @api fromJson failure StdError BigIntSyntax/Radix/Size/Domain/Overflow/DivisionByZero/JsonType; fatal VM work and memory budgets apply.
pub fn fromJson(value:Json)->Result<BigInt,StdError> effects {} {match move value{Json::Text(text)=>{return parse(text,10);},_=>{return Err(StdError("BigIntJsonType",0));}}}
