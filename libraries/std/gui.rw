effects {gui};
pub type GuiError = StdError;
pub record Event {kind:String,x:Int,y:Int,key:String,width:Int,height:Int}
pub enum Action {Activate(String),Changed(String,Bool),Key(String,String),Resize(Int,Int),Close}
record Widget {id:String,kind:String,x:Int,y:Int,width:Int,height:Int,caption:String,foreground:Int,background:Int,enabled:Bool,checked:Bool,cursor:Int,anchor:Int}
pub struct View {private title:String,private width:Int,private height:Int,private background:Int,private widgets:List<Widget>,private indices:Map<String,Int>,private focus:Int,private scroll:Map<String,Int>,private grapheme:Bool}
// @api window failure InvalidSize/InvalidTitle; 64..4096 client pixels per axis.
pub fn window(title:String,width:Int,height:Int)->Result<View,GuiError> effects {} {
 if width<64 || width>4096 || height<64 || height>4096{return Err(StdError("GuiInvalidSize",0));}
 if title.byteLen()>1024 || stdTextFind(title,"\0")!=None{return Err(StdError("GuiInvalidTitle",0));}
 return Ok(View(title,width,height,0xffffff,List<Widget>(),Map<String,Int>(),-1,Map<String,Int>(),false));
}
fn add(view:&mut View,id:String,kind:String,caption:String,x:Int,y:Int,width:Int,height:Int,color:Int,checked:Bool)->Result<Unit,GuiError> effects {} {
 if view.widgets.len()>=2048{return Err(StdError("GuiWidgetLimit",0));}
 if id=="" || id.byteLen()>128 || stdTextFind(id,"\0")!=None{return Err(StdError("GuiInvalidId",0));}
 if view.indices.get(id)!=None{return Err(StdError("GuiDuplicateId",0));}
 if caption.byteLen()>4096 || stdTextFind(caption,"\0")!=None{return Err(StdError("GuiInvalidText",0));}
 if x<0 || y<0 || width<1 || height<1 || x>4096 || y>4096 || width>4096 || height>4096 || x+width>view.width || y+height>view.height{return Err(StdError("GuiInvalidBounds",0));}
 if color<0 || color>0xffffff{return Err(StdError("GuiInvalidColor",0));}
 view.indices.set(id,view.widgets.len());view.widgets.add(Widget(id,kind,x,y,width,height,caption,0x111827,color,true,checked,0,0));return Ok(());
}
pub fn label(view:&mut View,id:String,caption:String,x:Int,y:Int,width:Int,height:Int)->Result<Unit,GuiError> effects {} {return add(view,id,"label",caption,x,y,width,height,0xffffff,false);}
pub fn button(view:&mut View,id:String,caption:String,x:Int,y:Int,width:Int,height:Int)->Result<Unit,GuiError> effects {} {return add(view,id,"button",caption,x,y,width,height,0xe5e7eb,false);}
pub fn checkbox(view:&mut View,id:String,caption:String,checked:Bool,x:Int,y:Int,width:Int,height:Int)->Result<Unit,GuiError> effects {} {return add(view,id,"checkbox",caption,x,y,width,height,0xf3f4f6,checked);}
pub fn rectangle(view:&mut View,id:String,x:Int,y:Int,width:Int,height:Int,color:Int)->Result<Unit,GuiError> effects {} {return add(view,id,"rect","",x,y,width,height,color,false);}
pub fn background(view:&mut View,color:Int)->Result<Unit,GuiError> effects {} {if color<0 || color>0xffffff{return Err(StdError("GuiInvalidColor",0));}view.background=color;return Ok(());}
pub fn setText(view:&mut View,id:String,caption:String)->Result<Unit,GuiError> effects {} {
 if caption.byteLen()>4096 || stdTextFind(caption,"\0")!=None{return Err(StdError("GuiInvalidText",0));}
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,caption,w.foreground,w.background,w.enabled,w.checked,caption.charLen(),caption.charLen()));}}
 return Ok(());
}
pub fn text(view:&View,id:String)->Result<String,GuiError> effects {} {match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{return Ok(view.widgets.get(i).caption);}}}
pub fn checked(view:&View,id:String)->Result<Bool,GuiError> effects {} {match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);if w.kind!="checkbox"{return Err(StdError("GuiNotCheckbox",0));}return Ok(w.checked);}}}
pub fn setEnabled(view:&mut View,id:String,enabled:Bool)->Result<Unit,GuiError> effects {} {match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,w.caption,w.foreground,w.background,enabled,w.checked,w.cursor,w.anchor));}}return Ok(());}
fn interactive(w:Widget)->Bool effects {} {return w.enabled && (w.kind=="button" || w.kind=="checkbox" || w.kind=="textbox" || w.kind=="textarea");}
fn activate(view:&mut View,i:Int)->Option<Action> effects {} {
 let w=view.widgets.get(i);if !interactive(w){return None;}view.focus=i;
 if w.kind=="checkbox"{view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,w.caption,w.foreground,w.background,w.enabled,!w.checked,w.cursor,w.anchor));return Some(Action::Changed(w.id,!w.checked));}
 if w.kind=="textbox" || w.kind=="textarea"{return Some(Action::Key(w.id,"Focus"));}return Some(Action::Activate(w.id));
}
// @api dispatch cost Pointer scans in reverse draw order, at most 2048 widgets; Tab traverses controls.
pub fn dispatch(view:&mut View,event:Event)->Option<Action> effects {} {
 if event.kind=="close"{return Some(Action::Close);}
 if event.kind=="resize"{return Some(Action::Resize(event.width,event.height));}
 if event.kind=="pointer"{var i=view.widgets.len();while i>0{i-=1;let w=view.widgets.get(i);if interactive(w) && event.x>=w.x && event.x<w.x+w.width && event.y>=w.y && event.y<w.y+w.height{return activate(view,i);}}return None;}
 if event.kind=="wheel" && view.focus>=0 {let w=view.widgets.get(view.focus);if w.enabled && w.kind=="textarea" {var position=0;match view.scroll.get(w.id){Some(n)=>{position=n;},None=>{}}let last=w.caption.split("\n").len()-1;if position>last{position=last;}if event.y>0{if event.y>last-position{position=last;}else{position+=event.y;}}else{if event.y< -position{position=0;}else{position+=event.y;}}view.scroll.set(w.id,position);return Some(Action::Key(w.id,"Scroll"));}}
 if (event.kind=="key" || event.kind=="text") && view.focus>=0 {let w=view.widgets.get(view.focus);if w.enabled && (w.kind=="textbox" || w.kind=="textarea") && event.key!="Tab" {
 match edit(view,w.id,event){Ok(_)=>{return Some(Action::Key(w.id,"TextChanged"));},Err(e)=>{return Some(Action::Key(w.id,e.code));}}
 }}
 if event.kind=="key" || event.kind=="text"{
  if event.key=="Tab"{let count=view.widgets.len();if count==0{return None;}var n=0;var i=view.focus;while n<count{i=(i+1)%count;if interactive(view.widgets.get(i)){view.focus=i;return None;}n+=1;}return None;}
  if view.focus>=0 && interactive(view.widgets.get(view.focus)){if event.key=="Enter" || event.key=="Space"{return activate(view,view.focus);}return Some(Action::Key(view.widgets.get(view.focus).id,event.key));}
 }
 return None;
}
// @api scene cost O(widget count + caption bytes); serialized scene at most 1 MiB.
pub fn scene(view:&View)->Result<String,GuiError> effects {} {return stdGuiScene(view.title,view.width,view.height,view.background,&view.widgets,view.focus,&view.scroll);}
// @api present failure Queues a scene; publish may fail with GuiUnavailable or PublishPartiallyApplied.
pub fn present(view:&View)->Result<Unit,GuiError> effects {gui} {return stdGuiStage(scene(view)?);}
fn integer(value:Json,key:String)->Int effects {} {match jsonGet(value,key){Some(Json::Int(v))=>{return v;},_=>{return 0;}}}
fn string(value:Json,key:String)->String effects {} {match jsonGet(value,key){Some(Json::Text(v))=>{return v;},_=>{return "";}}}
// @api nextEvent failure GUI must be published first; input is journaled, blocking, and replayable.
pub fn nextEvent()->Result<Event,GuiError> effects {gui} {
 let caption=stdGuiNextEvent()?;
 match jsonParse(caption){Err(e)=>{return Err(StdError(e.code,e.offset));},Ok(j)=>{return Ok(Event(string(j,"kind"),integer(j,"x"),integer(j,"y"),string(j,"key"),integer(j,"width"),integer(j,"height")));}}
}
pub fn close()->Result<Unit,GuiError> effects {gui} {return stdGuiClose();}

// @api continueInput failure After revert, skips only events already delivered in this execution, including during replay.
pub fn continueInput()->Unit effects {gui} {stdGuiContinueInput();}

// @api textBox failure Single-line editing with Unicode-scalar selection; 4096 UTF-8 bytes.
pub fn textBox(view:&mut View,id:String,caption:String,x:Int,y:Int,width:Int,height:Int)->Result<Unit,GuiError> effects {} {if stdTextFind(caption,"\n")!=None || stdTextFind(caption,"\r")!=None{return Err(StdError("GuiSingleLine",0));}return add(view,id,"textbox",caption,x,y,width,height,0xffffff,false);}
pub fn textArea(view:&mut View,id:String,caption:String,x:Int,y:Int,width:Int,height:Int)->Result<Unit,GuiError> effects {} {return add(view,id,"textarea",caption,x,y,width,height,0xffffff,false);}
pub fn selection(view:&View,id:String)->Result<Tuple<Int,Int>,GuiError> effects {} {match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);return Ok((w.cursor,w.anchor));}}}
pub fn setSelection(view:&mut View,id:String,cursor:Int,anchor:Int)->Result<Unit,GuiError> effects {} {match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);if cursor<0 || anchor<0 || cursor>w.caption.charLen() || anchor>w.caption.charLen(){return Err(StdError("GuiInvalidSelection",0));}if view.grapheme && (w.kind=="textbox" || w.kind=="textarea"){stdGuiEditGrapheme(w.caption,cursor,anchor,"Validate","",w.kind=="textarea")?;}view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,w.caption,w.foreground,w.background,w.enabled,w.checked,cursor,anchor));}}return Ok(());}
pub fn edit(view:&mut View,id:String,event:Event)->Result<Unit,GuiError> effects {} {
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);if w.kind!="textbox" && w.kind!="textarea"{return Err(StdError("GuiNotTextInput",0));}var typed="";var key=event.key;if event.kind=="text"{typed=event.key;key="";}
 var result="";if view.grapheme{result=stdGuiEditGrapheme(w.caption,w.cursor,w.anchor,key,typed,w.kind=="textarea")?;}else{result=stdGuiEdit(w.caption,w.cursor,w.anchor,key,typed,w.kind=="textarea")?;}
 match jsonParse(result){Err(e)=>{return Err(StdError(e.code,e.offset));},Ok(j)=>{view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,string(j,"text"),w.foreground,w.background,w.enabled,w.checked,integer(j,"cursor"),integer(j,"anchor")));var scroll=0;match view.scroll.get(w.id){Some(n)=>{scroll=n;},None=>{}}let line=integer(j,"line");var rows=w.height/18;if rows<1{rows=1;}if line<scroll{scroll=line;}if line>=scroll+rows{scroll=line-rows+1;}view.scroll.set(w.id,scroll);}}
 }}return Ok(());
}
pub record Rect {x:Int,y:Int,width:Int,height:Int}
pub fn resize(view:&mut View,width:Int,height:Int)->Result<Unit,GuiError> effects {} {if width<64 || width>4096 || height<64 || height>4096{return Err(StdError("GuiInvalidSize",0));}view.width=width;view.height=height;return Ok(());}
// @api arrange cost O(ids); prevalidates geometry and IDs before mutating the view.
pub fn arrange(view:&mut View,ids:&List<String>,bounds:Rect,columns:Int,gap:Int)->Result<Unit,GuiError> effects {} {
 let n=ids.len();if n==0{return Ok(());}if n>2048 || columns<1 || columns>n || gap<0 || gap>4096 || bounds.x<0 || bounds.y<0 || bounds.width<1 || bounds.height<1 || bounds.width>4096 || bounds.height>4096 || bounds.x>4096 || bounds.y>4096 || bounds.x+bounds.width>view.width || bounds.y+bounds.height>view.height{return Err(StdError("GuiInvalidBounds",0));}
 let rows=(n+columns-1)/columns;let width=(bounds.width-gap*(columns-1))/columns;let height=(bounds.height-gap*(rows-1))/rows;if width<1 || height<1{return Err(StdError("GuiInvalidBounds",0));}
 let seen=Map<String,Bool>();for i in 0..n{let id=ids.get(i);if view.indices.get(id)==None{return Err(StdError("GuiUnknownId",0));}if seen.get(id)!=None{return Err(StdError("GuiDuplicateId",0));}seen.set(id,true);}
 for i in 0..n{match view.indices.get(ids.get(i)){None=>{},Some(index)=>{let w=view.widgets.get(index);view.widgets.set(index,Widget(w.id,w.kind,bounds.x+(i%columns)*(width+gap),bounds.y+(i/columns)*(height+gap),width,height,w.caption,w.foreground,w.background,w.enabled,w.checked,w.cursor,w.anchor));}}}return Ok(());
}
pub fn pollEvent()->Result<Option<Event>,GuiError> effects {gui} {
 match stdGuiPollEvent()? {None=>{return Ok(None);},Some(caption)=>{match jsonParse(caption){Err(e)=>{return Err(StdError(e.code,e.offset));},Ok(j)=>{return Ok(Some(Event(string(j,"kind"),integer(j,"x"),integer(j,"y"),string(j,"key"),integer(j,"width"),integer(j,"height"))));}}}}
}

// @api graphemeEditing failure Enables cluster editing; existing scalar positions round forward to a boundary. Default is false.
pub fn graphemeEditing(view:&mut View,enabled:Bool)->Result<Unit,GuiError> effects {} {
 if enabled{for i in 0..view.widgets.len(){let w=view.widgets.get(i);if w.kind=="textbox" || w.kind=="textarea"{let normalized=stdGuiEditGrapheme(w.caption,w.cursor,w.anchor,"Normalize","",w.kind=="textarea")?;match jsonParse(normalized){Err(e)=>{return Err(StdError(e.code,e.offset));},Ok(j)=>{view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,w.caption,w.foreground,w.background,w.enabled,w.checked,integer(j,"cursor"),integer(j,"anchor")));}}}}}
 view.grapheme=enabled;return Ok(());
}

// @api focus failure UnknownId/NotInteractive; retains the widget selection and scroll.
pub fn focus(view:&mut View,id:String)->Result<Unit,GuiError> effects {} {
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{
  if !interactive(view.widgets.get(i)){return Err(StdError("GuiNotInteractive",0));}view.focus=i;
 }}return Ok(());
}
// @api setChecked failure UnknownId/NotCheckbox; updates only the logical view.
pub fn setChecked(view:&mut View,id:String,checked:Bool)->Result<Unit,GuiError> effects {} {
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{
  let w=view.widgets.get(i);if w.kind!="checkbox"{return Err(StdError("GuiNotCheckbox",0));}
  view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,w.caption,w.foreground,w.background,w.enabled,checked,w.cursor,w.anchor));
 }}return Ok(());
}
// @api remove cost O(widgets); rebuilds indices and preserves remaining selection, scroll and focus.
// @api remove failure UnknownId; unknown input leaves the view unchanged.
pub fn remove(view:&mut View,id:String)->Result<Unit,GuiError> effects {} {
 var removed=-1;match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{removed=i;}}
 let widgets=List<Widget>();let indices=Map<String,Int>();var focus=-1;
 for i in 0..view.widgets.len(){if i!=removed{let w=view.widgets.get(i);if view.focus==i{focus=widgets.len();}indices.set(w.id,widgets.len());widgets.add(w);}}
 view.widgets=move widgets;view.indices=move indices;view.focus=focus;view.scroll.remove(id);return Ok(());
}

// @api style failure UnknownId/InvalidColor; retains every other widget property.
pub fn style(view:&mut View,id:String,foreground:Int,background:Int)->Result<Unit,GuiError> effects {} {
 if foreground<0 || foreground>0xffffff || background<0 || background>0xffffff{return Err(StdError("GuiInvalidColor",0));}
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);
 view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,w.caption,foreground,background,w.enabled,w.checked,w.cursor,w.anchor));}}
 return Ok(());
}

// @api focused cost O(1); disabled or removed controls have no focus.
pub fn focused(view:&View)->Option<String> effects {} {
 if view.focus<0 || view.focus>=view.widgets.len(){return None;}
 let w=view.widgets.get(view.focus);if !interactive(w){return None;}return Some(w.id);
}

// @api scrollPosition failure UnknownId/NotTextArea; logical first visible line.
pub fn scrollPosition(view:&View,id:String)->Result<Int,GuiError> effects {} {
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{if view.widgets.get(i).kind!="textarea"{return Err(StdError("GuiNotTextArea",0));}}}
 match view.scroll.get(id){Some(n)=>{return Ok(n);},None=>{return Ok(0);}}
}
// @api setScrollPosition failure UnknownId/NotTextArea/InvalidScroll; prevalidates without changing focus or text.
pub fn setScrollPosition(view:&mut View,id:String,line:Int)->Result<Unit,GuiError> effects {} {
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);if w.kind!="textarea"{return Err(StdError("GuiNotTextArea",0));}if line<0 || line>=w.caption.split("\n").len(){return Err(StdError("GuiInvalidScroll",0));}}}
 view.scroll.set(id,line);return Ok(());
}

// @api bounds cost O(1); client area geometry for composing bounded overlays.
pub fn bounds(view:&View)->Rect effects {} {return Rect(0,0,view.width,view.height);}
pub fn graphemeMode(view:&View)->Bool effects {} {return view.grapheme;}
// @api overlay cost O(combined widget count); at most 2048 controls. Copies bounded VM metadata; captions remain shared.
// @api overlay failure GuiInvalidSize/EditingModeMismatch/WidgetLimit/DuplicateId; input views remain unchanged. Layer controls draw above base controls and take focus when the layer has focus.
pub fn overlay(base:&View,layer:&View)->Result<View,GuiError> effects {} {
 if base.width!=layer.width || base.height!=layer.height{return Err(StdError("GuiInvalidSize",0));}
 if base.grapheme!=layer.grapheme{return Err(StdError("GuiEditingModeMismatch",0));}
 if base.widgets.len()+layer.widgets.len()>2048{return Err(StdError("GuiWidgetLimit",0));}
 let ids=Map<String,Bool>();for i in 0..base.widgets.len(){ids.set(base.widgets.get(i).id,true);}
 for i in 0..layer.widgets.len(){let id=layer.widgets.get(i).id;if ids.get(id)!=None{return Err(StdError("GuiDuplicateId",0));}ids.set(id,true);}
 var result=window(base.title,base.width,base.height)?;result.background=base.background;result.grapheme=base.grapheme;
 for i in 0..base.widgets.len(){let widget=base.widgets.get(i);result.indices.set(widget.id,result.widgets.len());result.widgets.add(widget);match base.scroll.get(widget.id){Some(line)=>{result.scroll.set(widget.id,line);},None=>{}}}
 for i in 0..layer.widgets.len(){let widget=layer.widgets.get(i);result.indices.set(widget.id,result.widgets.len());result.widgets.add(widget);match layer.scroll.get(widget.id){Some(line)=>{result.scroll.set(widget.id,line);},None=>{}}}
 if layer.focus>=0{result.focus=base.widgets.len()+layer.focus;}else{result.focus=base.focus;}
 return Ok(move result);
}
