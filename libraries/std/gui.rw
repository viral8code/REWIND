effects {gui};
pub type GuiError = StdError;
pub record Event {kind:String,x:Int,y:Int,key:String,width:Int,height:Int}
pub enum Action {Activate(String),Changed(String,Bool),Key(String,String),Resize(Int,Int),Close}
record Widget {id:String,kind:String,x:Int,y:Int,width:Int,height:Int,caption:String,foreground:Int,background:Int,enabled:Bool,checked:Bool,cursor:Int,anchor:Int}
pub struct View {private title:String,private width:Int,private height:Int,private background:Int,private widgets:List<Widget>,private indices:Map<String,Int>,private focus:Int,private scroll:Map<String,Int>,private grapheme:Bool}
pub struct ComponentScope {private name:String}
// @api componentScope cost O(name bytes); names are case-sensitive UTF-8, 1..24 bytes, and contain no NUL.
pub fn componentScope(name:String)->Result<ComponentScope,GuiError> effects {} {
 if name=="" || name.byteLen()>24 || stdTextFind(name,"\\0")!=None{return Err(StdError("GuiComponentScope",0));}
 return Ok(ComponentScope(name));
}
// @api componentPrefix cost O(name bytes); stable length-prefixed prefix, at most 27 bytes and valid as guiForm render prefix.
pub fn componentPrefix(scope:&ComponentScope)->String effects {} {return scope.name.byteLen().format()+":"+scope.name;}
// @api componentId cost O(scope bytes + local bytes); local id is 1..64 UTF-8 bytes; distinct scope/local pairs encode uniquely.
pub fn componentId(scope:&ComponentScope,local:String)->Result<String,GuiError> effects {} {
 if local=="" || local.byteLen()>64 || stdTextFind(local,"\\0")!=None{return Err(StdError("GuiComponentId",0));}
 return Ok(componentPrefix(scope)+":"+local);
}
// @api componentLocalId cost O(scope bytes + widget ID bytes); returns None for another scope or invalid local IDs.
pub fn componentLocalId(scope:&ComponentScope,widgetId:String)->Option<String> effects {} {
 let marker=componentPrefix(scope)+":";
 if stdTextFind(widgetId,marker)!=Some(0){return None;}
 match stdTextSlice(widgetId,marker.charLen(),widgetId.charLen()){
  Err(_)=>{return None;},
  Ok(local)=>{if local=="" || local.byteLen()>64 || stdTextFind(local,"\\0")!=None{return None;}return Some(local);}
 }
}

// @api window failure InvalidSize/InvalidTitle; 64..4096 client pixels per axis.
pub fn window(title:String,width:Int,height:Int)->Result<View,GuiError> effects {} {
 if width<64 || width>4096 || height<64 || height>4096{return Err(StdError("GuiInvalidSize",0));}
 if title.byteLen()>1024 || stdTextFind(title,"\0")!=None{return Err(StdError("GuiInvalidTitle",0));}
 return Ok(View(title,width,height,0xffffff,List<Widget>(),Map<String,Int>(),-1,Map<String,Int>(),false));
}
fn add(view:&mut View,id:String,kind:String,caption:String,x:Int,y:Int,width:Int,height:Int,color:Int,checked:Bool)->Result<Unit,GuiError> effects {} {
 if view.widgets.len()>=2048{return Err(StdError("GuiWidgetLimit",0));}
 if id=="" || id.byteLen()>128 || stdTextFind(id,"\0")!=None{return Err(StdError("GuiInvalidId",0));}
 if view.indices.get(id)!=None{return Err(StdError("GuiDuplicateId",0));}
 if caption.byteLen()>4096 || stdTextFind(caption,"\0")!=None{return Err(StdError("GuiInvalidText",0));}
 if x<0 || y<0 || width<1 || height<1 || x>4096 || y>4096 || width>4096 || height>4096 || x+width>view.width || y+height>view.height{return Err(StdError("GuiInvalidBounds",0));}
 if color<0 || color>0xffffff{return Err(StdError("GuiInvalidColor",0));}
 view.indices.set(id,view.widgets.len());view.widgets.add(Widget(id,kind,x,y,width,height,caption,0x111827,color,true,checked,0,0));return Ok(());
}
pub fn label(view:&mut View,id:String,caption:String,x:Int,y:Int,width:Int,height:Int)->Result<Unit,GuiError> effects {} {return add(view,id,"label",caption,x,y,width,height,0xffffff,false);}
pub fn button(view:&mut View,id:String,caption:String,x:Int,y:Int,width:Int,height:Int)->Result<Unit,GuiError> effects {} {return add(view,id,"button",caption,x,y,width,height,0xe5e7eb,false);}
pub fn checkbox(view:&mut View,id:String,caption:String,checked:Bool,x:Int,y:Int,width:Int,height:Int)->Result<Unit,GuiError> effects {} {return add(view,id,"checkbox",caption,x,y,width,height,0xf3f4f6,checked);}
pub fn rectangle(view:&mut View,id:String,x:Int,y:Int,width:Int,height:Int,color:Int)->Result<Unit,GuiError> effects {} {return add(view,id,"rect","",x,y,width,height,color,false);}
// @api ellipse cost one widget; a circle when width equals height. fill is the inside, border the 1 pixel outline. Not interactive.
pub fn ellipse(view:&mut View,id:String,x:Int,y:Int,width:Int,height:Int,fill:Int,border:Int)->Result<Unit,GuiError> effects {} {
 if border<0 || border>0xffffff{return Err(StdError("GuiInvalidColor",0));}
 match add(view,id,"ellipse","",x,y,width,height,fill,false) {Err(e)=>{return Err(e);},Ok(_)=>{}}
 let i=view.widgets.len()-1;
 let s=view.widgets.get(i);
 view.widgets.set(i,Widget(s.id,s.kind,s.x,s.y,s.width,s.height,s.caption,border,s.background,s.enabled,s.checked,s.cursor,s.anchor));
 return Ok(());
}
// @api setBounds failure UnknownId/InvalidBounds; moves and resizes one widget without rebuilding the view.
pub fn setBounds(view:&mut View,id:String,x:Int,y:Int,width:Int,height:Int)->Result<Unit,GuiError> effects {} {
 if x<0 || y<0 || width<1 || height<1 || x>4096 || y>4096 || width>4096 || height>4096 || x+width>view.width || y+height>view.height{return Err(StdError("GuiInvalidBounds",0));}
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);view.widgets.set(i,Widget(w.id,w.kind,x,y,width,height,w.caption,w.foreground,w.background,w.enabled,w.checked,w.cursor,w.anchor));}}
 return Ok(());
}
// @api setColor failure UnknownId/InvalidColor; changes the fill of a widget, or the stroke of a line.
pub fn setColor(view:&mut View,id:String,color:Int)->Result<Unit,GuiError> effects {} {
 if color<0 || color>0xffffff{return Err(StdError("GuiInvalidColor",0));}
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);if w.kind=="line"{view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,w.caption,color,w.background,w.enabled,w.checked,w.cursor,w.anchor));}else{view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,w.caption,w.foreground,color,w.enabled,w.checked,w.cursor,w.anchor));}}}
 return Ok(());
}
pub fn line(view:&mut View,id:String,x1:Int,y1:Int,x2:Int,y2:Int,color:Int)->Result<Unit,GuiError> effects {} {
 if x1<0 || y1<0 || x2<0 || y2<0 || x1>4096 || y1>4096 || x2>4096 || y2>4096{return Err(StdError("GuiInvalidBounds",0));}
 if color<0 || color>0xffffff{return Err(StdError("GuiInvalidColor",0));}
 var x=x1;if x2<x{x=x2;}
 var y=y1;if y2<y{y=y2;}
 var w=x2-x1;if w<0{w=-w;}
 var h=y2-y1;if h<0{h=-h;}
 match add(view,id,"line","",x,y,w+1,h+1,0xffffff,(x2-x1)*(y2-y1)<0) {Err(e)=>{return Err(e);},Ok(_)=>{}}
 let i=view.widgets.len()-1;
 let s=view.widgets.get(i);
 view.widgets.set(i,Widget(s.id,s.kind,s.x,s.y,s.width,s.height,s.caption,color,s.background,s.enabled,s.checked,s.cursor,s.anchor));
 return Ok(());
}
pub fn background(view:&mut View,color:Int)->Result<Unit,GuiError> effects {} {if color<0 || color>0xffffff{return Err(StdError("GuiInvalidColor",0));}view.background=color;return Ok(());}
pub fn setText(view:&mut View,id:String,caption:String)->Result<Unit,GuiError> effects {} {
 if caption.byteLen()>4096 || stdTextFind(caption,"\0")!=None{return Err(StdError("GuiInvalidText",0));}
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,caption,w.foreground,w.background,w.enabled,w.checked,caption.charLen(),caption.charLen()));}}
 return Ok(());
}
pub fn text(view:&View,id:String)->Result<String,GuiError> effects {} {match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{return Ok(view.widgets.get(i).caption);}}}
pub fn checked(view:&View,id:String)->Result<Bool,GuiError> effects {} {match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);if w.kind!="checkbox"{return Err(StdError("GuiNotCheckbox",0));}return Ok(w.checked);}}}
pub fn setEnabled(view:&mut View,id:String,enabled:Bool)->Result<Unit,GuiError> effects {} {match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,w.caption,w.foreground,w.background,enabled,w.checked,w.cursor,w.anchor));}}return Ok(());}
fn interactive(w:Widget)->Bool effects {} {return w.enabled && (w.kind=="button" || w.kind=="checkbox" || w.kind=="textbox" || w.kind=="textarea");}
fn activate(view:&mut View,i:Int)->Option<Action> effects {} {
 let w=view.widgets.get(i);if !interactive(w){return None;}view.focus=i;
 if w.kind=="checkbox"{view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,w.caption,w.foreground,w.background,w.enabled,!w.checked,w.cursor,w.anchor));return Some(Action::Changed(w.id,!w.checked));}
 if w.kind=="textbox" || w.kind=="textarea"{return Some(Action::Key(w.id,"Focus"));}return Some(Action::Activate(w.id));
}
// @api dispatch cost Pointer scans in reverse draw order, at most 2048 widgets; Tab traverses controls.
pub fn dispatch(view:&mut View,event:Event)->Option<Action> effects {} {
 if event.kind=="close"{return Some(Action::Close);}
 if event.kind=="resize"{return Some(Action::Resize(event.width,event.height));}
 if event.kind=="pointer"{var i=view.widgets.len();while i>0{i-=1;let w=view.widgets.get(i);if interactive(w) && event.x>=w.x && event.x<w.x+w.width && event.y>=w.y && event.y<w.y+w.height{return activate(view,i);}}return None;}
 if event.kind=="wheel" && view.focus>=0 {let w=view.widgets.get(view.focus);if w.enabled && w.kind=="textarea" {var position=0;match view.scroll.get(w.id){Some(n)=>{position=n;},None=>{}}let last=w.caption.split("\n").len()-1;if position>last{position=last;}if event.y>0{if event.y>last-position{position=last;}else{position+=event.y;}}else{if event.y< -position{position=0;}else{position+=event.y;}}view.scroll.set(w.id,position);return Some(Action::Key(w.id,"Scroll"));}}
 if (event.kind=="key" || event.kind=="text") && view.focus>=0 {let w=view.widgets.get(view.focus);if w.enabled && (w.kind=="textbox" || w.kind=="textarea") && event.key!="Tab" {
 match edit(view,w.id,event){Ok(_)=>{return Some(Action::Key(w.id,"TextChanged"));},Err(e)=>{return Some(Action::Key(w.id,e.code));}}
 }}
 if event.kind=="key" || event.kind=="text"{
  if event.key=="Tab"{let count=view.widgets.len();if count==0{return None;}var n=0;var i=view.focus;while n<count{i=(i+1)%count;if interactive(view.widgets.get(i)){view.focus=i;return None;}n+=1;}return None;}
  if view.focus>=0 && interactive(view.widgets.get(view.focus)){if event.key=="Enter" || event.key=="Space"{return activate(view,view.focus);}return Some(Action::Key(view.widgets.get(view.focus).id,event.key));}
 }
 return None;
}
// @api scene cost O(widget count + caption bytes); serialized scene at most 1 MiB.
pub fn scene(view:&View)->Result<String,GuiError> effects {} {return stdGuiScene(view.title,view.width,view.height,view.background,&view.widgets,view.focus,&view.scroll);}
// @api present failure Queues a scene; publish may fail with GuiUnavailable or PublishPartiallyApplied.
pub fn present(view:&View)->Result<Unit,GuiError> effects {gui} {return stdGuiStage(scene(view)?);}
fn integer(value:Json,key:String)->Int effects {} {match jsonGet(value,key){Some(Json::Int(v))=>{return v;},_=>{return 0;}}}
fn string(value:Json,key:String)->String effects {} {match jsonGet(value,key){Some(Json::Text(v))=>{return v;},_=>{return "";}}}
// @api nextEvent failure GUI must be published first; input is journaled, blocking, and replayable.
pub fn nextEvent()->Result<Event,GuiError> effects {gui} {
 let caption=stdGuiNextEvent()?;
 match jsonParse(caption){Err(e)=>{return Err(StdError(e.code,e.offset));},Ok(j)=>{return Ok(Event(string(j,"kind"),integer(j,"x"),integer(j,"y"),string(j,"key"),integer(j,"width"),integer(j,"height")));}}
}
pub fn close()->Result<Unit,GuiError> effects {gui} {return stdGuiClose();}

// @api continueInput failure After revert, skips only events already delivered in this execution, including during replay.
pub fn continueInput()->Unit effects {gui} {stdGuiContinueInput();}

// @api textBox failure Single-line editing with Unicode-scalar selection; 4096 UTF-8 bytes.
pub fn textBox(view:&mut View,id:String,caption:String,x:Int,y:Int,width:Int,height:Int)->Result<Unit,GuiError> effects {} {if stdTextFind(caption,"\n")!=None || stdTextFind(caption,"\r")!=None{return Err(StdError("GuiSingleLine",0));}return add(view,id,"textbox",caption,x,y,width,height,0xffffff,false);}
pub fn textArea(view:&mut View,id:String,caption:String,x:Int,y:Int,width:Int,height:Int)->Result<Unit,GuiError> effects {} {return add(view,id,"textarea",caption,x,y,width,height,0xffffff,false);}
pub fn selection(view:&View,id:String)->Result<Tuple<Int,Int>,GuiError> effects {} {match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);return Ok((w.cursor,w.anchor));}}}
pub fn setSelection(view:&mut View,id:String,cursor:Int,anchor:Int)->Result<Unit,GuiError> effects {} {match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);if cursor<0 || anchor<0 || cursor>w.caption.charLen() || anchor>w.caption.charLen(){return Err(StdError("GuiInvalidSelection",0));}if view.grapheme && (w.kind=="textbox" || w.kind=="textarea"){stdGuiEditGrapheme(w.caption,cursor,anchor,"Validate","",w.kind=="textarea")?;}view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,w.caption,w.foreground,w.background,w.enabled,w.checked,cursor,anchor));}}return Ok(());}
pub fn edit(view:&mut View,id:String,event:Event)->Result<Unit,GuiError> effects {} {
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);if w.kind!="textbox" && w.kind!="textarea"{return Err(StdError("GuiNotTextInput",0));}var typed="";var key=event.key;if event.kind=="text"{typed=event.key;key="";}
 var result="";if view.grapheme{result=stdGuiEditGrapheme(w.caption,w.cursor,w.anchor,key,typed,w.kind=="textarea")?;}else{result=stdGuiEdit(w.caption,w.cursor,w.anchor,key,typed,w.kind=="textarea")?;}
 match jsonParse(result){Err(e)=>{return Err(StdError(e.code,e.offset));},Ok(j)=>{view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,string(j,"text"),w.foreground,w.background,w.enabled,w.checked,integer(j,"cursor"),integer(j,"anchor")));var scroll=0;match view.scroll.get(w.id){Some(n)=>{scroll=n;},None=>{}}let line=integer(j,"line");var rows=w.height/18;if rows<1{rows=1;}if line<scroll{scroll=line;}if line>=scroll+rows{scroll=line-rows+1;}view.scroll.set(w.id,scroll);}}
 }}return Ok(());
}
pub record Rect {x:Int,y:Int,width:Int,height:Int}
pub fn resize(view:&mut View,width:Int,height:Int)->Result<Unit,GuiError> effects {} {if width<64 || width>4096 || height<64 || height>4096{return Err(StdError("GuiInvalidSize",0));}view.width=width;view.height=height;return Ok(());}
// @api arrange cost O(ids); prevalidates geometry and IDs before mutating the view.
pub fn arrange(view:&mut View,ids:&List<String>,bounds:Rect,columns:Int,gap:Int)->Result<Unit,GuiError> effects {} {
 let n=ids.len();if n==0{return Ok(());}if n>2048 || columns<1 || columns>n || gap<0 || gap>4096 || bounds.x<0 || bounds.y<0 || bounds.width<1 || bounds.height<1 || bounds.width>4096 || bounds.height>4096 || bounds.x>4096 || bounds.y>4096 || bounds.x+bounds.width>view.width || bounds.y+bounds.height>view.height{return Err(StdError("GuiInvalidBounds",0));}
 let rows=(n+columns-1)/columns;let width=(bounds.width-gap*(columns-1))/columns;let height=(bounds.height-gap*(rows-1))/rows;if width<1 || height<1{return Err(StdError("GuiInvalidBounds",0));}
 let seen=Map<String,Bool>();for i in 0..n{let id=ids.get(i);if view.indices.get(id)==None{return Err(StdError("GuiUnknownId",0));}if seen.get(id)!=None{return Err(StdError("GuiDuplicateId",0));}seen.set(id,true);}
 for i in 0..n{match view.indices.get(ids.get(i)){None=>{},Some(index)=>{let w=view.widgets.get(index);view.widgets.set(index,Widget(w.id,w.kind,bounds.x+(i%columns)*(width+gap),bounds.y+(i/columns)*(height+gap),width,height,w.caption,w.foreground,w.background,w.enabled,w.checked,w.cursor,w.anchor));}}}return Ok(());
}
// @api waitEvent failure GuiInvalidWait outside -1 and 0..60000; waits up to that many milliseconds for input and returns None on timeout; -1 waits without limit like nextEvent. The wait is journaled, so replay does not sleep.
pub fn waitEvent(milliseconds:Int)->Result<Option<Event>,GuiError> effects {gui} {
 if milliseconds==-1{let e=nextEvent()?;return Ok(Some(e));}
 if milliseconds<0 || milliseconds>60000{return Err(StdError("GuiInvalidWait",0));}
 match stdGuiWaitEvent(milliseconds)? {None=>{return Ok(None);},Some(caption)=>{match jsonParse(caption){Err(e)=>{return Err(StdError(e.code,e.offset));},Ok(j)=>{return Ok(Some(Event(string(j,"kind"),integer(j,"x"),integer(j,"y"),string(j,"key"),integer(j,"width"),integer(j,"height"))));}}}}
}
pub fn pollEvent()->Result<Option<Event>,GuiError> effects {gui} {
 match stdGuiPollEvent()? {None=>{return Ok(None);},Some(caption)=>{match jsonParse(caption){Err(e)=>{return Err(StdError(e.code,e.offset));},Ok(j)=>{return Ok(Some(Event(string(j,"kind"),integer(j,"x"),integer(j,"y"),string(j,"key"),integer(j,"width"),integer(j,"height"))));}}}}
}

// @api graphemeEditing failure Enables cluster editing; existing scalar positions round forward to a boundary. Default is false.
pub fn graphemeEditing(view:&mut View,enabled:Bool)->Result<Unit,GuiError> effects {} {
 if enabled{for i in 0..view.widgets.len(){let w=view.widgets.get(i);if w.kind=="textbox" || w.kind=="textarea"{let normalized=stdGuiEditGrapheme(w.caption,w.cursor,w.anchor,"Normalize","",w.kind=="textarea")?;match jsonParse(normalized){Err(e)=>{return Err(StdError(e.code,e.offset));},Ok(j)=>{view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,w.caption,w.foreground,w.background,w.enabled,w.checked,integer(j,"cursor"),integer(j,"anchor")));}}}}}
 view.grapheme=enabled;return Ok(());
}

// @api focus failure UnknownId/NotInteractive; retains the widget selection and scroll.
pub fn focus(view:&mut View,id:String)->Result<Unit,GuiError> effects {} {
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{
  if !interactive(view.widgets.get(i)){return Err(StdError("GuiNotInteractive",0));}view.focus=i;
 }}return Ok(());
}
// @api setChecked failure UnknownId/NotCheckbox; updates only the logical view.
pub fn setChecked(view:&mut View,id:String,checked:Bool)->Result<Unit,GuiError> effects {} {
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{
  let w=view.widgets.get(i);if w.kind!="checkbox"{return Err(StdError("GuiNotCheckbox",0));}
  view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,w.caption,w.foreground,w.background,w.enabled,checked,w.cursor,w.anchor));
 }}return Ok(());
}
// @api remove cost O(widgets); rebuilds indices and preserves remaining selection, scroll and focus.
// @api remove failure UnknownId; unknown input leaves the view unchanged.
pub fn remove(view:&mut View,id:String)->Result<Unit,GuiError> effects {} {
 var removed=-1;match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{removed=i;}}
 let widgets=List<Widget>();let indices=Map<String,Int>();var focus=-1;
 for i in 0..view.widgets.len(){if i!=removed{let w=view.widgets.get(i);if view.focus==i{focus=widgets.len();}indices.set(w.id,widgets.len());widgets.add(w);}}
 view.widgets=move widgets;view.indices=move indices;view.focus=focus;view.scroll.remove(id);return Ok(());
}

// @api style failure UnknownId/InvalidColor; retains every other widget property.
pub fn style(view:&mut View,id:String,foreground:Int,background:Int)->Result<Unit,GuiError> effects {} {
 if foreground<0 || foreground>0xffffff || background<0 || background>0xffffff{return Err(StdError("GuiInvalidColor",0));}
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);
 view.widgets.set(i,Widget(w.id,w.kind,w.x,w.y,w.width,w.height,w.caption,foreground,background,w.enabled,w.checked,w.cursor,w.anchor));}}
 return Ok(());
}

// @api focused cost O(1); disabled or removed controls have no focus.
pub fn focused(view:&View)->Option<String> effects {} {
 if view.focus<0 || view.focus>=view.widgets.len(){return None;}
 let w=view.widgets.get(view.focus);if !interactive(w){return None;}return Some(w.id);
}

// @api scrollPosition failure UnknownId/NotTextArea; logical first visible line.
pub fn scrollPosition(view:&View,id:String)->Result<Int,GuiError> effects {} {
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{if view.widgets.get(i).kind!="textarea"{return Err(StdError("GuiNotTextArea",0));}}}
 match view.scroll.get(id){Some(n)=>{return Ok(n);},None=>{return Ok(0);}}
}
// @api setScrollPosition failure UnknownId/NotTextArea/InvalidScroll; prevalidates without changing focus or text.
pub fn setScrollPosition(view:&mut View,id:String,line:Int)->Result<Unit,GuiError> effects {} {
 match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(i)=>{let w=view.widgets.get(i);if w.kind!="textarea"{return Err(StdError("GuiNotTextArea",0));}if line<0 || line>=w.caption.split("\n").len(){return Err(StdError("GuiInvalidScroll",0));}}}
 view.scroll.set(id,line);return Ok(());
}

// @api bounds cost O(1); client area geometry for composing bounded overlays.
// Pure weighted partitioning for one flat row or column; remainder pixels go left-to-right.
enum LayoutNode {
 Widget(String),
 Row(Frozen<List<Int>>,Frozen<List<Int>>,Frozen<List<Int>>,Frozen<List<Int>>,Frozen<List<Int>>,Frozen<List<Int>>,Int),
 Column(Frozen<List<Int>>,Frozen<List<Int>>,Frozen<List<Int>>,Frozen<List<Int>>,Frozen<List<Int>>,Frozen<List<Int>>,Int),
 Overlay(Frozen<List<Int>>),
 Padding(Int,Int,Int,Int,Int)
}
pub record Layout {private nodes:Frozen<List<LayoutNode>>,private root:Int,private depth:Int}
pub struct WeightedLayout {private layout:Layout,private weight:Int,private minimum:Int,private maximum:Int,private crossMinimum:Int,private crossMaximum:Int}
record LayoutWork {node:Int,bounds:Rect}
record LayoutPlacement {id:String,bounds:Rect}

pub fn leaf(id:String)->Result<Layout,GuiError> effects {} {
 if id=="" || id.byteLen()>128 || stdTextFind(id,"\0")!=None{return Err(StdError("GuiInvalidId",0));}
 let nodes=List<LayoutNode>();nodes.add(LayoutNode::Widget(id));
 return Ok(Layout(freeze(nodes),0,1));
}
// @api sized cost constrains the child's main axis; minimum == maximum requests a fixed size.
pub fn sized(layout:Layout,weight:Int,minimum:Int,maximum:Int)->Result<WeightedLayout,GuiError> effects {} {
 if weight<1 || weight>1000000{return Err(StdError("GuiLayoutWeight",0));}
 if minimum<0 || maximum<minimum || maximum>4096{return Err(StdError("GuiLayoutDimension",0));}
 if layout.nodes.len()<1 || layout.nodes.len()>1024 || layout.depth<1 || layout.depth>32{return Err(StdError("GuiLayoutLimit",0));}
 return Ok(WeightedLayout(layout,weight,minimum,maximum,0,4096));
}
// @api weighted cost uses the default main-axis range 0..4096.
pub fn weighted(layout:Layout,weight:Int)->Result<WeightedLayout,GuiError> effects {} {
 return sized(layout,weight,0,4096);
}
// @api crossSized cost bounds the cross axis: height in a row and width in a column; content stays at the leading edge.
pub fn crossSized(child:WeightedLayout,minimum:Int,maximum:Int)->Result<WeightedLayout,GuiError> effects {} {
 if minimum<0 || maximum<minimum || maximum>4096{return Err(StdError("GuiLayoutDimension",0));}
 return Ok(WeightedLayout(child.layout,child.weight,child.minimum,child.maximum,minimum,maximum));
}
fn appendLayout(nodes:&mut List<LayoutNode>,layout:Layout)->Int effects {} {
 let offset=nodes.len();
 for i in 0..layout.nodes.len(){
  match thaw(layout.nodes.get(i)){
   LayoutNode::Widget(id)=>{nodes.add(LayoutNode::Widget(id));},
   LayoutNode::Row(children,weights,minimums,maximums,crossMinimums,crossMaximums,gap)=>{
    let shifted=List<Int>();
    for j in 0..children.len(){shifted.add(children.get(j)+offset);}
    nodes.add(LayoutNode::Row(freeze(shifted),weights,minimums,maximums,crossMinimums,crossMaximums,gap));
   },
   LayoutNode::Column(children,weights,minimums,maximums,crossMinimums,crossMaximums,gap)=>{
    let shifted=List<Int>();
    for j in 0..children.len(){shifted.add(children.get(j)+offset);}
    nodes.add(LayoutNode::Column(freeze(shifted),weights,minimums,maximums,crossMinimums,crossMaximums,gap));
   },
   LayoutNode::Overlay(children)=>{
    let shifted=List<Int>();
    for j in 0..children.len(){shifted.add(children.get(j)+offset);}
    nodes.add(LayoutNode::Overlay(freeze(shifted)));
   },
   LayoutNode::Padding(child,left,top,right,bottom)=>{
    nodes.add(LayoutNode::Padding(child+offset,left,top,right,bottom));
   }
  }
 }
 return layout.root+offset;
}
fn composeLayout(children:&List<WeightedLayout>,gap:Int,horizontal:Bool)->Result<Layout,GuiError> effects {} {
 if children.len()<1 || children.len()>256{return Err(StdError("GuiLayoutChildren",0));}
 if gap<0 || gap>4096{return Err(StdError("GuiLayoutGap",0));}
 var count=1;var deepest=0;
 for i in 0..children.len(){
  let child=children.get(i);
  if child.weight<1 || child.weight>1000000{return Err(StdError("GuiLayoutWeight",0));}
  if child.minimum<0 || child.maximum<child.minimum || child.maximum>4096 || child.crossMinimum<0 || child.crossMaximum<child.crossMinimum || child.crossMaximum>4096{return Err(StdError("GuiLayoutDimension",0));}
  if child.layout.nodes.len()<1 || child.layout.nodes.len()>1024{return Err(StdError("GuiLayoutLimit",0));}
  count+=child.layout.nodes.len();
  if count>1024{return Err(StdError("GuiLayoutLimit",0));}
  if child.layout.depth>deepest{deepest=child.layout.depth;}
 }
 let depth=deepest+1;
 if depth>32{return Err(StdError("GuiLayoutDepthLimit",0));}
 let nodes=List<LayoutNode>();let childNodes=List<Int>();let childWeights=List<Int>();let minimums=List<Int>();let maximums=List<Int>();let crossMinimums=List<Int>();let crossMaximums=List<Int>();
 for i in 0..children.len(){
  let child=children.get(i);
  childNodes.add(appendLayout(&mut nodes,child.layout));
  childWeights.add(child.weight);minimums.add(child.minimum);maximums.add(child.maximum);crossMinimums.add(child.crossMinimum);crossMaximums.add(child.crossMaximum);
 }
 let root=nodes.len();
 if horizontal{nodes.add(LayoutNode::Row(freeze(childNodes),freeze(childWeights),freeze(minimums),freeze(maximums),freeze(crossMinimums),freeze(crossMaximums),gap));}
 else{nodes.add(LayoutNode::Column(freeze(childNodes),freeze(childWeights),freeze(minimums),freeze(maximums),freeze(crossMinimums),freeze(crossMaximums),gap));}
 return Ok(Layout(freeze(nodes),root,depth));
}
pub fn row(children:&List<WeightedLayout>,gap:Int)->Result<Layout,GuiError> effects {} {
 return composeLayout(children,gap,true);
}
pub fn column(children:&List<WeightedLayout>,gap:Int)->Result<Layout,GuiError> effects {} {
 return composeLayout(children,gap,false);
}
// @api overlayLayout cost places every child over the same bounds; View insertion order controls z-order.
pub fn overlayLayout(children:&List<Layout>)->Result<Layout,GuiError> effects {} {
 if children.len()<2 || children.len()>256{return Err(StdError("GuiLayoutChildren",children.len()));}
 var count=1;var deepest=0;
 for i in 0..children.len(){
  let child=children.get(i);
  if child.nodes.len()<1 || child.nodes.len()>1024 || child.depth<1 || child.depth>32{return Err(StdError("GuiLayoutLimit",0));}
  count+=child.nodes.len();if count>1024{return Err(StdError("GuiLayoutLimit",count));}
  if child.depth>deepest{deepest=child.depth;}
 }
 let depth=deepest+1;if depth>32{return Err(StdError("GuiLayoutDepthLimit",depth));}
 let nodes=List<LayoutNode>();let childNodes=List<Int>();
 for i in 0..children.len(){childNodes.add(appendLayout(&mut nodes,children.get(i)));}
 let root=nodes.len();nodes.add(LayoutNode::Overlay(freeze(childNodes)));
 return Ok(Layout(freeze(nodes),root,depth));
}
// @api padded cost wraps one layout in bounded insets; the child receives the remaining inner rectangle.
pub fn padded(layout:Layout,left:Int,top:Int,right:Int,bottom:Int)->Result<Layout,GuiError> effects {} {
 if left<0 || top<0 || right<0 || bottom<0 || left>4096 || top>4096 || right>4096 || bottom>4096{return Err(StdError("GuiLayoutDimension",0));}
 if layout.nodes.len()<1 || layout.nodes.len()>=1024 || layout.depth<1 || layout.depth>32{return Err(StdError("GuiLayoutLimit",0));}
 if layout.depth>=32{return Err(StdError("GuiLayoutDepthLimit",layout.depth+1));}
 let depth=layout.depth+1;let nodes=List<LayoutNode>();let child=appendLayout(&mut nodes,layout);let root=nodes.len();
 nodes.add(LayoutNode::Padding(child,left,top,right,bottom));
 return Ok(Layout(freeze(nodes),root,depth));
}
fn validLayoutBounds(bounds:Rect)->Bool effects {} {
 if bounds.x<0 || bounds.x>4096 || bounds.y<0 || bounds.y>4096{return false;}
 if bounds.width<0 || bounds.width>4096 || bounds.height<0 || bounds.height>4096{return false;}
 if bounds.width>4096-bounds.x || bounds.height>4096-bounds.y{return false;}
 return true;
}
// @api applyLayout cost walks at most 1024 nodes and validates every placement before updating the view.
pub fn applyLayout(view:&mut View,layout:&Layout,bounds:Rect)->Result<Unit,GuiError> effects {} {
 if layout.nodes.len()<1 || layout.nodes.len()>1024 || layout.root<0 || layout.root>=layout.nodes.len() || layout.depth<1 || layout.depth>32{return Err(StdError("GuiLayoutLimit",0));}
 if !validLayoutBounds(bounds){return Err(StdError("GuiLayoutBounds",0));}
 let pending=List<LayoutWork>();pending.add(LayoutWork(layout.root,bounds));
 let placements=List<LayoutPlacement>();var cursor=0;
 while cursor<pending.len(){
  if pending.len()>1024{return Err(StdError("GuiLayoutLimit",0));}
  let work=pending.get(cursor);cursor+=1;
  if work.node<0 || work.node>=layout.nodes.len(){return Err(StdError("GuiLayoutLimit",0));}
  match thaw(layout.nodes.get(work.node)){
   LayoutNode::Widget(id)=>{placements.add(LayoutPlacement(id,work.bounds));},
   LayoutNode::Row(children,weights,minimums,maximums,crossMinimums,crossMaximums,gap)=>{
    if children.len()<1 || children.len()>256 || children.len()!=weights.len() || children.len()!=minimums.len() || children.len()!=maximums.len(){return Err(StdError("GuiLayoutChildren",0));}
    let rowWeights=thaw(weights);let rowMinimums=thaw(minimums);let rowMaximums=thaw(maximums);
    let rowCrossMinimums=thaw(crossMinimums);let rowCrossMaximums=thaw(crossMaximums);
    let rectangles=splitConstrained(work.bounds,&rowWeights,&rowMinimums,&rowMaximums,&rowCrossMinimums,&rowCrossMaximums,gap,true)?;
    for i in 0..children.len(){pending.add(LayoutWork(children.get(i),rectangles.get(i)));}
   },
   LayoutNode::Column(children,weights,minimums,maximums,crossMinimums,crossMaximums,gap)=>{
    if children.len()<1 || children.len()>256 || children.len()!=weights.len() || children.len()!=minimums.len() || children.len()!=maximums.len(){return Err(StdError("GuiLayoutChildren",0));}
    let columnWeights=thaw(weights);let columnMinimums=thaw(minimums);let columnMaximums=thaw(maximums);
    let columnCrossMinimums=thaw(crossMinimums);let columnCrossMaximums=thaw(crossMaximums);
    let rectangles=splitConstrained(work.bounds,&columnWeights,&columnMinimums,&columnMaximums,&columnCrossMinimums,&columnCrossMaximums,gap,false)?;
    for i in 0..children.len(){pending.add(LayoutWork(children.get(i),rectangles.get(i)));}
   },
   LayoutNode::Overlay(children)=>{
    if children.len()<2 || children.len()>256{return Err(StdError("GuiLayoutChildren",children.len()));}
    for i in 0..children.len(){pending.add(LayoutWork(children.get(i),work.bounds));}
   },
   LayoutNode::Padding(child,left,top,right,bottom)=>{
    if child<0 || child>=layout.nodes.len() || left<0 || top<0 || right<0 || bottom<0 || left>4096 || top>4096 || right>4096 || bottom>4096{return Err(StdError("GuiLayoutDimension",0));}
    if left+right>=work.bounds.width || top+bottom>=work.bounds.height{return Err(StdError("GuiLayoutInsufficientSpace",0));}
    let inner=Rect(work.bounds.x+left,work.bounds.y+top,work.bounds.width-left-right,work.bounds.height-top-bottom);
    pending.add(LayoutWork(child,inner));
   }
  }
 }
 let indices=List<Int>();let seen=Map<String,Bool>();
 for i in 0..placements.len(){
  let placement=placements.get(i);let rect=placement.bounds;
  if seen.get(placement.id)!=None{return Err(StdError("GuiDuplicateId",0));}
  seen.set(placement.id,true);
  match view.indices.get(placement.id){
   None=>{return Err(StdError("GuiUnknownId",0));},
   Some(index)=>{indices.add(index);}
  }
  if rect.width<1 || rect.height<1 || rect.width>view.width || rect.height>view.height || rect.x>view.width-rect.width || rect.y>view.height-rect.height{return Err(StdError("GuiInvalidBounds",0));}
 }
 for i in 0..placements.len(){
  let index=indices.get(i);let widget=view.widgets.get(index);let placement=placements.get(i);let rect=placement.bounds;
  view.widgets.set(index,Widget(widget.id,widget.kind,rect.x,rect.y,rect.width,rect.height,widget.caption,widget.foreground,widget.background,widget.enabled,widget.checked,widget.cursor,widget.anchor));
 }
 return Ok(());
}
fn splitConstrained(bounds:Rect,weights:&List<Int>,minimums:&List<Int>,maximums:&List<Int>,crossMinimums:&List<Int>,crossMaximums:&List<Int>,gap:Int,horizontal:Bool)->Result<List<Rect>,GuiError> effects {} {
 let count=weights.len();
 if count<1 || count>256 || minimums.len()!=count || maximums.len()!=count || crossMinimums.len()!=count || crossMaximums.len()!=count{return Err(StdError("GuiLayoutChildren",0));}
 if gap<0 || gap>4096{return Err(StdError("GuiLayoutGap",0));}
 if !validLayoutBounds(bounds){return Err(StdError("GuiLayoutBounds",0));}
 var availableAxis=bounds.width;if !horizontal{availableAxis=bounds.height;}
 let gapTotal=(count-1)*gap;
 if gapTotal>availableAxis{return Err(StdError("GuiLayoutInsufficientSpace",0));}
 let available=availableAxis-gapTotal;
 let sizes=List<Int>();var minimumTotal=0;var maximumTotal=0;
 for i in 0..count {
  let weight=weights.get(i);let minimum=minimums.get(i);let maximum=maximums.get(i);
  if weight<1 || weight>1000000{return Err(StdError("GuiLayoutWeight",0));}
  let crossMinimum=crossMinimums.get(i);let crossMaximum=crossMaximums.get(i);
  if minimum<0 || maximum<minimum || maximum>4096 || crossMinimum<0 || crossMaximum<crossMinimum || crossMaximum>4096{return Err(StdError("GuiLayoutDimension",0));}
  sizes.add(minimum);minimumTotal+=minimum;maximumTotal+=maximum;
 }
 if minimumTotal>available || maximumTotal<available{return Err(StdError("GuiLayoutInsufficientSpace",0));}
 var remaining=available-minimumTotal;
 while remaining>0 {
  let roundStart=remaining;var activeWeight=0;
  for i in 0..count{if sizes.get(i)<maximums.get(i){activeWeight+=weights.get(i);}}
  if activeWeight==0{return Err(StdError("GuiLayoutInsufficientSpace",0));}
  var allocated=0;var saturated=false;
  for i in 0..count {
   let size=sizes.get(i);let maximum=maximums.get(i);
   if size<maximum {
    let share=(roundStart*weights.get(i))/activeWeight;let room=maximum-size;
    if share>=room{sizes.set(i,size+room);allocated+=room;saturated=true;}
    else{sizes.set(i,size+share);allocated+=share;}
   }
  }
  remaining-=allocated;
  if remaining==0{break;}
  if saturated{continue;}
  var remainderAllocated=0;
  for i in 0..count {
   if remaining>0 {
    let size=sizes.get(i);let maximum=maximums.get(i);
    if size<maximum{sizes.set(i,size+1);remaining-=1;remainderAllocated+=1;}
   }
  }
  if remainderAllocated==0{return Err(StdError("GuiLayoutInsufficientSpace",0));}
 }
 let output=List<Rect>();var position=0;
 for i in 0..count {
  let size=sizes.get(i);let minimumCross=crossMinimums.get(i);let maximumCross=crossMaximums.get(i);
  var crossSize=bounds.height;if !horizontal{crossSize=bounds.width;}
  if crossSize<minimumCross{return Err(StdError("GuiLayoutInsufficientSpace",0));}
  if crossSize>maximumCross{crossSize=maximumCross;}
  if horizontal{output.add(Rect(bounds.x+position,bounds.y,size,crossSize));}
  else{output.add(Rect(bounds.x,bounds.y+position,crossSize,size));}
  position+=size;if i+1<count{position+=gap;}
 }
 return Ok(output);
}
fn splitWeighted(bounds:Rect,weights:&List<Int>,gap:Int,horizontal:Bool)->Result<List<Rect>,GuiError> effects {} {
 let minimums=List<Int>();let maximums=List<Int>();let crossMinimums=List<Int>();let crossMaximums=List<Int>();
 for i in 0..weights.len(){minimums.add(0);maximums.add(4096);crossMinimums.add(0);crossMaximums.add(4096);}
 return splitConstrained(bounds,weights,&minimums,&maximums,&crossMinimums,&crossMaximums,gap,horizontal);
}
fn arrangeWeighted(view:&mut View,ids:&List<String>,bounds:Rect,weights:&List<Int>,gap:Int,horizontal:Bool)->Result<Unit,GuiError> effects {} {
 if ids.len()<1 || ids.len()>256 || ids.len()!=weights.len(){return Err(StdError("GuiLayoutChildren",0));}
 let indexes=List<Int>();let seen=Map<String,Bool>();
 for i in 0..ids.len(){
  let id=ids.get(i);
  if seen.get(id)!=None{return Err(StdError("GuiDuplicateId",0));}
  seen.set(id,true);
  match view.indices.get(id){None=>{return Err(StdError("GuiUnknownId",0));},Some(index)=>{indexes.add(index);}}
 }
 let rectangles=splitWeighted(bounds,weights,gap,horizontal)?;
 for i in 0..rectangles.len(){
  let rect=rectangles.get(i);
  if rect.width<1 || rect.height<1 || rect.width>view.width || rect.height>view.height || rect.x>view.width-rect.width || rect.y>view.height-rect.height{return Err(StdError("GuiInvalidBounds",0));}
 }
 for i in 0..ids.len(){
  let index=indexes.get(i);let widget=view.widgets.get(index);let rect=rectangles.get(i);
  view.widgets.set(index,Widget(widget.id,widget.kind,rect.x,rect.y,rect.width,rect.height,widget.caption,widget.foreground,widget.background,widget.enabled,widget.checked,widget.cursor,widget.anchor));
 }
 return Ok(());
}
// @api arrangeRow cost validates all IDs and rectangles before changing any widget; existing focus and edit state remain attached to widget IDs.
pub fn arrangeRow(view:&mut View,ids:&List<String>,bounds:Rect,weights:&List<Int>,gap:Int)->Result<Unit,GuiError> effects {} {return arrangeWeighted(view,ids,bounds,weights,gap,true);}
// @api arrangeColumn cost validates all IDs and rectangles before changing any widget; existing focus and edit state remain attached to widget IDs.
pub fn arrangeColumn(view:&mut View,ids:&List<String>,bounds:Rect,weights:&List<Int>,gap:Int)->Result<Unit,GuiError> effects {} {return arrangeWeighted(view,ids,bounds,weights,gap,false);}
// @api splitRow cost O(children), max 256; distributes integer remainder pixels from left to right.
// @api splitRow failure GuiLayoutChildren/Gap/Bounds/Weight/InsufficientSpace; no input is changed.
pub fn splitRow(bounds:Rect,weights:&List<Int>,gap:Int)->Result<List<Rect>,GuiError> effects {} {return splitWeighted(bounds,weights,gap,true);}
// @api splitColumn cost O(children), max 256; distributes integer remainder pixels from top to bottom.
// @api splitColumn failure GuiLayoutChildren/Gap/Bounds/Weight/InsufficientSpace; no input is changed.
pub fn splitColumn(bounds:Rect,weights:&List<Int>,gap:Int)->Result<List<Rect>,GuiError> effects {} {return splitWeighted(bounds,weights,gap,false);}
pub fn bounds(view:&View)->Rect effects {} {return Rect(0,0,view.width,view.height);}
pub fn graphemeMode(view:&View)->Bool effects {} {return view.grapheme;}
// @api overlay cost O(combined widget count); at most 2048 controls. Copies bounded VM metadata; captions remain shared.
// @api overlay failure GuiInvalidSize/EditingModeMismatch/WidgetLimit/DuplicateId; input views remain unchanged. Layer controls draw above base controls and take focus when the layer has focus.
pub fn overlay(base:&View,layer:&View)->Result<View,GuiError> effects {} {
 if base.width!=layer.width || base.height!=layer.height{return Err(StdError("GuiInvalidSize",0));}
 if base.grapheme!=layer.grapheme{return Err(StdError("GuiEditingModeMismatch",0));}
 if base.widgets.len()+layer.widgets.len()>2048{return Err(StdError("GuiWidgetLimit",0));}
 let ids=Map<String,Bool>();for i in 0..base.widgets.len(){ids.set(base.widgets.get(i).id,true);}
 for i in 0..layer.widgets.len(){let id=layer.widgets.get(i).id;if ids.get(id)!=None{return Err(StdError("GuiDuplicateId",0));}ids.set(id,true);}
 var result=window(base.title,base.width,base.height)?;result.background=base.background;result.grapheme=base.grapheme;
 for i in 0..base.widgets.len(){let widget=base.widgets.get(i);result.indices.set(widget.id,result.widgets.len());result.widgets.add(widget);match base.scroll.get(widget.id){Some(line)=>{result.scroll.set(widget.id,line);},None=>{}}}
 for i in 0..layer.widgets.len(){let widget=layer.widgets.get(i);result.indices.set(widget.id,result.widgets.len());result.widgets.add(widget);match layer.scroll.get(widget.id){Some(line)=>{result.scroll.set(widget.id,line);},None=>{}}}
 if layer.focus>=0{result.focus=base.widgets.len()+layer.focus;}else{result.focus=base.focus;}
 return Ok(move result);
}
