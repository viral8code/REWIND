pub fn add(a:Int,b:Int)->Result<Int,String> effects {} {if b>0 && a>9223372036854775807-b{return Err("Overflow");}if b<0 && a<(-9223372036854775807-1)-b{return Err("Overflow");}return Ok(a+b);}
pub fn multiply(a:Int,b:Int)->Result<Int,String> effects {} {if a==0 || b==0{return Ok(0);}if a>0{if b>0{if a>9223372036854775807/b{return Err("Overflow");}}else if b<(-9223372036854775807-1)/a{return Err("Overflow");}}else{if b>0{if a<(-9223372036854775807-1)/b{return Err("Overflow");}}else if a<9223372036854775807/b{return Err("Overflow");}}return Ok(a*b);}
pub fn gcd(a:Int,b:Int)->Result<Int,String> effects {} {var x=a;var y=b;if x>0{x=-x;}if y>0{y=-y;}while y!=0{if y==-1{return Ok(1);}let r=x%y;x=y;y=r;}if x==(-9223372036854775807-1){return Err("Overflow");}return Ok(-x);}
pub fn lcm(a:Int,b:Int)->Result<Int,String> effects {} {if a==0 || b==0{return Ok(0);}let g=gcd(a,b)?;let v=multiply(a/g,b)?;if v==(-9223372036854775807-1){return Err("Overflow");}if v<0{return Ok(-v);}return Ok(v);}
pub fn extendedGcd(a:Int,b:Int)->Result<Tuple<Int,Int,Int>,String> effects {} {if a<0 || b<0{return Err("Range");}var r=a;var next=b;var x=1;var nx=0;var y=0;var ny=1;while next!=0{let q=r/next;let rr=r%next;let px=multiply(q,nx)?;let py=multiply(q,ny)?;if px==(-9223372036854775807-1) || py==(-9223372036854775807-1){return Err("Overflow");}let xx=add(x,-px)?;let yy=add(y,-py)?;r=next;next=rr;x=nx;nx=xx;y=ny;ny=yy;}return Ok((r,x,y));}
pub fn primes(limit:Int)->Result<List<Int>,String> effects {} {if limit<0 || limit>65535{return Err("Capacity");}let flags=List<Bool>();var i=0;while i<=limit{flags.add(true);i+=1;}var p=2;while p<=limit/p{if flags.get(p){var j=p*p;while j<=limit{flags.set(j,false);j+=p;}}p+=1;}let out=List<Int>();i=2;while i<=limit{if flags.get(i){out.add(i);}i+=1;}return Ok(out);}
pub fn factors(n:Int)->Result<List<Int>,String> effects {} {if n<1 || n>1000000000000{return Err("Range");}let out=List<Int>();var x=n;var p=2;while p<=x/p{while x%p==0{out.add(p);x/=p;}p+=1;}if x>1{out.add(x);}return Ok(out);}
pub fn combination(n:Int,k:Int)->Result<Int,String> effects {} {if n<0 || k<0 || k>n{return Err("Range");}var count=k;if n-k<count{count=n-k;}if count>65536{return Err("Capacity");}var out=1;var i=1;while i<=count{var top=n-count+i;var bottom=i;let g=gcd(top,bottom)?;top/=g;bottom/=g;let h=gcd(out,bottom)?;out/=h;bottom/=h;if bottom!=1{return Err("NonIntegral");}out=multiply(out,top)?;i+=1;}return Ok(out);}
