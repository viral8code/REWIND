// A bounded byte cursor. The caller owns input observation and chunk/line order.
pub struct Scanner{private input:Bytes,private position:Int}
fn space(byte:Int)->Bool effects {} {return byte==32 || (byte>=9 && byte<=13);}
pub fn fromBytes(input:Bytes)->Result<Scanner,String> effects {} {if stdBytesLength(input)>1048576{return Err("Limit");}return Ok(Scanner(input,0));}
pub fn nextInt(scanner:&mut Scanner)->Result<Option<Int>,String> effects {} {let length=stdBytesLength(scanner.input);while scanner.position<length{match stdBytesGet(scanner.input,scanner.position){Ok(v)=>{if !space(v){break;}scanner.position+=1;},Err(_)=>{return Err("Range");}}}if scanner.position==length{return Ok(None);}var negative=false;var first=0;match stdBytesGet(scanner.input,scanner.position){Ok(v)=>{first=v;},Err(_)=>{return Err("Range");}}if first==45 || first==43{negative=first==45;scanner.position+=1;}var limit=-9223372036854775807;if negative{limit-=1;}var value=0;var digits=0;while scanner.position<length{var byte=0;match stdBytesGet(scanner.input,scanner.position){Ok(v)=>{byte=v;},Err(_)=>{return Err("Range");}}if space(byte){break;}if byte<48 || byte>57{return Err("InvalidNumber");}let digit=byte-48;if value<limit/10{return Err("Overflow");}value*=10;if value<limit+digit{return Err("Overflow");}value-=digit;digits+=1;scanner.position+=1;}if digits==0{return Err("InvalidNumber");}if !negative{value=-value;}return Ok(Some(value));}
pub fn nextToken(scanner:&mut Scanner)->Result<Option<Bytes>,String> effects {} {let length=stdBytesLength(scanner.input);while scanner.position<length{match stdBytesGet(scanner.input,scanner.position){Ok(v)=>{if !space(v){break;}scanner.position+=1;},Err(_)=>{return Err("Range");}}}if scanner.position==length{return Ok(None);}let start=scanner.position;while scanner.position<length{match stdBytesGet(scanner.input,scanner.position){Ok(v)=>{if space(v){break;}scanner.position+=1;},Err(_)=>{return Err("Range");}}}match stdBytesSlice(scanner.input,start,scanner.position){Ok(v)=>{return Ok(Some(v));},Err(_)=>{return Err("Limit");}}}

pub fn position(scanner:&Scanner)->Int effects {} {return scanner.position;}
