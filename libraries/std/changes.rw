// String-keyed map changes. Equality is explicit and must be a pure equivalence relation.
pub record Change<T:Share> {key:String,before:Option<T>,after:Option<T>}
pub record ChangeError {code:String,key:String}
pub record ChangeSet<T:Share> {private edits:Frozen<List<Change<T>>>}

fn equal<T:Share>(left:Option<T>,right:Option<T>,same:fn(T,T)->Bool effects {} captures {Send,Share})->Bool effects {} {
    match left {
        Some(a)=>{match right {Some(b)=>{return same(a,b);},None=>{return false;}}},
        None=>{match right {Some(_)=>{return false;},None=>{return true;}}}
    }
}

pub fn length<T:Share>(patch:ChangeSet<T>)->Int effects {} {return patch.edits.len();}
pub fn edits<T:Share>(patch:ChangeSet<T>)->Frozen<List<Change<T>>> effects {} {return patch.edits;}

// @api fromChanges Rejects duplicate keys and more than 65536 entries; drops no-op changes under the supplied equality.
pub fn fromChanges<T:Share>(input:&List<Change<T>>,same:fn(T,T)->Bool effects {} captures {Send,Share})->Result<ChangeSet<T>,ChangeError> effects {} {
    if input.len()>65536 {return Err(ChangeError("Limit",""));}
    let seen=Map<String,Bool>();let output=List<Change<T>>();
    for i in 0..input.len() {
        let change=input.get(i);
        match seen.get(change.key) {Some(_)=>{return Err(ChangeError("DuplicateKey",change.key));},None=>{}}
        seen.set(change.key,true);
        if !equal(change.before,change.after,same) {output.add(change);}
    }
    return Ok(ChangeSet<T>(freeze(output)));
}

// @api diff Scans sorted key lists once, includes additions/removals/updates, and limits the resulting change count to 65536.
pub fn diff<T:Share>(before:&Map<String,T>,after:&Map<String,T>,same:fn(T,T)->Bool effects {} captures {Send,Share})->Result<ChangeSet<T>,ChangeError> effects {} {
    let left=before.keys();let right=after.keys();let output=List<Change<T>>();
    var i=0;var j=0;
    while i<left.len() || j<right.len() {
        var key="";
        if i>=left.len() {key=right.get(j);j+=1;}
        else if j>=right.len() {key=left.get(i);i+=1;}
        else {
            let a=left.get(i);let b=right.get(j);
            if a<b {key=a;i+=1;}
            else if b<a {key=b;j+=1;}
            else {key=a;i+=1;j+=1;}
        }
        let old=before.get(key);let next=after.get(key);
        if !equal(old,next,same) {
            if output.len()==65536 {return Err(ChangeError("Limit",key));}
            output.add(Change<T>(key,old,next));
        }
    }
    return Ok(ChangeSet<T>(freeze(output)));
}

pub fn inverse<T:Share>(patch:ChangeSet<T>)->ChangeSet<T> effects {} {
    let output=List<Change<T>>();
    for i in 0..patch.edits.len() {
        let change=thaw(patch.edits.get(i));
        output.add(Change<T>(change.key,change.after,change.before));
    }
    return ChangeSet<T>(freeze(output));
}

// @api apply Validates every old value first, then returns a new map. The input is never mutated; unrelated keys are preserved.
pub fn apply<T:Share>(values:&Map<String,T>,patch:ChangeSet<T>,same:fn(T,T)->Bool effects {} captures {Send,Share})->Result<Map<String,T>,ChangeError> effects {} {
    for i in 0..patch.edits.len() {
        let change=thaw(patch.edits.get(i));
        if !equal(values.get(change.key),change.before,same) {return Err(ChangeError("Conflict",change.key));}
    }
    let output=Map<String,T>();let keys=values.keys();
    for i in 0..keys.len() {
        let key=keys.get(i);
        match values.get(key) {Some(value)=>{output.set(key,value);},None=>{}}
    }
    for i in 0..patch.edits.len() {
        let change=thaw(patch.edits.get(i));
        match change.after {Some(value)=>{output.set(change.key,value);},None=>{output.remove(change.key);}}
    }
    return Ok(move output);
}

fn indexed<T:Share>(patch:ChangeSet<T>)->Map<String,Change<T>> effects {} {
    let output=Map<String,Change<T>>();
    for i in 0..patch.edits.len() {
        let change=thaw(patch.edits.get(i));output.set(change.key,change);
    }
    return output;
}

fn packed<T:Share>(values:&Map<String,Change<T>>)->ChangeSet<T> effects {} {
    let output=List<Change<T>>();let keys=values.keys();
    for i in 0..keys.len() {
        match values.get(keys.get(i)) {Some(change)=>{output.add(change);},None=>{}}
    }
    return ChangeSet<T>(freeze(output));
}

// @api compose Represents first followed by second. Overlapping keys require first.after == second.before.
pub fn compose<T:Share>(first:ChangeSet<T>,second:ChangeSet<T>,same:fn(T,T)->Bool effects {} captures {Send,Share})->Result<ChangeSet<T>,ChangeError> effects {} {
    let output=indexed(first);
    for i in 0..second.edits.len() {
        let next=thaw(second.edits.get(i));
        match output.get(next.key) {
            Some(previous)=>{
                if !equal(previous.after,next.before,same) {return Err(ChangeError("Conflict",next.key));}
                if equal(previous.before,next.after,same) {output.remove(next.key);}
                else {output.set(next.key,Change<T>(next.key,previous.before,next.after));}
            },
            None=>{
                if output.len()==65536 {return Err(ChangeError("Limit",next.key));}
                output.set(next.key,next);
            }
        }
    }
    return Ok(packed(&output));
}

// @api merge Three-way map merge. Independent edits and equal final values combine; conflicting edits return an error without changing inputs.
pub fn merge<T:Share>(base:&Map<String,T>,left:&Map<String,T>,right:&Map<String,T>,same:fn(T,T)->Bool effects {} captures {Send,Share})->Result<Map<String,T>,ChangeError> effects {} {
    match diff(base,left,same) {
        Err(error)=>{return Err(error);},
        Ok(a)=>{
            match diff(base,right,same) {
                Err(error)=>{return Err(error);},
                Ok(b)=>{
                    let output=indexed(a);
                    for i in 0..b.edits.len() {
                        let next=thaw(b.edits.get(i));
                        match output.get(next.key) {
                            Some(previous)=>{
                                if !equal(previous.after,next.after,same) {return Err(ChangeError("Conflict",next.key));}
                            },
                            None=>{
                                if output.len()==65536 {return Err(ChangeError("Limit",next.key));}
                                output.set(next.key,next);
                            }
                        }
                    }
                    return apply(base,packed(&output),same);
                }
            }
        }
    }
}

pub record RebaseError {code:String,key:String,step:Int}
pub record RebaseConflict {key:String,step:Int}
pub record RebaseStep<T:Share> {index:Int,patch:ChangeSet<T>,value:Frozen<Map<String,T>>}
pub record RebasePreview<T:Share> {
    steps:Frozen<List<RebaseStep<T>>>,
    value:Frozen<Map<String,T>>,
    conflict:Option<RebaseConflict>
}

// @api previewRebase Validates the original chain, then replays at most 1024 patches / 65536 edits onto a new base. Stops before the first conflicting step.
pub fn previewRebase<T:Share>(base:&Map<String,T>,onto:&Map<String,T>,patches:&List<ChangeSet<T>>,same:fn(T,T)->Bool effects {} captures {Send,Share})->Result<RebasePreview<T>,RebaseError> effects {} {
    if patches.len()>1024 {return Err(RebaseError("StepLimit","",-1));}
    var count=0;
    for i in 0..patches.len() {
        count+=length(patches.get(i));
        if count>65536 {return Err(RebaseError("EditLimit","",i));}
    }
    // Track only touched original keys; no full map copy is needed for each validation step.
    let overlay=Map<String,Option<T>>();
    for i in 0..patches.len() {
        let patch=patches.get(i);
        for j in 0..patch.edits.len() {
            let change=thaw(patch.edits.get(j));
            var actual=base.get(change.key);
            match overlay.get(change.key) {Some(value)=>{actual=value;},None=>{}}
            if !equal(actual,change.before,same) {return Err(RebaseError("OriginalConflict",change.key,i));}
            overlay.set(change.key,change.after);
        }
    }
    let working=Map<String,T>();let keys=onto.keys();
    for i in 0..keys.len() {
        let key=keys.get(i);
        match onto.get(key) {Some(value)=>{working.set(key,value);},None=>{}}
    }
    let steps=List<RebaseStep<T>>();var value=freeze(working);
    for i in 0..patches.len() {
        let patch=patches.get(i);let accepted=List<Change<T>>();
        // Preflight the whole step so a conflict cannot expose a partially applied patch.
        for j in 0..patch.edits.len() {
            let change=thaw(patch.edits.get(j));let actual=working.get(change.key);
            if equal(actual,change.before,same) {
                if !equal(actual,change.after,same) {accepted.add(Change<T>(change.key,actual,change.after));}
            }
            else if !equal(actual,change.after,same) {
                return Ok(RebasePreview<T>(freeze(steps),value,Some(RebaseConflict(change.key,i))));
            }
        }
        let rebased=ChangeSet<T>(freeze(accepted));
        for j in 0..accepted.len() {
            let change=accepted.get(j);
            match change.after {Some(next)=>{working.set(change.key,next);},None=>{working.remove(change.key);}}
        }
        value=freeze(working);
        steps.add(RebaseStep<T>(i,rebased,value));
    }
    return Ok(RebasePreview<T>(freeze(steps),value,None));
}
