// Lexical relative paths; Host root containment remains the runtime's responsibility.
pub fn relative(value:String)->Result<String,String> effects {} {if value==""{return Err("EmptyPath");}if stdTextFind(value,"\\")!=None || stdTextFind(value,":")!=None{return Err("InvalidPath");}match stdEncode(value){Ok(bytes)=>{var p=0;while p<stdBytesLength(bytes){match stdBytesGet(bytes,p){Ok(v)=>{if v==0{return Err("InvalidPath");}},Err(_)=>{return Err("InvalidPath");}}p+=1;}},Err(_)=>{return Err("Limit");}}match stdTextSplit(value,"/"){Ok(parts)=>{var i=0;while i<parts.len(){let part=parts.get(i);if part=="" || part=="." || part==".."{return Err("InvalidPath");}i+=1;}return Ok(value);},Err(_)=>{return Err("Limit");}}}
pub fn join(base:String,child:String)->Result<String,String> effects {} {let a=relative(base)?;let b=relative(child)?;return relative(a+"/"+b);}
