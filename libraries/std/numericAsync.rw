effects {tasks};
import task as task;
// Cooperative pure numeric kernels; no host I/O or external observations.
// @api dot cost Native chunks of at most 4096 products, preserving Neumaier ordering; yields between chunks. Inputs share native storage.
// @api dot failure NumericShape/Type/NonFinite/Overflow; task cancellation and fatal budgets apply. No host worker is started.
pub async fn dot(left:FloatArray,right:FloatArray)->Result<Float,StdError> effects {tasks} {
 var cursor=0;var sum=0.0;var correction=0.0;
 while true {
  let step=stdNumericDotStep(&left,&right,cursor,sum,correction)?;
  cursor=step._0;sum=step._1;correction=step._2;
  if step._3 {return Ok(sum+correction);}
  task.yieldNow();
 }
 return Err(StdError("NumericState",0));
}
// @api matmul cost Native chunks of at most 4096 products and page-range COW writes; yields between chunks. Output initialization is synchronous O(m*n).
// @api matmul failure NumericShape/Type/Size/NonFinite/Overflow; task cancellation and fatal budgets apply. No partial output escapes a failed task.
pub async fn matmul(left:FloatArray,right:FloatArray)->Result<FloatArray,StdError> effects {tasks} {
 var output=stdNumericMatmulInit(&left,&right)?;
 var cursor=0;var sum=0.0;var correction=0.0;
 while true {
  let step=stdNumericMatmulStep(&left,&right,&output,cursor,sum,correction)?;
  output=step._0;cursor=step._1;sum=step._2;correction=step._3;
  if step._4 {return Ok(output);}
  task.yieldNow();
 }
 return Err(StdError("NumericState",0));
}
