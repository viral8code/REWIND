effects {tasks};
import task as task;
// Cooperative pure numeric kernels; no host I/O or external observations.
// @api dot cost Native chunks of at most 4096 products, preserving Neumaier ordering; yields between chunks. Inputs share native storage.
// @api dot failure NumericShape/Type/NonFinite/Overflow; task cancellation and fatal budgets apply. No host worker is started.
pub async fn dot(left:FloatArray,right:FloatArray)->Result<Float,StdError> effects {tasks} {
 var cursor=0;var sum=0.0;var correction=0.0;
 while true {
  let step=stdNumericDotStep(&left,&right,cursor,sum,correction)?;
  cursor=step._0;sum=step._1;correction=step._2;
  if step._3 {return Ok(sum+correction);}
  task.yieldNow();
 }
 return Err(StdError("NumericState",0));
}
// @api matmul cost Native chunks of at most 4096 products and page-range COW writes; yields between chunks. Output initialization shares logarithmic zero storage.
// @api matmul failure NumericShape/Type/Size/NonFinite/Overflow; task cancellation and fatal budgets apply. No partial output escapes a failed task.
pub async fn matmul(left:FloatArray,right:FloatArray)->Result<FloatArray,StdError> effects {tasks} {
 var output=stdNumericMatmulInit(&left,&right)?;
 var cursor=0;var sum=0.0;var correction=0.0;
 while true {
  let step=stdNumericMatmulStep(&left,&right,&output,cursor,sum,correction)?;
  output=step._0;cursor=step._1;sum=step._2;correction=step._3;
  if step._4 {return Ok(output);}
  task.yieldNow();
 }
 return Err(StdError("NumericState",0));
}

fn cooperativeVector(operation:String,left:FloatArray,right:FloatArray,factor:Float)->Result<FloatArray,StdError> effects {tasks} {
 var output=stdNumericVectorInit(operation,&left,&right,factor)?;var cursor=0;
 while true {
  let step=stdNumericVectorStep(operation,&left,&right,&output,factor,cursor)?;
  output=step._0;cursor=step._1;if step._2 {return Ok(output);}task.yieldNow();
 }
 return Err(StdError("NumericState",0));
}
fn cooperativeNorm(array:FloatArray)->Result<Float,StdError> effects {tasks} {
 var cursor=0;var scale=0.0;var sum=1.0;
 while true {
  let step=stdNumericNormStep(&array,cursor,scale,sum)?;cursor=step._0;scale=step._1;sum=step._2;
  if step._4 {return Ok(step._3);}task.yieldNow();
 }
 return Err(StdError("NumericState",0));
}
// @api scale cost Shared logarithmic zero initialization; at most 4096 values per native step, bounded scratch and page-range COW writes.
// @api scale failure NumericType/NonFinite/Overflow; arbitrary ranks and strided input; finite factor, no partial result on failure or cancellation.
pub async fn scale(array:FloatArray,factor:Float)->Result<FloatArray,StdError> effects {tasks} {return cooperativeVector("scale",array,array,factor);}
// @api zipFloat cost At most 4096 element pairs per native step; shared inputs and logarithmic zero initialization, bounded scratch and page-range COW output.
// @api zipFloat failure NumericShape/Type/Domain/NonFinite; add/sub/mul/div and matching shapes; division by zero fails. No partial result escapes.
pub async fn zipFloat(operation:String,left:FloatArray,right:FloatArray)->Result<FloatArray,StdError> effects {tasks} {return cooperativeVector(operation,left,right,0.0);}
// @api norm2 cost At most 4096 values per native step; scaled accumulation preserves logical order without materializing input or squaring large magnitudes.
// @api norm2 failure NumericType/NonFinite/Overflow; arbitrary ranks and views; same scaled result as numeric.norm2, task cancellation and fatal budgets apply.
pub async fn norm2(array:FloatArray)->Result<Float,StdError> effects {tasks} {return cooperativeNorm(array);}

// @api solve cost Partial-pivot LU O(n^3) arithmetic with O(n^2) shared-page COW private storage; at most 4096 copies, pivot checks, swap pairs or update products per native step, including input initialization and back substitution.
// @api solve failure NumericShape/Type/NonFinite/Singular/Size; square Float64 matrix, rank-one rhs, finite nonnegative relative pivot tolerance. Same arithmetic order as numeric.solve, no partial output on error/cancel. Fatal work/memory budgets apply; conservative per-step COW admission remains.
pub async fn solve(matrix:FloatArray,right:FloatArray,tolerance:Float)->Result<FloatArray,StdError> effects {tasks} {
 var work=stdNumericSolveInit(&matrix,&right,tolerance)?;
 while !stdNumericSolveDone(&work)? {work=stdNumericSolveStep(&work)?;task.yieldNow();}
 return stdNumericSolveResult(&work);
}

// @api qr cost Column-pivoted Householder O(m*n*min(m,n)); bounded native steps of at most 4096 scalar units, private shared-page COW work and task handoff between steps.
// @api qr failure NumericShape/Type/Domain/NonFinite/Overflow/Size; economy Q and R, permutation as native IntArray; same arithmetic order as numeric.qr. No partial result on failure or cancellation, fatal work/memory budgets apply.
pub async fn qr(matrix:FloatArray,tolerance:Float)->Result<QrArrayResult,StdError> effects {tasks} {
 var work=stdNumericQrInit(&matrix,tolerance)?;
 while !stdNumericQrDone(&work)? {work=stdNumericQrStep(&work)?;task.yieldNow();}
 return stdNumericQrResult(&work);
}
