import integer as integer;
pub struct Matrix{rows:Int,columns:Int,values:List<Int>}
pub fn create(rows:Int,columns:Int,input:&List<Int>)->Result<Matrix,String> effects {} {if rows<0 || columns<0 || rows>128 || columns>128{return Err("Capacity");}if input.len()!=rows*columns{return Err("Dimension");}let values=List<Int>();var i=0;while i<input.len(){values.add(input.get(i));i+=1;}return Ok(Matrix(rows,columns,values));}
pub fn get(matrix:&Matrix,row:Int,column:Int)->Result<Int,String> effects {} {if row<0 || column<0 || row>=matrix.rows || column>=matrix.columns{return Err("Range");}return Ok(matrix.values.get(row*matrix.columns+column));}
pub fn multiply(a:&Matrix,b:&Matrix)->Result<Matrix,String> effects {} {if a.columns!=b.rows{return Err("Dimension");}let values=List<Int>();var i=0;while i<a.rows{var j=0;while j<b.columns{var sum=0;var k=0;while k<a.columns{sum=integer.add(sum,integer.multiply(a.values.get(i*a.columns+k),b.values.get(k*b.columns+j))?)?;k+=1;}values.add(sum);j+=1;}i+=1;}return Ok(Matrix(a.rows,b.columns,values));}
pub fn power(input:&Matrix,exponent:Int)->Result<Matrix,String> effects {} {if input.rows!=input.columns{return Err("Dimension");}if exponent<0{return Err("Exponent");}let identity=List<Int>();var i=0;while i<input.rows{var j=0;while j<input.rows{if i==j{identity.add(1);}else{identity.add(0);}j+=1;}i+=1;}var result=create(input.rows,input.columns,&identity)?;var base=create(input.rows,input.columns,&input.values)?;var e=exponent;while e>0{if e%2==1{result=multiply(&result,&base)?;}e/=2;if e>0{base=multiply(&base,&base)?;}}return Ok(result);}
