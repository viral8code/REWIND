import snapshot as snapshot;

pub record GraphError {code:String,name:String}
pub record Annotation {description:String,author:String}
pub record Version<T:Send> {
    private name:String,
    private parents:Frozen<List<String>>,
    private saved:snapshot.Snapshot<T>
}
pub struct HistoryGraph<T:Send> {
    private versions:Map<String,Version<T>>,
    private heads:Map<String,String>,
    private notes:Map<String,Annotation>,
    private protected:Map<String,Bool>,
    private capacity:Int
}

pub fn create<T:Send>(capacity:Int)->Result<HistoryGraph<T>,GraphError> effects {} {
    if capacity<1 || capacity>65536 {return Err(GraphError("InvalidCapacity",""));}
    return Ok(HistoryGraph<T>(Map<String,Version<T>>(),Map<String,String>(),Map<String,Annotation>(),Map<String,Bool>(),capacity));
}
fn copyNames(keys:List<String>)->List<String> effects {} {
    let output=List<String>();var i=0;
    while i<keys.len(){output.add(keys.get(i));i+=1;}
    return output;
}
pub fn length<T:Send>(graph:&HistoryGraph<T>)->Int effects {} {return graph.versions.len();}
pub fn versions<T:Send>(graph:&HistoryGraph<T>)->List<String> effects {} {return copyNames(graph.versions.keys());}
pub fn branches<T:Send>(graph:&HistoryGraph<T>)->List<String> effects {} {return copyNames(graph.heads.keys());}
pub fn get<T:Send>(graph:&HistoryGraph<T>,name:String)->Option<Version<T>> effects {} {return graph.versions.get(name);}
pub fn name<T:Send>(version:Version<T>)->String effects {} {return version.name;}
pub fn parents<T:Send>(version:Version<T>)->Frozen<List<String>> effects {} {return version.parents;}
pub fn snapshotOf<T:Send>(version:Version<T>)->snapshot.Snapshot<T> effects {} {return version.saved;}
pub fn read<T:Send>(version:Version<T>)->Frozen<T> effects {} {return snapshot.read(version.saved);}
pub fn fork<T:Send>(version:Version<T>)->T effects {} {return snapshot.fork(version.saved);}

fn validName(name:String)->Bool effects {} {let size=stdTextLength(name);return size>0 && size<=128;}
fn validate<T:Send>(graph:&HistoryGraph<T>,name:String,parents:&List<String>)->Result<Unit,GraphError> effects {} {
    if !validName(name) {return Err(GraphError("InvalidName",name));}
    match graph.versions.get(name) {Some(_)=>{return Err(GraphError("DuplicateVersion",name));},None=>{}}
    if graph.versions.len()>=graph.capacity {return Err(GraphError("VersionCapacity",name));}
    if parents.len()>16 {return Err(GraphError("TooManyParents",name));}
    let seen=Map<String,Bool>();
    for i in 0..parents.len() {
        let parent=parents.get(i);
        match seen.get(parent) {Some(_)=>{return Err(GraphError("DuplicateParent",parent));},None=>{}}
        match graph.versions.get(parent) {Some(_)=>{},None=>{return Err(GraphError("UnknownParent",parent));}}
        seen.set(parent,true);
    }
    return Ok(());
}

fn insert<T:Send>(graph:&mut HistoryGraph<T>,name:String,parents:&List<String>,saved:snapshot.Snapshot<T>)->Version<T> effects {} {
    let version=Version<T>(name,freeze(parents),saved);
    graph.versions.set(name,version);
    return version;
}

// @api add Only existing distinct parents are accepted, so insertion cannot introduce cycles. Names are local to this graph.
pub fn add<T:Send>(graph:&mut HistoryGraph<T>,name:String,parents:&List<String>,value:&T)->Result<Version<T>,GraphError> effects {} {
    match validate(graph,name,parents) {
        Err(error)=>{return Err(error);},
        Ok(_)=>{let saved=snapshot.capture(value);return Ok(insert(graph,name,parents,saved));}
    }
}

pub fn addSnapshot<T:Send>(graph:&mut HistoryGraph<T>,name:String,parents:&List<String>,saved:snapshot.Snapshot<T>)->Result<Version<T>,GraphError> effects {} {
    match validate(graph,name,parents) {
        Err(error)=>{return Err(error);},
        Ok(_)=>{return Ok(insert(graph,name,parents,saved));}
    }
}

// @api setHead Creating a version and moving a branch head are independent operations.
pub fn setHead<T:Send>(graph:&mut HistoryGraph<T>,branch:String,version:String)->Result<Unit,GraphError> effects {} {
    if !validName(branch) {return Err(GraphError("InvalidName",branch));}
    match graph.versions.get(version) {Some(_)=>{},None=>{return Err(GraphError("UnknownVersion",version));}}
    match graph.heads.get(branch) {
        Some(_)=>{},
        None=>{if graph.heads.len()>=graph.capacity {return Err(GraphError("BranchCapacity",branch));}}
    }
    graph.heads.set(branch,version);
    return Ok(());
}

pub fn head<T:Send>(graph:&HistoryGraph<T>,branch:String)->Option<Version<T>> effects {} {
    match graph.heads.get(branch) {Some(version)=>{return graph.versions.get(version);},None=>{return None;}}
}

// @api dropHead Removes only the branch name. The graph and detached Version values retain their data roots.
pub fn dropHead<T:Send>(graph:&mut HistoryGraph<T>,branch:String)->Bool effects {} {
    match graph.heads.get(branch) {
        Some(_)=>{graph.heads.remove(branch);return true;},
        None=>{return false;}
    }
}

// @api annotate Replaces metadata without recapturing data; description <=4096 and author <=128 Unicode scalars.
pub fn annotate<T:Send>(graph:&mut HistoryGraph<T>,version:String,note:Annotation)->Result<Unit,GraphError> effects {} {
    match graph.versions.get(version) {Some(_)=>{},None=>{return Err(GraphError("UnknownVersion",version));}}
    if stdTextLength(note.description)>4096 || stdTextLength(note.author)>128 {return Err(GraphError("InvalidAnnotation",version));}
    graph.notes.set(version,note);
    return Ok(());
}
pub fn annotation<T:Send>(graph:&HistoryGraph<T>,version:String)->Option<Annotation> effects {} {return graph.notes.get(version);}

// @api isAncestor Reflexive ancestry; visits each reachable version at most once, without recursive VM calls.
pub fn isAncestor<T:Send>(graph:&HistoryGraph<T>,ancestor:String,descendant:String)->Result<Bool,GraphError> effects {} {
    match graph.versions.get(ancestor) {Some(_)=>{},None=>{return Err(GraphError("UnknownVersion",ancestor));}}
    match graph.versions.get(descendant) {Some(_)=>{},None=>{return Err(GraphError("UnknownVersion",descendant));}}
    let pending=List<String>();let seen=Map<String,Bool>();
    pending.add(descendant);seen.set(descendant,true);var cursor=0;
    while cursor<pending.len() {
        let current=pending.get(cursor);cursor+=1;
        if current==ancestor {return Ok(true);}
        match graph.versions.get(current) {
            Some(version)=>{
                for i in 0..version.parents.len() {
                    let parent=version.parents.get(i);
                    match seen.get(parent) {Some(_)=>{},None=>{seen.set(parent,true);pending.add(parent);}}
                }
            },
            None=>{panic("history graph invariant");}
        }
    }
    return Ok(false);
}

// @api matching Evaluates a pure predicate on each saved root in version-name key order; returned Version values retain their snapshots.
pub fn matching<T:Send>(graph:&HistoryGraph<T>,predicate:fn(Frozen<T>)->Bool effects {} captures {Send,Share})->List<Version<T>> effects {} {
    let output=List<Version<T>>();let keys=copyNames(graph.versions.keys());
    for i in 0..keys.len() {
        match graph.versions.get(keys.get(i)) {
            Some(version)=>{if predicate(snapshot.read(version.saved)) {output.add(version);}},
            None=>{}
        }
    }
    return output;
}

// @api pin Protects a registered version and all its ancestors during explicit pruning. Does not change branch heads.
pub fn pin<T:Send>(graph:&mut HistoryGraph<T>,version:String)->Result<Unit,GraphError> effects {} {
    match graph.versions.get(version) {Some(_)=>{},None=>{return Err(GraphError("UnknownVersion",version));}}
    graph.protected.set(version,true);
    return Ok(());
}
pub fn unpin<T:Send>(graph:&mut HistoryGraph<T>,version:String)->Bool effects {} {
    match graph.protected.get(version) {
        Some(_)=>{graph.protected.remove(version);return true;},
        None=>{return false;}
    }
}
pub fn pins<T:Send>(graph:&HistoryGraph<T>)->List<String> effects {} {return copyNames(graph.protected.keys());}

fn reachable<T:Send>(graph:&HistoryGraph<T>,roots:&List<String>)->Result<Map<String,Bool>,GraphError> effects {} {
    if roots.len()>65536 {return Err(GraphError("RootLimit",""));}
    let pending=List<String>();let seen=Map<String,Bool>();
    for i in 0..roots.len() {
        let root=roots.get(i);
        match graph.versions.get(root) {Some(_)=>{},None=>{return Err(GraphError("UnknownVersion",root));}}
        match seen.get(root) {Some(_)=>{},None=>{seen.set(root,true);pending.add(root);}}
    }
    var cursor=0;
    while cursor<pending.len() {
        let current=pending.get(cursor);cursor+=1;
        match graph.versions.get(current) {
            Some(version)=>{
                for i in 0..version.parents.len() {
                    let parent=version.parents.get(i);
                    match seen.get(parent) {Some(_)=>{},None=>{seen.set(parent,true);pending.add(parent);}}
                }
            },
            None=>{panic("history graph invariant");}
        }
    }
    return Ok(move seen);
}

// @api ancestors Returns the union of inclusive ancestors of explicit roots, in version-name order. Does not retain snapshots.
pub fn ancestors<T:Send>(graph:&HistoryGraph<T>,roots:&List<String>)->Result<List<String>,GraphError> effects {} {
    match reachable(graph,roots) {Ok(found)=>{return Ok(found.keys());},Err(error)=>{return Err(error);}}
}

fn retained<T:Send>(graph:&HistoryGraph<T>,keep:&List<String>)->Result<Map<String,Bool>,GraphError> effects {} {
    if keep.len()>65536 {return Err(GraphError("RootLimit",""));}
    let roots=List<String>();let seen=Map<String,Bool>();
    // Validate explicit roots even if a branch or pin already retains everything.
    for i in 0..keep.len() {
        let root=keep.get(i);
        match graph.versions.get(root) {Some(_)=>{},None=>{return Err(GraphError("UnknownVersion",root));}}
        match seen.get(root) {Some(_)=>{},None=>{seen.set(root,true);roots.add(root);}}
    }
    let protected=graph.protected.keys();
    for i in 0..protected.len() {
        let root=protected.get(i);
        match seen.get(root) {Some(_)=>{},None=>{seen.set(root,true);roots.add(root);}}
    }
    let branches=graph.heads.keys();
    for i in 0..branches.len() {
        match graph.heads.get(branches.get(i)) {
            Some(root)=>{match seen.get(root) {Some(_)=>{},None=>{seen.set(root,true);roots.add(root);}}},
            None=>{panic("history graph invariant");}
        }
    }
    return reachable(graph,&roots);
}

// @api previewPrune Lists versions unreachable from current heads, pins and explicit keep roots; neither metadata nor graph is mutated.
pub fn previewPrune<T:Send>(graph:&HistoryGraph<T>,keep:&List<String>)->Result<List<String>,GraphError> effects {} {
    match retained(graph,keep) {
        Err(error)=>{return Err(error);},
        Ok(found)=>{
            let removed=List<String>();let keys=copyNames(graph.versions.keys());
            for i in 0..keys.len() {
                let key=keys.get(i);
                match found.get(key) {Some(_)=>{},None=>{removed.add(key);}}
            }
            return Ok(move removed);
        }
    }
}

// @api prune Recomputes protected reachability, builds retained registries, then replaces them. Detached Version/Snapshot values keep their data.
pub fn prune<T:Send>(graph:&mut HistoryGraph<T>,keep:&List<String>)->Result<List<String>,GraphError> effects {} {
    match retained(graph,keep) {
        Err(error)=>{return Err(error);},
        Ok(found)=>{
            if found.len()==graph.versions.len() {return Ok(List<String>());}
            let versions=Map<String,Version<T>>();let notes=Map<String,Annotation>();let removed=List<String>();
            let keys=copyNames(graph.versions.keys());
            for i in 0..keys.len() {
                let key=keys.get(i);
                match found.get(key) {
                    Some(_)=>{
                        match graph.versions.get(key) {Some(version)=>{versions.set(key,version);},None=>{panic("history graph invariant");}}
                        match graph.notes.get(key) {Some(note)=>{notes.set(key,note);},None=>{}}
                    },
                    None=>{removed.add(key);}
                }
            }
            graph.versions=move versions;
            graph.notes=move notes;
            return Ok(move removed);
        }
    }
}

// @api mergeBases Returns every nearest common ancestor, in name order. Criss-cross histories may have multiple bases; unrelated histories return an empty list.
pub fn mergeBases<T:Send>(graph:&HistoryGraph<T>,left:String,right:String)->Result<List<String>,GraphError> effects {} {
    let leftRoot=List<String>();leftRoot.add(left);let rightRoot=List<String>();rightRoot.add(right);
    match reachable(graph,&leftRoot) {
        Err(error)=>{return Err(error);},
        Ok(a)=>{
            match reachable(graph,&rightRoot) {
                Err(error)=>{return Err(error);},
                Ok(b)=>{
                    let common=Map<String,Bool>();let keys=a.keys();
                    for i in 0..keys.len() {
                        let key=keys.get(i);
                        match b.get(key) {Some(_)=>{common.set(key,true);},None=>{}}
                    }
                    // Common ancestry is parent-closed. A non-nearest common ancestor is a parent of another common ancestor.
                    let older=Map<String,Bool>();let candidates=common.keys();
                    for i in 0..candidates.len() {
                        match graph.versions.get(candidates.get(i)) {
                            Some(version)=>{
                                for j in 0..version.parents.len() {older.set(version.parents.get(j),true);}
                            },
                            None=>{panic("history graph invariant");}
                        }
                    }
                    let output=List<String>();
                    for i in 0..candidates.len() {
                        let key=candidates.get(i);
                        match older.get(key) {Some(_)=>{},None=>{output.add(key);}}
                    }
                    return Ok(move output);
                }
            }
        }
    }
}

// @api path Returns one shortest ancestry path, inclusive and ordered ancestor to descendant. Equal-length ties follow stored parent order.
pub fn path<T:Send>(graph:&HistoryGraph<T>,ancestor:String,descendant:String)->Result<Option<List<String>>,GraphError> effects {} {
    match graph.versions.get(ancestor) {Some(_)=>{},None=>{return Err(GraphError("UnknownVersion",ancestor));}}
    match graph.versions.get(descendant) {Some(_)=>{},None=>{return Err(GraphError("UnknownVersion",descendant));}}
    let pending=List<String>();let seen=Map<String,Bool>();let next=Map<String,String>();
    pending.add(descendant);seen.set(descendant,true);var cursor=0;
    while cursor<pending.len() {
        let current=pending.get(cursor);cursor+=1;
        if current==ancestor {
            let output=List<String>();var node=current;output.add(node);
            while node!=descendant {
                match next.get(node) {Some(child)=>{node=child;output.add(node);},None=>{panic("history path invariant");}}
            }
            return Ok(Some(move output));
        }
        match graph.versions.get(current) {
            Some(version)=>{
                for i in 0..version.parents.len() {
                    let parent=version.parents.get(i);
                    match seen.get(parent) {
                        Some(_)=>{},
                        None=>{seen.set(parent,true);next.set(parent,current);pending.add(parent);}
                    }
                }
            },
            None=>{panic("history graph invariant");}
        }
    }
    return Ok(None);
}
