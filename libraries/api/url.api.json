    "fn:encodeComponent": {
      "async": false,
      "cost": "O(bytes); every byte except A-Z a-z 0-9 - . _ ~ becomes %XX (UTF-8 bytes of the text). At most 8192 input bytes.",
      "defaults": [],
      "effects": [],
      "failure": "TooLong.",
      "generics": [],
      "names": [
        "text"
      ],
      "parameters": [
        "String"
      ],
      "return": "Result<String,UrlError>"
    },
    "fn:format": {
      "async": false,
