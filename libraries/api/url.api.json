      ],
      "parameters": [
        "&Url"
      ],
      "return": "String"
    },
    "fn:formatQuery": {
      "async": false,
      "cost": "O(bytes); encodes names and values with encodeComponent and joins them with &. At most 128 pairs.",
      "defaults": [],
      "effects": [],
      "failure": "TooManyParams, TooLong.",
      "generics": [],
      "names": [
        "params"
      ],
      "parameters": [
        "&List<Param>"
      ],
      "return": "Result<String,UrlError>"
    },
    "fn:parse": {
      "async": false,
      "cost": "O(bytes); splits scheme://userinfo@host:port/path?query#fragment (every part optional, so relative references parse too). Components stay percent-encoded. Hosts are kept as written, IPv6 literals in brackets; no IDN or normalisation. At most 8192 ASCII bytes, no spaces or controls.",
      "defaults": [],
      "effects": [],
      "failure": "NonAscii, TooLong, BadScheme, BadPort, BadHost.",
      "generics": [],
      "names": [
        "text"
      ],
      "parameters": [
        "String"
      ],
      "return": "Result<Url,UrlError>"
    },
    "fn:parseQuery": {
      "async": false,
      "cost": "O(bytes); splits on &, keeps order and duplicate names, drops empty pairs. A pair without = has value None, \"a=\" has Some(\"\"). Names and values are decoded once, + is a space. At most 128 pairs and 8192 bytes.",
      "defaults": [],
      "effects": [],
      "failure": "BadEscape, BadUtf8, NonAscii, TooLong, TooManyParams.",
      "generics": [],
      "names": [
        "raw"
      ],
      "parameters": [
        "String"
      ],
      "return": "Result<List<Param>,UrlError>"
    },
    "fn:pathSegments": {
      "async": false,
      "cost": "O(bytes); splits an encoded path on / and decodes each segment once, so %2F stays inside one segment. Empty segments are kept except the leading one of an absolute path.",
      "defaults": [],
      "effects": [],
      "failure": "BadEscape, BadUtf8, NonAscii, TooLong.",
      "generics": [],
      "names": [
